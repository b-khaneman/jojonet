# ==========================================
# 3x-ui / X-UI panel (separate from JojoNet tunnels)
# Official: MHSanaei 3x-ui — not a JojoNet tunnel.
# ==========================================
XUI_INSTALL_PATH="/usr/bin/x-ui"
XUI_HOME="/usr/local/x-ui"
XUI_SERVICE="x-ui.service"
XUI_FLAVOR_FILE="/usr/local/x-ui/.jojonet-flavor"
VPN_CREDS_FILE="/etc/jojonet/vpn-panel.creds"
XUI_INSTALL_LOG="/var/log/jojonet-xui-install.log"

xui_present() {
    [[ -x "$XUI_INSTALL_PATH" || -x "$XUI_HOME/x-ui" || -f /etc/systemd/system/x-ui.service ]] \
        || [[ -f /etc/x-ui/x-ui.db || -d /usr/local/x-ui ]]
}

xui_running() {
    systemctl is-active --quiet "$XUI_SERVICE" 2>/dev/null
}

xui_flavor() {
    local got=""
    if [[ -f "$XUI_FLAVOR_FILE" ]]; then
        tr -d '\r\n' < "$XUI_FLAVOR_FILE"
        return 0
    fi
    xui_present || return 1
    if [[ -x "$XUI_HOME/x-ui" ]] && grep -a -m1 -qiE '3x-ui|MHSanaei' "$XUI_HOME/x-ui" 2>/dev/null; then
        got=sanaei
    elif [[ -x "$XUI_HOME/x-ui.sh" ]] && grep -qiE '3x-ui|MHSanaei' "$XUI_HOME/x-ui.sh" 2>/dev/null; then
        got=sanaei
    elif [[ -x "$XUI_INSTALL_PATH" ]] && grep -qiE 'alireza0|/alireza/' "$XUI_INSTALL_PATH" 2>/dev/null; then
        got=classic
    else
        got=unknown
    fi
    if [[ "$got" != "unknown" ]]; then
        xui_set_flavor "$got" 2>/dev/null || true
    fi
    printf '%s' "$got"
}

xui_set_flavor() {
    install -d -m755 "$XUI_HOME" 2>/dev/null || true
    printf '%s\n' "$1" > "$XUI_FLAVOR_FILE"
}

xui_same_or_free() {
    local want="$1" have=""
    xui_present || return 0
    have="$(xui_flavor || true)"
    [[ -z "$have" || "$have" == "$want" || "$have" == "unknown" ]] && return 0
    if [[ "$have" == "classic" ]]; then
        log_error "روی این سرور قبلاً X-UI اصلی نصب شده است. با 3x-ui همزمان نصب نمی‌شود. اول حذف کنید: jojonet --xui-uninstall"
    else
        log_error "روی این سرور قبلاً 3x-ui سنایی نصب شده است. با X-UI اصلی همزمان نصب نمی‌شود. اول حذف کنید: jojonet --xui-uninstall"
    fi
    return 1
}

xui_already_msg() {
    local flavor="${1:-}" run="${2:-0}"
    if [[ "$flavor" == "classic" ]]; then
        echo -e "${YELLOW}[!] همین پنل از قبل روی این سرور نصب است: X-UI اصلی${NC}"
    else
        echo -e "${YELLOW}[!] همین پنل از قبل روی این سرور نصب است: 3x-ui سنایی${NC}"
    fi
    if [[ "$run" == "1" ]]; then
        echo -e "    وضعیت: روشن است. نصب دوباره انجام نشد."
    else
        echo -e "    وضعیت: فایل‌ها هست (سرویس الان خاموش است). نصب دوباره انجام نشد."
    fi
}

confirm_panel_install() {
    local name="$1" a=""
    if [[ ! -t 0 || "${JOJONET_AUTO:-0}" == "1" ]]; then
        return 0
    fi
    echo -e "${YELLOW}Install ${name} now? Official installer, may take several minutes.${NC}"
    read -r -p "Type y to continue / برای ادامه y بزنید: " a || return 1
    [[ "$a" == "y" || "$a" == "Y" || "$a" == "yes" || "$a" == "بله" ]]
}

xui_fetch_installer() {
    local dest="$1" url=""
    for url in \
        "https://raw.githubusercontent.com/MHSanaei/3x-ui/main/install.sh" \
        "https://cdn.jsdelivr.net/gh/MHSanaei/3x-ui@main/install.sh" \
        "https://ghproxy.net/https://raw.githubusercontent.com/MHSanaei/3x-ui/main/install.sh" \
        "https://mirror.ghproxy.com/https://raw.githubusercontent.com/MHSanaei/3x-ui/main/install.sh"
    do
        echo -e "  ${CYAN}try${NC} $url" >&2
        if xray_fetch "$url" "$dest"; then
            [[ -s "$dest" ]] || continue
            head -1 "$dest" | grep -q '^#!/' || continue
            grep -q 'x-ui' "$dest" || continue
            return 0
        fi
    done
    return 1
}

xui_install() {
    local tmp="" have=""
    (( EUID == 0 )) || { log_error "X-UI install needs root"; return 1; }
    command -v systemctl >/dev/null 2>&1 || { log_error "systemd is required for X-UI"; return 1; }
    xui_same_or_free sanaei || return 1
    if xui_present; then
        have="$(xui_flavor || true)"
        if [[ "$have" == "classic" ]]; then
            log_error "روی این سرور قبلاً X-UI اصلی نصب شده است. اول حذف کنید: jojonet --xui-uninstall"
            return 1
        fi
        if xui_running; then
            xui_already_msg sanaei 1
        else
            xui_already_msg sanaei 0
        fi
        [[ "$have" == "unknown" || -z "$have" ]] && xui_set_flavor sanaei
        xui_status
        xui_print_login || true
        return 0
    fi
    confirm_panel_install "3x-ui (Sanaei)" || { echo "Cancelled."; return 1; }
    echo -e "${CYAN}[*] Installing official MHSanaei 3x-ui. This is separate from JojoNet tunnels.${NC}"
    echo -e "    Panel credentials are printed by the upstream installer — save them."
    tmp=$(mktemp /tmp/jojonet-xui-install.XXXXXX) || return 1
    if ! xui_fetch_installer "$tmp"; then
        rm -f "$tmp"
        log_error "Could not download 3x-ui installer (GitHub + mirrors)."
        return 1
    fi
    chmod 700 "$tmp"
    mkdir -p /var/log
    if ! XUI_NONINTERACTIVE=1 bash "$tmp" > >(tee "$XUI_INSTALL_LOG") 2>&1; then
        rm -f "$tmp"
        log_error "3x-ui installer failed."
        return 1
    fi
    chmod 600 "$XUI_INSTALL_LOG" 2>/dev/null || true
    rm -f "$tmp"
    xui_set_flavor sanaei
    echo -e "${GREEN}[+] 3x-ui install finished.${NC}"
    xui_status
    xui_print_login || true
}

