CTRL=${ctrl_port}
exec "\$WSTUNNEL_BIN" server --restrict-http-upgrade-path-prefix "\$TOKEN" "ws://0.0.0.0:\${CTRL}"
EOF
    fi
    chmod 700 "$cmdsh"
    echo "$cmdsh"
