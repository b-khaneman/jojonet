export_all_configs() {
    local out="${1:-/root/jojonet-backup-$(date +%Y%m%d-%H%M).tar.gz}"
    local tmp
    tmp=$(mktemp -d /tmp/jojonet-exp.XXXXXX) || return 1
    install -d -m700 "$tmp/instances" "$tmp/meta"
    shopt -s nullglob
    cp -a "$INSTANCES_DIR"/*.conf "$tmp/instances/" 2>/dev/null || true
    shopt -u nullglob
    echo "version=${JOJONET_VERSION}" > "$tmp/meta/info.txt"
    date >> "$tmp/meta/info.txt"
    tar -czf "$out" -C "$tmp" instances meta 2>/dev/null || { rm -rf "$tmp"; return 1; }
    rm -rf "$tmp"
    chmod 600 "$out"
    log_info "Exported: $out"
    echo "$out"
}

import_all_configs() {
    local arc="$1" n=0
    [[ -f "$arc" ]] || { log_error "Not found: $arc"; return 1; }
    local tmp
    tmp=$(mktemp -d /tmp/jojonet-imp.XXXXXX) || return 1
    tar -xzf "$arc" -C "$tmp" || { rm -rf "$tmp"; return 1; }
    if [[ -d "$tmp/instances" ]]; then
        for f in "$tmp/instances"/*.conf; do
            [[ -f "$f" ]] || continue
            install -m600 "$f" "$INSTANCES_DIR/"
            n=$((n + 1))
        done
    fi
    rm -rf "$tmp"
    refresh_runtime_templates || true
    repair_all_instances
    restart_all_tunnels
    log_info "Imported $n tunnel config(s)."
    return 0
}

tunnel_logs_cli() {
    local name="$1" lines="${2:-50}"
    [[ -n "$name" ]] || { log_error "Usage: jojonet --logs <NAME>"; return 1; }
    valid_tunnel_name "$name" || { log_error "Invalid tunnel name: $name"; return 1; }
    [[ "$lines" =~ ^[0-9]{1,5}$ ]] || { log_error "Line count must be a number"; return 1; }
    journalctl -u "$(tunnel_service_unit "$name")" -b --no-pager -n "$lines" 2>/dev/null || \
        log_error "No logs for $name"
}

parse_gre_remote_local() {
    local ifname="$1"
    ip -d link show "$ifname" 2>/dev/null | sed -n 's/.*remote \([0-9.]*\).*local \([0-9.]*\).*/\1 \2/p' | head -1
}

import_manual_gretun() {
    local ifname="${1:-GRETun}" rl="" rem="" loc="" addr="" role="" subnet_byte=""
    set +e
    if ! ip link show "$ifname" >/dev/null 2>&1; then
        echo -e "${RED}[!] Interface $ifname not found.${NC}"
        ip -o link show type gre 2>/dev/null | awk '{print "  - " $2}' | sed 's/:$//' || true
        sleep 2
        set -e
        return 1
    fi
    rl=$(parse_gre_remote_local "$ifname")
    rem=$(echo "$rl" | awk '{print $1}')
    loc=$(echo "$rl" | awk '{print $2}')
    addr=$(ip -o -4 addr show dev "$ifname" 2>/dev/null | awk '{print $4}' | head -1)
    [[ -n "$rem" && -n "$loc" && -n "$addr" ]] || {
        echo -e "${RED}[!] Cannot parse $ifname (remote/local/IP).${NC}"
        sleep 2
        set -e
        return 1
    }
    if [[ "$addr" == *".1/"* ]]; then role="kharej"
    elif [[ "$addr" == *".2/"* ]]; then role="iran"
    else
        read -r -p "Role [1=Iran 2=Kharej]: " _r
        [[ "$_r" == "2" ]] && role="kharej" || role="iran"
    fi
    subnet_byte=$(echo "$addr" | awk -F'[./]' '{print $3}')
    echo -e "${CYAN}Import plan:${NC}"
    echo -e "  Iface: $ifname  Role: $role  Local: $loc  Remote: $rem"
    echo -e "  Overlay: $addr  Subnet: $subnet_byte"
    read -r -p "Import into JojoNet (stop $ifname, recreate as managed)? [y/N]: " _c
    _c=$(echo "$_c" | tr '[:upper:]' '[:lower:]')
    [[ "$_c" == "y" ]] || { set -e; return 0; }

    ip link delete "$ifname" 2>/dev/null || true
    resolve_tunnel_ips "$role" "$subnet_byte" "gre"
    local fwd="" ins_name="$ifname"
    validate_interface_name "$ins_name" || ins_name=$(allocate_tunnel_name "$rem" "$role" "gre" "$subnet_byte")
    [[ "$role" == "iran" ]] && fwd=$(allocate_iran_forward_port "443")

    if deploy_tunnel "$ins_name" "$role" "$loc" "$rem" "$subnet_byte" \
        "$Tun_IP" "$Tun_Remote_IP_Raw" "$DEFAULT_GRE_MTU" "$fwd" "gre" \
        "$DEFAULT_TCP_PORT" "" "$Tun_Server_IP" "$Tun_Client_IP"; then
        echo -e "${GREEN}[+] Imported $ifname → JojoNet [$ins_name]${NC}"
        show_pairing_card "$role" "$loc" "$rem" "$subnet_byte" "$ins_name" "gre" "$fwd"
    fi
    sleep 2
    set -e
}

notify_webhook() {
    local msg="$1"
    [[ -n "${JOJONET_WEBHOOK_URL:-}" ]] || return 0
    command -v curl >/dev/null 2>&1 || return 0
    curl -fsS -m 8 -X POST -H 'Content-Type: application/json' \
        -d "$(printf '{"text":"%s"}' "${msg//\"/\\\"}")" \
        "$JOJONET_WEBHOOK_URL" >/dev/null 2>&1 || true
}

