    echo "Invalid or unsafe config: $CONFIG_FILE" >&2
    exit 1
fi

table_name="jojonet_$Name"
IPT_MARK="jojonet_${Name}"

cleanup() {
    trap - ERR
    if [[ "${Role:-}" == "iran" && -n "${Tun_Remote_IP_Raw:-}" ]]; then
        local p _ports="${Ports:-443}"
        IFS=',' read -ra _PL <<< "$_ports"
        for p in "${_PL[@]}"; do
            p="${p// /}"
            [[ -n "$p" && "$p" =~ ^[0-9]+$ ]] || continue
            iptables -t nat -D PREROUTING -p tcp --dport "$p" \
                -j DNAT --to-destination "${Tun_Remote_IP_Raw}:$p" 2>/dev/null || true
        done
    fi
    ip link delete "$Name" >/dev/null 2>&1 || true
    nft delete table ip "$table_name" >/dev/null 2>&1 || true
}

case "$ACTION" in
    start)
        trap cleanup ERR

        log() { echo "[jojonet:${Name}] $*"; }

        log "Starting plain GRE tunnel (manual-compatible)..."
        modprobe ip_gre 2>/dev/null || true

        if ip link show "$Name" >/dev/null 2>&1; then
            log "Removing stale interface $Name"
            ip link delete "$Name" || { log "ERROR: failed to delete old interface"; exit 1; }
        fi

        log "ip tunnel add $Name mode gre remote $Remote_IP local $Local_IP"
        ip tunnel add "$Name" mode gre remote "$Remote_IP" local "$Local_IP" \
            || { log "ERROR: GRE creation failed"; exit 1; }

        _want_ip="${Tun_IP%%/*}"
        _busy=$(ip -o -4 addr show 2>/dev/null | awk -v ip="$_want_ip" '$4 ~ "^" ip "(/|$)" { print $2; exit }')
        if [[ -n "$_busy" && "$_busy" != "$Name" ]]; then
            log "ERROR: overlay IP $_want_ip already on interface $_busy"
            exit 1
        fi

        log "ip addr add $Tun_IP dev $Name"
        ip addr add "$Tun_IP" dev "$Name" || { log "ERROR: IP assignment failed"; exit 1; }

        DEFAULT_GRE_MTU=1436
        if ! [[ "$Suggested_MTU" =~ ^[0-9]+$ ]]; then Suggested_MTU=$DEFAULT_GRE_MTU; fi
        (( Suggested_MTU < 576 )) && Suggested_MTU=$DEFAULT_GRE_MTU
        (( Suggested_MTU > 9000 )) && Suggested_MTU=$DEFAULT_GRE_MTU

        log "ip link set $Name mtu $Suggested_MTU && up"
        ip link set "$Name" mtu "$Suggested_MTU"
        ip link set "$Name" up || { log "ERROR: interface up failed"; exit 1; }

        log "sysctl net.ipv4.ip_forward=1"
        sysctl -w net.ipv4.ip_forward=1 >/dev/null 2>&1 || true
        sysctl -w "net.ipv4.conf.${Name}.rp_filter=0" >/dev/null 2>&1 || true
        DEFAULT_IFACE=$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{for (i = 1; i < NF; i++) if ($i == "dev") { print $(i + 1); exit }}')
        [[ -n "$DEFAULT_IFACE" ]] && sysctl -w "net.ipv4.conf.${DEFAULT_IFACE}.rp_filter=0" >/dev/null 2>&1 || true
        sysctl -w net.ipv4.conf.all.rp_filter=0 >/dev/null 2>&1 || true
        sysctl -w net.ipv4.conf.default.rp_filter=0 >/dev/null 2>&1 || true

        if ! ip link show "$Name" 2>/dev/null | grep -qE '<.*UP.*>|state UP'; then
            log "ERROR: interface not in UP state after start"
            exit 1
        fi

        if [[ "$Role" == "iran" ]]; then
            log "Iran: iptables DNAT + MASQUERADE (panel forward)"
            [[ -n "$Tun_Remote_IP_Raw" ]] || { log "ERROR: remote tunnel IP missing"; exit 1; }
            command -v iptables >/dev/null 2>&1 || { log "ERROR: iptables required on Iran"; exit 1; }

            _ports="${Ports:-443}"
            IFS=',' read -ra PORT_LIST <<< "$_ports"
            for p in "${PORT_LIST[@]}"; do
                p="${p// /}"
                [[ -n "$p" && "$p" =~ ^[0-9]+$ ]] || continue
                log "iptables DNAT tcp/$p -> ${Tun_Remote_IP_Raw}:$p"
                iptables -t nat -C PREROUTING -p tcp --dport "$p" \
                    -j DNAT --to-destination "${Tun_Remote_IP_Raw}:$p" 2>/dev/null || \
                    iptables -t nat -A PREROUTING -p tcp --dport "$p" \
                    -j DNAT --to-destination "${Tun_Remote_IP_Raw}:$p" \
                    || { log "ERROR: iptables DNAT failed for port $p"; exit 1; }
            done

            log "iptables -t nat -A POSTROUTING -j MASQUERADE"
            iptables -t nat -C POSTROUTING -j MASQUERADE 2>/dev/null || \
                iptables -t nat -A POSTROUTING -j MASQUERADE \
                || { log "ERROR: iptables MASQUERADE failed"; exit 1; }
        else
            log "Kharej: GRE only (no NAT)"
        fi

        log "SUCCESS: tunnel $Name is UP with $Tun_IP"
        ;;
    stop)
        echo "[jojonet:${Name:-?}] Stopping tunnel..."
        cleanup
        echo "[jojonet:${Name:-?}] Stopped."
        exit 0
        ;;
    *)
        echo "Invalid action: $ACTION" >&2
        exit 1
        ;;
esac
EOF
    then
        echo -e "${RED}[!] Failed to write template script.${NC}" >&2
        return 1
    fi

    chmod +x "$TEMPLATE_SCRIPT" || {
        echo -e "${RED}[!] Failed to chmod template script.${NC}" >&2
        return 1
    }
}

