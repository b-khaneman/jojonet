quick_add_tunnel_wstunnel() {
    local peer_ip="${1:-}"
    local peer_from_cli=0 use_auto=0
    [[ -n "$peer_ip" ]] && peer_from_cli=1
    local ins_name="" role_conf="" loc_ip="" rem_ip=""
    local fwd_port="$DEFAULT_WSTUNNEL_FWD" key_dir="" ctrl_port="$DEFAULT_WSTUNNEL_CTRL_PORT"
    local existing="" ws_cmd=""

    set +e
    clear_screen
    logo
    print_banner "Wstunnel Reverse Tunnel (WebSocket)"

    echo -e "${CYAN}How it works:${NC}"
    echo -e "  Iran   = wstunnel ${GREEN}SERVER${NC} (users hit Iran ports via WS reverse)"
    echo -e "  Kharej = wstunnel ${GREEN}CLIENT${NC} (dials Iran WS, exposes local panel)"
    echo -e "  Good when TCP reverse over WebSocket works better than raw Wstunnel."
    echo ""

    install_wstunnel_binary || { sleep 2; set -e; return 1; }
    install -d -m700 "$WSTUNNEL_CONFIG_DIR"

    if ! auto_detect_network; then
        echo -e "${RED}[!] Cannot detect network.${NC}"
        sleep 2; set -e; return 1
    fi
    loc_ip="$DETECTED_IP"
    show_existing_tunnels_summary

    if [[ -z "$peer_ip" ]]; then
        read -r -p "Peer server IP: " peer_ip
    fi
    peer_ip="${peer_ip// /}"
    if ! validate_ipv4 "$peer_ip"; then
        echo -e "${RED}[!] Invalid peer IP.${NC}"
        sleep 2; set -e; return 1
    fi
    rem_ip="$peer_ip"

    if existing=$(find_tunnel_for_peer "$rem_ip" "wstunnel"); then
        echo -e "${YELLOW}[!] Wstunnel to $rem_ip exists [$existing]. Restarting...${NC}"
        local _rrc=0
        restart_tunnel "$existing" || _rrc=$?
        sleep 2; set -e; return "$_rrc"
    fi

    if ! role_conf=$(resolve_server_role "$loc_ip"); then
        echo -e "${RED}[!] Role required. Set JOJONET_ROLE=iran|kharej${NC}"
        sleep 2; set -e; return 1
    fi
    echo -e "${GREEN}[*] Role:${NC} $role_conf ($([[ "$role_conf" == "iran" ]] && echo SERVER || echo CLIENT))"


    if jojonet_use_auto_defaults "$peer_from_cli"; then
        use_auto=1
    fi

    ins_name=$(allocate_tunnel_name "$rem_ip" "$role_conf" "wstunnel") || { set -e; return 1; }

    if (( use_auto )); then
        ctrl_port="${JOJONET_WSTUNNEL_CTRL_PORT:-$ctrl_port}"
        if [[ "$role_conf" == "iran" ]]; then
            fwd_port=$(allocate_iran_forward_port "443")
        else
            fwd_port="${JOJONET_FWD_PORTS:-$fwd_port}"
        fi
        fwd_port=$(normalize_port_list "$fwd_port")
        echo -e "  ${CYAN}Control:${NC} WS TCP $ctrl_port  ${CYAN}Fwd:${NC} $fwd_port (auto)"
    else
        read -r -p "Control port (Kharej→Iran WS dial) [$ctrl_port]: " _cp
        ctrl_port=${_cp:-$ctrl_port}
        if [[ "$role_conf" == "iran" ]]; then
            fwd_port=$(allocate_iran_forward_port "443")
            read -r -p "Public forward ports on Iran [$fwd_port]: " _fp
            fwd_port=${_fp:-$fwd_port}
            fwd_port=$(normalize_port_list "$fwd_port")
        else
            read -r -p "Local panel ports on Kharej (must match Iran) [$fwd_port]: " _fp
            fwd_port=${_fp:-$fwd_port}
            fwd_port=$(normalize_port_list "$fwd_port")
        fi
    fi
    if ! [[ "$ctrl_port" =~ ^[0-9]+$ ]] || (( ctrl_port < 1 || ctrl_port > 65535 )); then
        echo -e "${RED}[!] Invalid control port.${NC}"
        sleep 2; set -e; return 1
    fi

    local pair_id
    pair_id=$(printf '%s' "$rem_ip" | tr '.' '_')
    key_dir=$(ensure_wstunnel_token "$pair_id" "$rem_ip") || { set -e; return 1; }

    echo -e "\n${CYAN}--- Wstunnel plan ---${NC}"
    echo -e "  Name:     $ins_name"
    echo -e "  Role:     $role_conf ($([[ "$role_conf" == "iran" ]] && echo server || echo client))"
    echo -e "  Peer:     $rem_ip"
    echo -e "  Control:  WS TCP $ctrl_port"
    echo -e "  Forward:  $fwd_port"
    echo -e "  Token:    $key_dir/wstunnel.token"
    if [[ "$role_conf" == "iran" ]]; then
        hint "Kharej must dial this Iran IP on TCP $ctrl_port — open firewall if needed"
        hint "Now run on Kharej: sudo jojonet --wstunnel $loc_ip"
    else
        hint "Panel must listen on 127.0.0.1 (or all) for ports: $fwd_port"
        hint "Iran must already be running wstunnel server"
    fi
    echo ""

    if deploy_tunnel "$ins_name" "$role_conf" "$loc_ip" "$rem_ip" "0" \
        "" "" "0" "$fwd_port" "wstunnel" "$ctrl_port" "$key_dir" \
        "" "" "tcp"; then
        echo -e "${GREEN}[+] Wstunnel [$ins_name] is up.${NC}"
        [[ "$role_conf" == "iran" ]] && hint "Run on Kharej: sudo jojonet --wstunnel $loc_ip"
        sleep 2
        set -e
        return 0
    fi
    sleep 3
    set -e
    return 1
}


