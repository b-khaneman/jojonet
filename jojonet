install_wstunnel_binary() {
    if [[ -x "$WSTUNNEL_BIN" ]]; then
        return 0
    fi
    local arch ver fname tmpdir url ok=0 found=""
    ver="${WSTUNNEL_VERSION#v}"
    arch=$(detect_cpu_arch_wstunnel) || { log_error "Unsupported CPU for Wstunnel"; return 1; }
    command -v tar >/dev/null 2>&1 || { log_error "tar required for Wstunnel"; return 1; }
    fname="wstunnel_${ver}_linux_${arch}.tar.gz"
    tmpdir=$(mktemp -d /tmp/jojonet-wstunnel.XXXXXX) || return 1
    log_note "Downloading Wstunnel ${WSTUNNEL_VERSION} ($fname)..."
    for url in \
        "https://github.com/erebe/wstunnel/releases/download/${WSTUNNEL_VERSION}/${fname}" \
        "https://ghproxy.net/https://github.com/erebe/wstunnel/releases/download/${WSTUNNEL_VERSION}/${fname}" \
        "https://mirror.ghproxy.com/https://github.com/erebe/wstunnel/releases/download/${WSTUNNEL_VERSION}/${fname}"
    do
        echo -e "  ${CYAN}try${NC} $url" >&2
        if JOJONET_ALLOW_UNSIGNED=1 download_verified "$url" "$tmpdir/$fname" "$fname"; then
            ok=1
            break
        fi
        rm -f "$tmpdir/$fname"
    done
    if (( ok != 1 )); then
        rm -rf "$tmpdir"
        log_error "Failed to download Wstunnel"
        return 1
    fi
    tar -xzf "$tmpdir/$fname" -C "$tmpdir" wstunnel 2>/dev/null || \
        tar -xzf "$tmpdir/$fname" -C "$tmpdir" || { rm -rf "$tmpdir"; return 1; }
    if [[ -f "$tmpdir/wstunnel" ]]; then
        install -m755 "$tmpdir/wstunnel" "$WSTUNNEL_BIN"
    else
        found=$(find "$tmpdir" -type f -name wstunnel 2>/dev/null | head -1)
        [[ -n "$found" ]] || { rm -rf "$tmpdir"; log_error "wstunnel binary missing in archive"; return 1; }
