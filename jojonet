setup_qs_tunnel() {
    local role dns_ips send_domains fake_ip fake_port h_addr max_domain max_sub retries sockets
    local public_ip query_type interval wait_limit password receive_port recv_domains
    print_banner "QS-Tunnel (standalone DNS/IP-spoof UDP forwarder)"
    echo -e "${YELLOW}[!] QS-Tunnel is only a UDP forwarder.${NC}"
    echo "    Put Hysteria2, WireGuard, or xhttp-h3 on its local UDP endpoint."
    echo "    DNS label/query limits apply; upload is typically low (about 1 Mbit per client)."
    local use_auto=0
    role=$(external_role) || { log_error "Invalid role"; return 1; }
    install_qs_tunnel || return 1
    if jojonet_use_auto_defaults 0; then use_auto=1; fi
    dns_ips="" send_domains="" fake_ip="" fake_port=443 h_addr="" max_domain=253 max_sub=63
    retries=1 sockets=512 public_ip=ezping query_type=1 interval=0.001 wait_limit=1.0
    receive_port=53 recv_domains=""
    if [[ "$role" == "iran" ]]; then
        read -r -p "DNS resolver IPs (comma-separated): " dns_ips
        read -r -p "Send domains (comma-separated): " send_domains
        csv_has_value "$dns_ips" && csv_has_value "$send_domains" || {
            log_error "At least one DNS IP and send domain are required"; return 1;
        }
        read -r -p "Fake/spoofed return IP: " fake_ip
        [[ -n "$fake_ip" && "$fake_ip" != *[[:space:]/]* ]] || { log_error "Fake send IP is required"; return 1; }
        if (( use_auto )); then
            fake_port=443
            h_addr="127.0.0.1:10443"
            echo -e "  ${CYAN}QS defaults:${NC} fake_port=443 h_addr=$h_addr (auto)"
        else
            read -r -p "Fake/spoofed return port [443]: " fake_port; fake_port="${fake_port:-443}"
            read -r -p "Local HY2/WG/xhttp UDP endpoint [127.0.0.1:10443]: " h_addr; h_addr="${h_addr:-127.0.0.1:10443}"
            read -r -p "Maximum domain length [253]: " max_domain; max_domain="${max_domain:-253}"
            read -r -p "Maximum DNS label length [63]: " max_sub; max_sub="${max_sub:-63}"
            read -r -p "Retries [1]: " retries; retries="${retries:-1}"
            read -r -p "Send socket count [512]: " sockets; sockets="${sockets:-512}"
            read -r -p "Public IP or detector [ezping]: " public_ip; public_ip="${public_ip:-ezping}"
            read -r -p "DNS query type integer [1=A]: " query_type; query_type="${query_type:-1}"
            read -r -p "Packet send interval [0.001]: " interval; interval="${interval:-0.001}"
            read -r -p "Packet wait limit [1.0]: " wait_limit; wait_limit="${wait_limit:-1.0}"
        fi
    else
        if (( use_auto )); then
            receive_port=53
            h_addr="127.0.0.1:443"
            echo -e "  ${CYAN}QS defaults:${NC} receive_port=53 h_addr=$h_addr (auto)"
        else
            read -r -p "DNS receive port [53]: " receive_port; receive_port="${receive_port:-53}"
            read -r -p "Local HY2/WG/xhttp UDP endpoint [127.0.0.1:443]: " h_addr; h_addr="${h_addr:-127.0.0.1:443}"
        fi
        read -r -p "Receive domains (comma-separated): " recv_domains
        csv_has_value "$recv_domains" || { log_error "At least one receive domain is required"; return 1; }
    fi
    read -r -s -p "Shared information password: " password; echo
    [[ -n "$password" ]] || { log_error "Shared password is required"; return 1; }
    validate_host_port "$h_addr" || { log_error "Local endpoint must be HOST:PORT"; return 1; }
    validate_single_port "$fake_port" || { log_error "Invalid fake port"; return 1; }
    validate_single_port "$receive_port" || { log_error "Invalid receive port"; return 1; }
    [[ "$max_domain" =~ ^[0-9]+$ && "$max_sub" =~ ^[0-9]+$ && "$retries" =~ ^[0-9]+$ && "$sockets" =~ ^[0-9]+$ && "$query_type" =~ ^[0-9]+$ ]] || {
        log_error "Length/count/query values must be integers"; return 1;
    }
    (( max_domain >= 1 && max_domain <= 253 && max_sub >= 1 && max_sub <= 63 &&
       sockets >= 1 && query_type >= 1 && query_type <= 65535 )) || {
        log_error "Domain/label/socket/query values are outside valid ranges"; return 1;
    }
    [[ "$interval" =~ ^[0-9]+([.][0-9]+)?$ && "$wait_limit" =~ ^[0-9]+([.][0-9]+)?$ ]] || {
        log_error "Packet timing values must be non-negative numbers"; return 1;
    }
    write_qs_config "$role" "$dns_ips" "$send_domains" "$fake_ip" "$fake_port" "$h_addr" \
        "$max_domain" "$max_sub" "$retries" "$sockets" "$public_ip" "$query_type" \
        "$interval" "$wait_limit" "$password" "$receive_port" "$recv_domains" || return 1
    create_qs_service "$role" || return 1
    systemctl enable --now jojonet-qs.service
    sleep 1
    systemctl --no-pager --full status jojonet-qs.service 2>/dev/null || true
}

show_external_tunnel_status() {
    local unit label state
    echo -e "${CYAN}=== External standalone transports ===${NC}"
    for unit in jojonet-spoof.service jojonet-qs.service; do
        [[ "$unit" == *spoof* ]] && label="Spoof Tunnel" || label="QS-Tunnel"
        if systemctl is-active --quiet "$unit" 2>/dev/null; then
            state="${GREEN}active${NC}"
        elif systemctl list-unit-files "$unit" --no-legend 2>/dev/null | grep -q "$unit"; then
            state="${RED}inactive${NC}"
        else
            state="not installed"
        fi
        echo -e "  ${label}: ${state}"
    done
    echo ""
}

_logo_art_row() {
    local row="$1"
    _logo_glyph J "$row"
    printf '     '   # gap between J O J O
    _logo_glyph O "$row"
    printf '     '
    _logo_glyph J "$row"
    printf '     '
    _logo_glyph O "$row"
    printf '    '    # gap before NET
    _logo_glyph N "$row"
    printf ' '
    _logo_glyph E "$row"
    printf ' '
    _logo_glyph T "$row"
    echo
}

_logo_box_edge() {
    local kind="$1" inner_w="$2"
    local bar="" end i
    for (( i=0; i<inner_w + 4; i++ )); do bar+='═'; done
    [[ "$kind" == '╔' ]] && end='╗' || end='╝'
    echo -e "${CYAN}  ${kind}${bar}${end}${NC}"
}

_logo_box_blank() {
    local inner_w="$1"
    printf "${CYAN}  ║${NC}%*s${CYAN}║${NC}\n" "$((inner_w + 4))" ""
}

logo() {
    [[ -t 1 ]] || return 0

    local -a art=()
    local row len inner_w=0 left right sub sup

    for row in 0 1 2 3 4 5; do
        art[$row]=$(_logo_art_row "$row")
        len=${#art[$row]}
        (( len > inner_w )) && inner_w=$len
    done

    echo ""
    _logo_box_edge '╔' "$inner_w"
    _logo_box_blank "$inner_w"

    for row in "${art[@]}"; do
        printf "${CYAN}  ║${NC}  ${YELLOW}%-*s${NC}  ${CYAN}║${NC}\n" "$inner_w" "$row"
    done

    _logo_box_blank "$inner_w"

    sub="v${JOJONET_VERSION}  |  Iran ↔ Foreign Tunnel Manager"
    left=$(( (inner_w - ${#sub}) / 2 ))
    right=$(( inner_w - ${#sub} - left ))
    printf "${CYAN}  ║${NC}  %*s${BLUE}v${JOJONET_VERSION}${NC}  ${MAGENTA}|${NC}  Iran ↔ Foreign Tunnel Manager%*s  ${CYAN}║${NC}\n" \
        "$left" "" "$right" ""

    sup="Support: ${JOJONET_SUPPORT}"
    left=$(( (inner_w - ${#sup}) / 2 ))
    right=$(( inner_w - ${#sup} - left ))
    printf "${CYAN}  ║${NC}  %*s${GREEN}Support:${NC} ${JOJONET_SUPPORT}%*s  ${CYAN}║${NC}\n" \
        "$left" "" "$right" ""

    _logo_box_blank "$inner_w"
    _logo_box_edge '╚' "$inner_w"
    echo ""
}

