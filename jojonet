    [[ -z "$peer_ip" ]] && read -r -p "Peer server IP: " peer_ip
    peer_ip="${peer_ip// /}"
    if [[ -z "$peer_ip" ]] || ! validate_ipv4 "$peer_ip"; then
        sleep 2
        return 1
    fi
    [[ "$peer_ip" == "$loc_ip" ]] && { echo -e "${RED}[!] Same IP.${NC}"; sleep 2; return 1; }
    rem_ip="$peer_ip"

    if existing=$(find_tunnel_for_peer "$rem_ip"); then
        local ex_mode
        ex_mode=$(tunnel_mode_from_name "$existing")
        if [[ "$ex_mode" == "vxlan" ]]; then
            local _rrc=0
            restart_tunnel "$existing" || _rrc=$?
            sleep 2
            set -e
            return "$_rrc"
        fi
        echo -e "${YELLOW}[!] Non-VXLAN tunnel exists for $rem_ip [$existing]. Delete it first.${NC}"
        sleep 3
        set -e
        return 1
    fi

    if role_conf=$(resolve_server_role "$loc_ip"); then
        echo -e "${GREEN}[*] Role:${NC} $role_conf  ${YELLOW}(override: JOJONET_ROLE / --role)${NC}"
    else
        echo -e "${RED}[!] Role detection failed. Set JOJONET_ROLE=iran|kharej${NC}"
        sleep 2
        set -e
        return 1
    fi


    if jojonet_use_auto_defaults "$peer_from_cli"; then
        use_auto=1
    fi

    ins_name=$(allocate_tunnel_name "$rem_ip" "$role_conf" "vxlan") || { set -e; return 1; }
    if [[ "$role_conf" == "iran" ]]; then
        fwd_port=$(allocate_iran_forward_port "443")
        [[ "$fwd_port" != "443" ]] && echo -e "${YELLOW}[*] Port 443 in use — forward port $fwd_port${NC}"
    else
        fwd_port=""
    fi

    if (( use_auto )); then
        vxlan_port="${JOJONET_VXLAN_PORT:-$vxlan_port}"
        echo -e "  ${CYAN}VXLAN UDP:${NC} $vxlan_port (auto)"
    else
        read -r -p "VXLAN UDP port [$vxlan_port]: " _vp
        vxlan_port=${_vp:-$vxlan_port}
    fi
    if ! [[ "$vxlan_port" =~ ^[0-9]+$ ]] || (( vxlan_port < 1 || vxlan_port > 65535 )); then
        echo -e "${RED}[!] Invalid UDP port.${NC}"
        sleep 2
        set -e
        return 1
    fi

    vxlan_vni=$(compute_vxlan_vni "$loc_ip" "$rem_ip")
    subnet_byte=$(compute_pair_subnet_byte "$loc_ip" "$rem_ip")

    if subnet_byte_in_use "$subnet_byte"; then
        local other_peer=""
        other_peer=$(awk -F'"' -v b="$subnet_byte" '
            $0 ~ /Subnet_Byte/ && $2 == b { in_b=1 }
            in_b && $0 ~ /Remote_IP/ { print $2; exit }
        ' "$INSTANCES_DIR"/*.conf 2>/dev/null || true)
        if [[ -n "$other_peer" && "$other_peer" != "$rem_ip" ]]; then
            echo -e "${YELLOW}[!] Subnet ID $subnet_byte used by peer $other_peer (continuing — VXLAN uses 172.21.x).${NC}"
        fi
    fi

    resolve_tunnel_ips "$role_conf" "$subnet_byte" "vxlan"
    tun_ip="$Tun_IP"
    tun_remote="$Tun_Remote_IP_Raw"

    echo -e "\n${CYAN}--- VXLAN plan ---${NC}"
    echo -e "  Mode:      vxlan (UDP encapsulation)"
    echo -e "  Interface: $ins_name"
    echo -e "  Role:      $role_conf"
    echo -e "  VNI:       $vxlan_vni"
    echo -e "  UDP port:  $vxlan_port"
    echo -e "  Tunnel IP: $tun_ip"
    [[ -n "$fwd_port" ]] && echo -e "  Forward:   $fwd_port -> $tun_remote"
    [[ "$role_conf" == "kharej" ]] && hint "Now run on Iran: sudo jojonet --vxlan $loc_ip"

    echo -e "${YELLOW}[*] Applying VXLAN tunnel...${NC}"
    if deploy_tunnel "$ins_name" "$role_conf" "$loc_ip" "$rem_ip" "$subnet_byte" \
        "$tun_ip" "$tun_remote" "$ins_mtu" "$fwd_port" "vxlan" "$vxlan_port" "" \
        "$Tun_Server_IP" "$Tun_Client_IP"; then
        echo -e "${GREEN}[+] VXLAN tunnel [$ins_name] is up.${NC}"
        [[ "$role_conf" == "kharej" ]] && hint "Run on Iran: sudo jojonet --vxlan $loc_ip"
        sleep 2
        set -e
        return 0
    fi
    sleep 3
    set -e
    return 1
}

