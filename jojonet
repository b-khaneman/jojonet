               pgrep -f "wstunnel.*${name}" >/dev/null 2>&1; then
                echo -e "  process: ${GREEN}running${NC}"
                ok=$((ok + 1))
            else
                echo -e "  process: ${RED}not running${NC}"
            fi
            echo -e "  role:    ${Role:-?} ($([[ "${Role:-}" == "iran" ]] && echo SERVER || echo CLIENT))"
            echo -e "  control: TCP ${TcpPort:-?}"
            [[ -n "${Ports:-}" ]] && echo -e "  forward: ${Ports}"
            [[ -n "${WstunnelCmd:-}" ]] && echo -e "  cmd:     ${WstunnelCmd}"
            ;;
        dokodemo|xray_reverse)
            if xray_process_running "$name"; then
                echo -e "  process: ${GREEN}running${NC}"
                ok=$((ok + 1))
            else
                echo -e "  process: ${RED}not running${NC}"
                fatal=1
            fi
            echo -e "  role:    ${Role:-?}  transport: VLESS/${XrayNet:-tcp}"
            if xray_ctrl_listener "${TunnelMode}" "${Role:-}"; then
                if tcp_port_listening "${TcpPort:-0}"; then
                    echo -e "  control: ${GREEN}listening TCP ${TcpPort}${NC}"
                else
                    echo -e "  control: ${RED}TCP ${TcpPort:-?} not listening${NC}"
                    fatal=1
                fi
            else
                echo -e "  control: dials ${Remote_IP:-?}:${TcpPort:-?}"
            fi
            [[ -n "${Ports:-}" ]] && echo -e "  forward: ${Ports}"
            [[ -n "${XrayJson:-}" ]] && echo -e "  config:  ${XrayJson}"
            ;;
        dnstt)
            if stream_process_running "$name"; then
                echo -e "  process: ${GREEN}running${NC}"
                ok=$((ok + 1))
            else
                echo -e "  process: ${RED}not running${NC}"
                fatal=1
            fi
            echo -e "  domain:  ${DnsDomain:-?}  resolver: ${DnsMode:-doh} ${DnsResolver:-}"
            echo -e "  dns udp: ${TcpPort:-5300}  ($([[ "${Role:-}" == "kharej" ]] && echo server || echo client))"
            [[ -n "${Ports:-}" ]] && echo -e "  forward: ${Ports}"
            ;;
        icmp)
            if stream_process_running "$name"; then
                echo -e "  process: ${GREEN}running${NC}"
                ok=$((ok + 1))
            else
                echo -e "  process: ${RED}not running${NC}"
                fatal=1
            fi
            echo -e "  carrier: ICMP echo + ChaCha20  ($([[ "${Role:-}" == "kharej" ]] && echo server || echo client))"
            [[ -n "${Ports:-}" ]] && echo -e "  forward: ${Ports}"
            ;;
        sit|gre6|ipip6)
            if ip link show "${V6Iface:-$name}" >/dev/null 2>&1; then
                echo -e "  sit:     ${GREEN}present${NC} (${V6Iface:-$name})"
                ok=$((ok + 1))
            else
                echo -e "  sit:     ${RED}missing${NC}"
                fatal=1
            fi
            if [[ "${TunnelMode}" != "sit" ]]; then
                if ip link show "$name" >/dev/null 2>&1; then
                    echo -e "  iface:   ${GREEN}present${NC}"
                    ok=$((ok + 1))
                else
                    echo -e "  iface:   ${RED}missing${NC}"
                    fatal=1
                fi
            fi
            if [[ -n "${V6Remote:-}" ]]; then
                if ping -6 -c1 -W2 "$V6Remote" >/dev/null 2>&1; then
                    echo -e "  ping6 ${V6Remote}: ${GREEN}ok${NC}"
                    ok=$((ok + 1))
                else
                    echo -e "  ping6 ${V6Remote}: ${YELLOW}fail${NC}"
                fi
            fi
            local _v4peer="${Tun_Remote_IP_Raw:-}"
            [[ -z "$_v4peer" && "${Role:-}" == "kharej" ]] && _v4peer="${Tun_Client_IP:-}"
            if [[ "${TunnelMode}" != "sit" && -n "$_v4peer" ]]; then
                if ping -c1 -W2 "$_v4peer" >/dev/null 2>&1; then
                    echo -e "  ping ${_v4peer}: ${GREEN}ok${NC}"
                    ok=$((ok + 1))
                else
                    echo -e "  ping ${_v4peer}: ${YELLOW}fail${NC}"
                fi
            fi
            ;;
    esac
    (( fatal == 0 && ok > 0 ))
}

