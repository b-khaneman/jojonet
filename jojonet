        hysteria2)
            if [[ -n "${HyHopRange:-}" ]]; then
                echo -e "  ${GREEN}Hop Port:${NC}    ${HyHopRange} every ${HyHopInterval:-$DEFAULT_HY2_HOP_INTERVAL}"
            else
                echo -e "  ${GREEN}UDP port:${NC}     ${TcpPort:-?}  |  SNI ${HySni:-${DEFAULT_HY2_SNI}}"
