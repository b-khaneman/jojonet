quick_add_tunnel_stream() {
    local mode="$1" peer_ip="${2:-}"
    local peer_from_cli=0 use_auto=0 ins_name="" role_conf="" loc_ip="" rem_ip=""
    local fwd_port="" key_dir="" dns_port="$DEFAULT_DNSTT_DNS_PORT" domain="" resolver="" dns_mode=""
    local existing="" pair_id="" subnet_byte="" _fp="" _dm="" _rs="" _dp=""
    local direct=0

    stream_mode "$mode" || { log_error "Unknown stream mode: $mode"; return 1; }
    [[ -n "$peer_ip" ]] && peer_from_cli=1
    case "${JOJONET_DIRECT:-0}" in 1|y|Y|yes|YES|true|TRUE|on|ON) direct=1 ;; esac

    set +e
    clear_screen
    logo
    print_banner "$(tunnel_mode_label "$mode")"
    echo -e "${CYAN}How it works:${NC}"
    if [[ "$mode" == "dnstt" ]]; then
        echo -e "  Kharej = ${GREEN}dnstt-server${NC} on UDP/53 (NS of your subdomain must point here)"
        echo -e "  Iran   = ${GREEN}dnstt-client${NC} via DoH/DoT/UDP resolver (looks like DNS)"
        echo -e "  Noise_NK encryption + SOCKS auth. Public ports on Iran → 127.0.0.1 on Kharej."
        echo -e "  ${YELLOW}Required:${NC} a subdomain whose NS A record is the Kharej public IP."
        echo -e "  Example:  t.example.com NS ns.t.example.com  +  ns.t.example.com A <KHAREJ_IP>"
        echo -e "  Then JOJONET_DNSTT_DOMAIN=t.example.com"
    else
        echo -e "  Kharej = ${GREEN}pingtunnel server${NC} (ICMP echo, ChaCha20)"
        echo -e "  Iran   = ${GREEN}pingtunnel client${NC} (SOCKS over ping) + port forwards"
        echo -e "  Use when TCP/UDP/DNS are filtered but ping still works."
        echo -e "  ${YELLOW}Not the same as${NC} --wg-icmp (that wraps WireGuard in udp2raw)."
        echo -e "  While this tunnel is up, the kernel will not answer ordinary ping on this host."
    fi
    echo ""

    if [[ "$mode" == "dnstt" ]]; then
        install_dnstt_binaries || { sleep 2; set -e; return 1; }
        install_gost_binary || { sleep 2; set -e; return 1; }
        install -d -m700 "$DNSTT_CONFIG_DIR"
    else
        install_pingtunnel_binary || { sleep 2; set -e; return 1; }
        install_gost_binary || { sleep 2; set -e; return 1; }
        install -d -m700 "$ICMP_CONFIG_DIR"
    fi

    if ! auto_detect_network; then
        echo -e "${RED}[!] Cannot detect network.${NC}"
        sleep 2; set -e; return 1
    fi
    loc_ip="$DETECTED_IP"
    show_existing_tunnels_summary

    if (( direct == 0 )) && [[ -z "$peer_ip" ]]; then
        echo -e "  ${CYAN}Peer IP empty${NC} = direct Kharej (no Iran VPS; users run the client themselves)."
        read -r -p "Peer server IP (empty = one Kharej only): " peer_ip
        peer_ip="${peer_ip// /}"
        if [[ -z "$peer_ip" ]]; then
            direct=1
            export JOJONET_DIRECT=1
        fi
    fi
    if (( direct == 1 )); then
        export JOJONET_ROLE=kharej JOJONET_DIRECT=1
        [[ -n "$peer_ip" ]] || peer_ip="$loc_ip"
        echo -e "${GREEN}[*] Direct Kharej:${NC} this is the only VPS. Clients run on user devices."
    fi
    peer_ip="${peer_ip// /}"
    if ! validate_ipv4 "$peer_ip"; then
        echo -e "${RED}[!] Invalid peer IP.${NC}"
        sleep 2; set -e; return 1
    fi
    rem_ip="$peer_ip"
    if [[ "$rem_ip" == "$loc_ip" ]]; then
        direct=1
        export JOJONET_ROLE=kharej JOJONET_DIRECT=1
    fi

    if existing=$(find_tunnel_for_peer "$rem_ip" "$mode"); then
        echo -e "${YELLOW}[!] $(tunnel_mode_label "$mode") to $rem_ip exists [$existing]. Restarting...${NC}"
        local _rrc=0
        restart_tunnel "$existing" || _rrc=$?
        sleep 2; set -e; return "$_rrc"
    fi

    if (( direct == 1 )); then
        role_conf="kharej"
    elif ! role_conf=$(resolve_server_role "$loc_ip"); then
        echo -e "${RED}[!] Role required. Set JOJONET_ROLE=iran|kharej${NC}"
        sleep 2; set -e; return 1
    fi
    if (( direct == 1 )); then
        echo -e "${GREEN}[*] Role:${NC} kharej (direct / no Iran VPS)"
    else
        echo -e "${GREEN}[*] Role:${NC} $role_conf"
    fi

    if [[ "$(count_tunnels_of_mode "$mode")" != "0" ]]; then
        echo -e "${RED}[!] Only one $(tunnel_mode_label "$mode") tunnel is allowed on this server.${NC}"
        if [[ "$mode" == "dnstt" ]]; then
            echo -e "    UDP/53 can only serve one DNSTT domain."
        else
            echo -e "    Raw ICMP echo can only be owned by one pingtunnel process."
        fi
        sleep 3; set -e; return 1
    fi

    if jojonet_use_auto_defaults "$peer_from_cli"; then
        use_auto=1
    fi
    ins_name=$(allocate_tunnel_name "$rem_ip" "$role_conf" "$mode") || { set -e; return 1; }
    subnet_byte=$(compute_pair_subnet_byte "$loc_ip" "$rem_ip")

    if [[ "$mode" == "dnstt" ]]; then
        domain="${JOJONET_DNSTT_DOMAIN:-}"
        dns_mode=$(printf '%s' "${JOJONET_DNSTT_MODE:-$DEFAULT_DNSTT_MODE}" | tr '[:upper:]' '[:lower:]')
        resolver="${JOJONET_DNSTT_RESOLVER:-}"
        dns_port="${JOJONET_DNSTT_DNS_PORT:-$DEFAULT_DNSTT_DNS_PORT}"
        fwd_port="${JOJONET_FWD_PORTS:-$DEFAULT_DNSTT_FWD}"
        if (( use_auto == 0 )); then
            read -r -p "DNSTT domain (NS must point at Kharej) [$domain]: " _dm
            domain="${_dm:-$domain}"
            read -r -p "Resolver mode doh/dot/udp [$dns_mode]: " _dm
            dns_mode=$(printf '%s' "${_dm:-$dns_mode}" | tr '[:upper:]' '[:lower:]')
            read -r -p "Resolver URL/host [$resolver]: " _rs
            resolver="${_rs:-$resolver}"
            read -r -p "Kharej DNS UDP listen port [$dns_port]: " _dp
            dns_port="${_dp:-$dns_port}"
            read -r -p "Kharej service ports, e.g. 443 or 8443:443 [$fwd_port]: " _fp
            fwd_port="${_fp:-$fwd_port}"
        fi
        domain="${domain%.}"
        domain="${domain,,}"
        if [[ -z "$domain" ]] || ! valid_dns_name "$domain"; then
            echo -e "${RED}[!] DNSTT domain required (FQDN). Set JOJONET_DNSTT_DOMAIN=t.example.com${NC}"
            sleep 2; set -e; return 1
        fi
        valid_dnstt_mode "$dns_mode" || { echo -e "${RED}[!] Resolver mode must be doh, dot or udp.${NC}"; sleep 2; set -e; return 1; }
        if [[ -z "$resolver" ]]; then
            case "$dns_mode" in
                doh) resolver="$DEFAULT_DNSTT_DOH" ;;
                dot) resolver="$DEFAULT_DNSTT_DOT" ;;
                udp) resolver="$DEFAULT_DNSTT_UDP" ;;
            esac
        fi
        if ! valid_dnstt_resolver "$dns_mode" "$resolver"; then
            echo -e "${RED}[!] Invalid resolver for mode $dns_mode: $resolver${NC}"
            sleep 2; set -e; return 1
        fi
        if ! validate_single_port "$dns_port"; then
            echo -e "${RED}[!] Invalid DNS listen port.${NC}"
            sleep 2; set -e; return 1
        fi
        dns_port=$((10#$dns_port))
        fwd_port=$(xray_normalize_ports "$fwd_port") || { sleep 2; set -e; return 1; }
        if [[ "$role_conf" == "iran" ]]; then
            fwd_port=$(xray_plan_iran_ports "$fwd_port") || { sleep 2; set -e; return 1; }
        fi
    else
        dns_port=$(stream_loop_port 14800 "$subnet_byte")
        fwd_port="${JOJONET_FWD_PORTS:-$DEFAULT_DNSTT_FWD}"
        if (( use_auto == 0 )); then
            read -r -p "Kharej service ports, e.g. 443 or 8443:443 [$fwd_port]: " _fp
            fwd_port="${_fp:-$fwd_port}"
        fi
        fwd_port=$(xray_normalize_ports "$fwd_port") || { sleep 2; set -e; return 1; }
        if [[ "$role_conf" == "iran" ]]; then
            fwd_port=$(xray_plan_iran_ports "$fwd_port") || { sleep 2; set -e; return 1; }
        fi
    fi

    pair_id=$(printf '%s' "$rem_ip" | tr '.' '_')
    if [[ "$mode" == "dnstt" ]]; then
        key_dir=$(ensure_dnstt_keys "$pair_id" "$rem_ip") || { set -e; return 1; }
    else
        key_dir=$(ensure_icmp_keys "$pair_id" "$rem_ip") || { set -e; return 1; }
    fi

    echo -e "\n${CYAN}--- $(tunnel_mode_label "$mode") plan ---${NC}"
    echo -e "  Name:      $ins_name"
    echo -e "  Role:      $role_conf"
    if (( direct == 1 )); then
        echo -e "  Mode:      ${GREEN}direct Kharej (no Iran VPS)${NC}"
        echo -e "  Server:    $loc_ip"
    else
        echo -e "  Peer:      $rem_ip"
    fi
    echo -e "  Forward:   $fwd_port"
    if [[ "$mode" == "dnstt" ]]; then
        echo -e "  Domain:    $domain"
        echo -e "  Resolver:  $dns_mode $resolver"
        echo -e "  DNS UDP:   $dns_port (Kharej; public 53 redirected if not 53)"
        echo -e "  Keys:      $key_dir/dnstt.priv + dnstt.pub + dnstt.auth"
        if [[ "$role_conf" == "kharej" ]]; then
            echo -e "  ${YELLOW}DNS records (parent zone of ${domain}):${NC}"
            echo -e "    ${domain}.  NS  ns.${domain}."
            echo -e "    ns.${domain}.  A   ${loc_ip}"
        fi
    else
        echo -e "  Carrier:   ICMP echo + ChaCha20 (pingtunnel ${PINGTUNNEL_VERSION})"
        echo -e "  Keys:      $key_dir/pingtunnel.key + pingtunnel.encrypt"
    fi
    if (( direct == 1 )); then
        hint "No Iran VPS. After start, run the printed client command on user devices."
        hint "Kharej services must listen on 127.0.0.1 (or all) for the target ports"
    elif [[ "$role_conf" == "iran" ]]; then
        hint "Now run on Kharej: sudo jojonet $(tunnel_cli_flag "$mode") $loc_ip"
    else
        hint "Kharej services must listen on 127.0.0.1 (or all) for the target ports"
        hint "Now run on Iran: sudo jojonet $(tunnel_cli_flag "$mode") $loc_ip"
    fi
    echo ""

    if DnsDomain="$domain" DnsResolver="$resolver" DnsMode="$dns_mode" \
        deploy_tunnel "$ins_name" "$role_conf" "$loc_ip" "$rem_ip" "$subnet_byte" \
        "" "" "0" "$fwd_port" "$mode" "$dns_port" "$key_dir" "" "" "tcp"; then
        echo -e "${GREEN}[+] $(tunnel_mode_label "$mode") [$ins_name] is up.${NC}"
        if (( direct == 1 )); then
            show_direct_client_card "$mode" "$loc_ip" "$key_dir" "$domain" "$dns_mode" "$resolver"
        fi
        sleep 2
        set -e
        return 0
    fi
    sleep 3
    set -e
    return 1
}

# ==========================================
# v1.6.0 — Single-server relays (hiddify-relay style): iptables / GOST / HAProxy / Socat / Xray
# Iran relay server → main server; no JojoNet needed on the destination.
# ==========================================

_JOJONET_RELAY_KEYS="Name Engine Target Ports Proto ApiPort"

load_relay_config() {
    local file="$1" line key val
    Name="" Engine="" Target="" Ports="" Proto="" ApiPort=""
    [[ -r "$file" ]] || return 1
    while IFS= read -r line || [[ -n "$line" ]]; do
        line="${line%%#*}"
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"
        [[ -z "$line" ]] && continue
        [[ "$line" =~ ^([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]] || return 1
        key="${BASH_REMATCH[1]}"
        val="${BASH_REMATCH[2]}"
        case " ${_JOJONET_RELAY_KEYS} " in *" $key "*) ;; *) return 1 ;; esac
        if [[ "$val" =~ ^\"(.*)\"$ ]]; then val="${BASH_REMATCH[1]}"; fi
        case "$val" in *'$('*|*'`'*|*';'*|*'|'*|*'&'*|*' '*|*$'\n'*|*$'\r'*) return 1 ;; esac
        printf -v "$key" '%s' "$val"
    done < "$file"
    [[ -n "$Name" && -n "$Engine" && -n "$Target" && -n "$Ports" ]]
}

valid_relay_name() { [[ "${1:-}" =~ ^[a-z0-9][a-z0-9-]{0,23}$ ]]; }
valid_relay_engine() { [[ "${1:-}" =~ ^(iptables|gost|haproxy|socat|xray)$ ]]; }
valid_relay_target() {
    validate_ipv4 "${1:-}" && return 0
    [[ "${1:-}" =~ ^[A-Za-z0-9]([A-Za-z0-9.-]{0,251}[A-Za-z0-9])?$ && "${1:-}" == *.* && ! "${1:-}" =~ ^[0-9.]+$ ]]
}

relay_unit() {
    if [[ "$2" == "iptables" ]]; then
        echo "jojonet-relay-nat@${1}.service"
    else
        echo "jojonet-relay@${1}.service"
    fi
}

detect_gost_arch() {
    case "$(uname -m)" in
        x86_64|amd64) echo "amd64" ;;
        aarch64|arm64) echo "arm64" ;;
        armv7l|armv7*) echo "armv7" ;;
        *) return 1 ;;
    esac
}

install_gost_binary() {
    [[ -x "$GOST_BIN" ]] && return 0
    local arch ver fname tmpdir base want got ok=0
    arch=$(detect_gost_arch) || { log_error "Unsupported CPU for GOST: $(uname -m)"; return 1; }
    command -v tar >/dev/null 2>&1 || { log_error "tar required for GOST"; return 1; }
    ver="${GOST_VERSION#v}"
    fname="gost_${ver}_linux_${arch}.tar.gz"
    tmpdir=$(mktemp -d /tmp/jojonet-gost.XXXXXX) || return 1
    log_note "Downloading GOST ${GOST_VERSION} ($fname)..."
    for base in \
        "https://github.com/go-gost/gost/releases/download/${GOST_VERSION}" \
        "https://ghproxy.net/https://github.com/go-gost/gost/releases/download/${GOST_VERSION}" \
        "https://mirror.ghproxy.com/https://github.com/go-gost/gost/releases/download/${GOST_VERSION}"
    do
        echo -e "  ${CYAN}try${NC} $base/$fname" >&2
        rm -f "$tmpdir/$fname" "$tmpdir/checksums.txt"
        xray_fetch "$base/$fname" "$tmpdir/$fname" || continue
        xray_fetch "$base/checksums.txt" "$tmpdir/checksums.txt" || continue
        want=$(awk -v f="$fname" '$2 == f || $2 == "*"f { print tolower($1); exit }' "$tmpdir/checksums.txt")
        got=$(sha256_of "$tmpdir/$fname")
        if [[ "$want" =~ ^[0-9a-f]{64}$ && "$want" == "$got" ]]; then
            ok=1
            break
        fi
        log_warn "GOST checksum mismatch from $base"
    done
    if (( ok != 1 )); then
        rm -rf "$tmpdir"
        log_error "Failed to download a verified GOST ${GOST_VERSION}"
        return 1
    fi
    if ! tar -xzf "$tmpdir/$fname" -C "$tmpdir" gost 2>/dev/null || [[ ! -f "$tmpdir/gost" ]]; then
        rm -rf "$tmpdir"
        log_error "gost binary missing in $fname"
        return 1
    fi
    install -m755 "$tmpdir/gost" "$GOST_BIN"
    rm -rf "$tmpdir"
    log_info "gost installed: $GOST_BIN"
}

relay_alloc_api_port() {
    local p f used=""
    shopt -s nullglob
    for f in "$RELAY_DIR"/*.conf; do
        used="$used,$(conf_get_field "$f" "ApiPort"),"
    done
    shopt -u nullglob
    for ((p = DEFAULT_RELAY_API_PORT; p < DEFAULT_RELAY_API_PORT + 200; p++)); do
        [[ "$used" == *",$p,"* ]] && continue
        tcp_port_listening "$p" && continue
        echo "$p"
        return 0
    done
    return 1
}

create_relay_runner_script() {
    if ! cat << 'EOF' > "$RELAY_RUNNER"
#!/usr/bin/env bash
set -Euo pipefail

_JOJONET_RELAY_KEYS="Name Engine Target Ports Proto ApiPort"

load_relay_config() {
    local file="$1" line key val
    Name="" Engine="" Target="" Ports="" Proto="" ApiPort=""
    [[ -r "$file" ]] || return 1
    while IFS= read -r line || [[ -n "$line" ]]; do
        line="${line%%#*}"
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"
        [[ -z "$line" ]] && continue
        [[ "$line" =~ ^([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]] || return 1
        key="${BASH_REMATCH[1]}"
        val="${BASH_REMATCH[2]}"
        case " ${_JOJONET_RELAY_KEYS} " in *" $key "*) ;; *) return 1 ;; esac
        if [[ "$val" =~ ^\"(.*)\"$ ]]; then val="${BASH_REMATCH[1]}"; fi
        case "$val" in *'$('*|*'`'*|*';'*|*'|'*|*'&'*|*' '*|*$'\n'*|*$'\r'*) return 1 ;; esac
        printf -v "$key" '%s' "$val"
    done < "$file"
    [[ -n "$Name" && -n "$Engine" && -n "$Target" && -n "$Ports" ]]
}

ACTION="${1:-}"
CONFIG_FILE="${2:-}"
[[ -n "$CONFIG_FILE" && -f "$CONFIG_FILE" ]] || { echo "Config missing" >&2; exit 1; }
load_relay_config "$CONFIG_FILE" || { echo "Bad relay config: $CONFIG_FILE" >&2; exit 1; }
[[ "$Name" =~ ^[a-z0-9][a-z0-9-]{0,23}$ ]] || { echo "Bad relay name" >&2; exit 1; }
TAG="jojonet-relay-${Name}"
RUN_DIR="/run/jojonet"

log() { echo "[jojonet-relay:${Name}] $*"; }

PROTOS=()
case "${Proto:-both}" in
    tcp) PROTOS=(tcp) ;;
    udp) PROTOS=(udp) ;;
    *) PROTOS=(tcp udp) ;;
esac
ITEMS=()
IFS=',' read -ra ITEMS <<< "$Ports"
for _it in "${ITEMS[@]}"; do
    [[ "$_it" =~ ^[0-9]{1,5}(:[0-9]{1,5})?$ ]] || { echo "Bad port entry: $_it" >&2; exit 1; }
done

nat_clean() {
    local t rule
    local -a args=()
    command -v iptables >/dev/null 2>&1 || return 0
    for t in nat filter; do
        while IFS= read -r rule; do
            [[ "$rule" == "-A "* ]] || continue
            read -ra args <<< "${rule/#-A /-D }"
            iptables -t "$t" "${args[@]}" 2>/dev/null || true
        done < <(iptables -t "$t" -S 2>/dev/null | grep -E -- "--comment \"?${TAG}\"?( |\$)" || true)
    done
}

nat_start() {
    local item l t p
    command -v iptables >/dev/null 2>&1 || { log "ERROR: iptables is not installed"; return 1; }
    nat_clean
    sysctl -w net.ipv4.ip_forward=1 >/dev/null 2>&1 || true
    for item in "${ITEMS[@]}"; do
        l="${item%%:*}"
        t="${item##*:}"
        for p in "${PROTOS[@]}"; do
            iptables -t nat -A PREROUTING -p "$p" --dport "$l" -m comment --comment "$TAG" \
                -j DNAT --to-destination "${Target}:${t}" || return 1
            iptables -t nat -A POSTROUTING -d "$Target" -p "$p" --dport "$t" -m comment --comment "$TAG" \
                -j MASQUERADE || return 1
            iptables -I FORWARD -d "$Target" -p "$p" --dport "$t" -m comment --comment "$TAG" -j ACCEPT || return 1
            iptables -I FORWARD -s "$Target" -p "$p" --sport "$t" -m comment --comment "$TAG" -j ACCEPT || return 1
        done
        log "iptables ${PROTOS[*]} :$l → ${Target}:$t"
    done
}

xray_relay_json() {
    local item l t inb net
    case "${Proto:-both}" in tcp) net="tcp" ;; udp) net="udp" ;; *) net="tcp,udp" ;; esac
    inb="{\"tag\":\"api\",\"listen\":\"127.0.0.1\",\"port\":${ApiPort},\"protocol\":\"dokodemo-door\",\"settings\":{\"address\":\"127.0.0.1\"}}"
    for item in "${ITEMS[@]}"; do
        l="${item%%:*}"
        t="${item##*:}"
        inb="${inb},{\"tag\":\"in-${l}\",\"listen\":\"0.0.0.0\",\"port\":${l},\"protocol\":\"dokodemo-door\",\"settings\":{\"address\":\"${Target}\",\"port\":${t},\"network\":\"${net}\"}}"
    done
    printf '{"log":{"loglevel":"warning"},"stats":{},"api":{"tag":"api","services":["StatsService"]},"policy":{"system":{"statsInboundUplink":true,"statsInboundDownlink":true}},"inbounds":[%s],"outbounds":[{"tag":"direct","protocol":"freedom"}],"routing":{"rules":[{"type":"field","inboundTag":["api"],"outboundTag":"api"}]}}\n' "$inb"
}

case "$ACTION" in
    start)
        install -d -m700 "$RUN_DIR"
        case "$Engine" in
            iptables)
                if ! nat_start; then
                    log "ERROR: iptables rules failed"
                    nat_clean
                    exit 1
                fi
                log "SUCCESS"
                exit 0
                ;;
            gost)
                args=()
                for item in "${ITEMS[@]}"; do
                    for p in "${PROTOS[@]}"; do
                        args+=(-L "${p}://:${item%%:*}/${Target}:${item##*:}")
                    done
                done
                log "gost ${args[*]}"
                exec /usr/local/bin/gost "${args[@]}"
                ;;
            haproxy)
                cfg="$RUN_DIR/relay-${Name}.haproxy.cfg"
                {
                    printf 'global\n    maxconn 20000\n\ndefaults\n    mode tcp\n    timeout connect 10s\n    timeout client 1h\n    timeout server 1h\n'
                    for item in "${ITEMS[@]}"; do
                        printf '\nfrontend f_%s\n    bind 0.0.0.0:%s\n    default_backend b_%s\n' "${item%%:*}" "${item%%:*}" "${item%%:*}"
                        printf '\nbackend b_%s\n    server s1 %s:%s\n' "${item%%:*}" "$Target" "${item##*:}"
                    done
                } > "$cfg"
                haproxy -c -q -f "$cfg" || { log "ERROR: haproxy rejected $cfg"; exit 1; }
                log "haproxy $cfg"
                exec haproxy -db -f "$cfg"
                ;;
            socat)
                pids=()
                trap 'kill "${pids[@]}" 2>/dev/null; exit 0' TERM INT
                for item in "${ITEMS[@]}"; do
                    for p in "${PROTOS[@]}"; do
                        if [[ "$p" == "tcp" ]]; then
                            socat "TCP4-LISTEN:${item%%:*},fork,reuseaddr" "TCP4:${Target}:${item##*:}" &
                        else
                            socat -T 60 "UDP4-RECVFROM:${item%%:*},fork,reuseaddr" "UDP4-SENDTO:${Target}:${item##*:}" &
                        fi
                        pids+=("$!")
                    done
                    log "socat ${PROTOS[*]} :${item%%:*} → ${Target}:${item##*:}"
                done
                wait -n
                log "ERROR: a socat process exited"
                kill "${pids[@]}" 2>/dev/null
                exit 1
                ;;
            xray)
                [[ "$ApiPort" =~ ^[0-9]{1,5}$ ]] || { log "ERROR: ApiPort missing"; exit 1; }
                json="$RUN_DIR/relay-${Name}.json"
                xray_relay_json > "$json"
                chmod 600 "$json"
                /usr/local/bin/xray run -test -c "$json" >/dev/null 2>&1 || {
                    log "ERROR: xray rejected $json"
                    /usr/local/bin/xray run -test -c "$json" 2>&1 | tail -n 5
                    exit 1
                }
                log "xray dokodemo relay (stats API 127.0.0.1:${ApiPort})"
                exec /usr/local/bin/xray run -c "$json"
                ;;
            *)
                log "ERROR: unknown engine $Engine"
                exit 1
                ;;
        esac
        ;;
    stop)
        nat_clean
        rm -f "$RUN_DIR/relay-${Name}.json" "$RUN_DIR/relay-${Name}.haproxy.cfg"
        exit 0
        ;;
    *)
        echo "Invalid action" >&2
        exit 1
        ;;
esac
EOF
    then
        return 1
    fi
    chmod +x "$RELAY_RUNNER"
}

create_relay_service() {
    local tmp_file
    tmp_file=$(mktemp /tmp/jojonet_relay_svc.XXXXXX) || return 1
    if ! cat << 'EOF' > "$tmp_file"
[Unit]
Description=JojoNet Relay: %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Restart=always
RestartSec=5
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal
SyslogIdentifier=jojonet-relay-%i
ExecStart=/usr/local/bin/jojonet-run-relay.sh start /etc/jojonet/relays/%i.conf
ExecStopPost=/usr/local/bin/jojonet-run-relay.sh stop /etc/jojonet/relays/%i.conf
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
EOF
    then
        rm -f "$tmp_file"
        return 1
    fi
    if [[ -f "$RELAY_SERVICE" ]] && cmp -s "$tmp_file" "$RELAY_SERVICE"; then
        rm -f "$tmp_file"
    else
        mv -f "$tmp_file" "$RELAY_SERVICE" || { rm -f "$tmp_file"; return 1; }
        systemctl daemon-reload || return 1
    fi
    tmp_file=$(mktemp /tmp/jojonet_relay_nat_svc.XXXXXX) || return 1
    if ! cat << 'EOF' > "$tmp_file"
[Unit]
Description=JojoNet iptables Relay: %i
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
StandardOutput=journal
