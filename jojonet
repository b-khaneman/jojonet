validate_interface_name() {
    [[ "$1" =~ ^[a-zA-Z0-9]([a-zA-Z0-9_-]{0,13}[a-zA-Z0-9])?$ ]] || return 1
}

validate_ipv4() {
    local ip="$1"
    [[ "$ip" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || return 1

    local a b c d
    IFS='.' read -r a b c d <<< "$ip"

    local i
    for i in $a $b $c $d; do
        (( i <= 255 )) || return 1
    done

    (( a > 0 && a < 224 && a != 127 )) || return 1

    if [[ "$ip" =~ ^10\. || "$ip" =~ ^192\.168\. || "$ip" =~ ^172\.(1[6-9]|2[0-9]|3[0-1])\. ]]; then
        return 1
    fi
    return 0
}

validate_subnet_byte() {
    [[ "$1" =~ ^[0-9]+$ ]] || return 1
    (( "$1" >= 1 && "$1" <= 250 ))
}

validate_ports() {
    local part list
    IFS=',' read -ra list <<< "$1"

    for part in "${list[@]}"; do
        part="${part// /}"
        [[ -n "$part" ]] || return 1
        if [[ "$part" =~ ^([0-9]{1,5})$ ]]; then
            (( part >= 1 && part <= 65535 )) || return 1
        elif [[ "$part" =~ ^([0-9]{1,5})-([0-9]{1,5})$ ]]; then
            local a="${BASH_REMATCH[1]}"
            local b="${BASH_REMATCH[2]}"
            (( a >= 1 && a <= 65535 )) || return 1
            (( b >= 1 && b <= 65535 )) || return 1
            (( a <= b )) || return 1
        else
            return 1
        fi
    done
    return 0
}

# Prints the egress interface (token after "dev"); works with or without a "via" gateway.
detect_default_iface() {
    local dev=""
    dev=$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{for (i = 1; i < NF; i++) if ($i == "dev") { print $(i + 1); exit }}')
    [[ -n "$dev" ]] || dev=$(ip -4 route show default 2>/dev/null | awk '{for (i = 1; i < NF; i++) if ($i == "dev") { print $(i + 1); exit }}')
    [[ -n "$dev" ]] || return 1
    printf '%s\n' "$dev"
}

auto_detect_network() {
    local src=""
    DEFAULT_IFACE=$(detect_default_iface || true)
    if [[ -z "$DEFAULT_IFACE" ]]; then
        echo -e "${RED}[!] Default interface not found.${NC}" >&2
        return 1
    fi

    src=$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{for (i = 1; i < NF; i++) if ($i == "src") { print $(i + 1); exit }}')
    if [[ -n "$src" ]] && ip -4 -o addr show dev "$DEFAULT_IFACE" 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | grep -qxF "$src"; then
        DETECTED_IP="$src"
    else
        DETECTED_IP=$(ip -4 -o addr show dev "$DEFAULT_IFACE" scope global 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -n1 || true)
    fi
    if [[ -z "$DETECTED_IP" ]]; then
        echo -e "${RED}[!] No IPv4 on $DEFAULT_IFACE.${NC}" >&2
        return 1
    fi
}

calculate_mtu() {
    local target="${1:-1.1.1.1}"
    local min=1200 max=1472 size best=0

    echo -e "${YELLOW}[*] Probing path MTU via ping to $target...${NC}" >&2

    while (( min <= max )); do
        size=$(( (min + max) / 2 ))
        if ping -M "do" -c1 -W2 -s "$size" "$target" >/dev/null 2>&1; then
            best=$size
            min=$(( size + 1 ))
        else
            max=$(( size - 1 ))
        fi
    done

    if (( best == 0 )); then
        echo "$DEFAULT_MTU_FALLBACK"
        return
    fi

    # GRE overhead: IP(20) + GRE(24) vs ICMP probe size
    local mtu=$(( best + 28 - 24 ))
    (( mtu > 1500 )) && mtu=1500
    if (( mtu < 1280 )); then
        mtu=$DEFAULT_MTU_FALLBACK
    fi
    # Prefer stable 1310 when probe is close (common GRE setup)
    if (( mtu > DEFAULT_MTU_FALLBACK )); then
        mtu=$DEFAULT_MTU_FALLBACK
    fi
    echo "$mtu"
}

generate_unique_subnet() {
    touch "$LOCK_FILE" 2>/dev/null || true
    exec 200>"$LOCK_FILE"
    flock -x 200

    local used=""
    shopt -s nullglob
    local conf_files=("$INSTANCES_DIR"/*.conf)
    shopt -u nullglob

    if (( ${#conf_files[@]} > 0 )); then
        used=$(awk -F'"' '/Subnet_Byte/ {print $2}' "${conf_files[@]}" 2>/dev/null || true)
    fi

    local byte
    for byte in $(seq 1 250); do
        if ! grep -qx "$byte" <<< "$used" 2>/dev/null; then
            echo "$byte"
            flock -u 200
            exec 200>&-
            return
        fi
    done

    flock -u 200
    exec 200>&-
    echo 0
}

subnet_byte_in_use() {
    local byte="$1"
    shopt -s nullglob
    local files=("$INSTANCES_DIR"/*.conf)
    shopt -u nullglob
    (( ${#files[@]} > 0 )) || return 1
    awk -F'"' -v b="$byte" '$0 ~ /Subnet_Byte/ && $2 == b { found=1 } END { exit !found }' "${files[@]}"
}

apply_global_sysctl() {
    if [[ ! -f "$SYSCTL_FILE" ]]; then
        echo -e "${YELLOW}[*] Applying global network tuning (BBR + forwarding)...${NC}"
        cat <<EOF > "$SYSCTL_FILE"
# JojoNet network profile
net.core.default_qdisc=fq
net.ipv4.tcp_congestion_control=bbr
net.ipv4.ip_forward=1
net.ipv4.conf.all.rp_filter=0
net.ipv4.conf.default.rp_filter=0
net.ipv4.tcp_fastopen=3
net.core.rmem_max=67108864
net.core.wmem_max=67108864
net.core.netdev_max_backlog=250000
net.core.somaxconn=65535
net.ipv4.tcp_max_syn_backlog=65535
net.ipv4.ip_local_port_range=1024 65535
net.ipv4.tcp_fin_timeout=15
fs.file-max=2097152
EOF
        sysctl --system >/dev/null 2>&1 || true
    fi
    sysctl -w net.ipv4.ip_forward=1 >/dev/null 2>&1 || true
    sysctl -w net.ipv4.conf.all.rp_filter=0 >/dev/null 2>&1 || true
    sysctl -w net.ipv4.conf.default.rp_filter=0 >/dev/null 2>&1 || true
}

# Fix overlay IPs in saved configs (e.g. after v1.2.2 Iran/Kharej .1/.2 swap)
repair_tunnel_overlay_ips() {
    local conf="$1" name role subnet mode old_tun
    [[ -f "$conf" ]] || return 1
    mode=$(conf_get_field "$conf" "TunnelMode")
    mode=${mode:-gre}
    [[ "$mode" =~ ^(gre|vxlan|wireguard)$ ]] || return 1
    name=$(conf_get_field "$conf" "Name")
    role=$(conf_get_field "$conf" "Role")
    subnet=$(conf_get_field "$conf" "Subnet_Byte")
    if [[ "$mode" == "gre" ]]; then
        loc=$(conf_get_field "$conf" "Local_IP")
        rem=$(conf_get_field "$conf" "Remote_IP")
        [[ -z "$subnet" && -n "$loc" && -n "$rem" ]] && subnet=$(gre_subnet_for_pair "$loc" "$rem")
    fi
    [[ -n "$name" && -n "$role" && -n "$subnet" ]] || return 1
    old_tun=$(conf_get_field "$conf" "Tun_IP")
    WG_OBFS="$(conf_get_field "$conf" "WgObfs")" resolve_tunnel_ips "$role" "$subnet" "$mode"
    [[ "$old_tun" == "$Tun_IP" ]] && return 1
    grep -q '^Tun_IP=' "$conf" && sed -i "s/^Tun_IP=.*/Tun_IP=\"$Tun_IP\"/" "$conf"
    grep -q '^Tun_Server_IP=' "$conf" && sed -i "s/^Tun_Server_IP=.*/Tun_Server_IP=\"$Tun_Server_IP\"/" "$conf"
    grep -q '^Tun_Client_IP=' "$conf" && sed -i "s/^Tun_Client_IP=.*/Tun_Client_IP=\"$Tun_Client_IP\"/" "$conf"
    if [[ "$role" == "iran" ]]; then
        grep -q '^Tun_Remote_IP_Raw=' "$conf" && \
            sed -i "s/^Tun_Remote_IP_Raw=.*/Tun_Remote_IP_Raw=\"$Tun_Remote_IP_Raw\"/" "$conf"
    fi
    if [[ "$mode" == "gre" ]]; then
        grep -q '^GreKey=' "$conf" && sed -i 's/^GreKey=.*/GreKey=""/' "$conf"
    fi
    echo -e "${YELLOW}[*] Repaired overlay IPs [$name]: $old_tun -> $Tun_IP${NC}" >&2
    return 0
}
clamp_mtu() {
    local mtu="$1"
    if ! [[ "$mtu" =~ ^[0-9]+$ ]]; then
        echo "$DEFAULT_MTU_FALLBACK"
        return
    fi
    (( mtu < 576 )) && mtu=$DEFAULT_MTU_FALLBACK
    (( mtu > 9000 )) && mtu=$DEFAULT_MTU_FALLBACK
    echo "$mtu"
}

ipv4_to_uint() {
    local ip="${1:-0.0.0.0}" a=0 b=0 c=0 d=0
    IFS='.' read -r a b c d <<< "$ip"
    a=${a:-0}; b=${b:-0}; c=${c:-0}; d=${d:-0}
    echo $(( (a << 24) + (b << 16) + (c << 8) + d ))
}

# True if another WireGuard iface already listens on this UDP port
wg_udp_port_in_use() {
    local port="$1" exclude="${2:-}" iface lp=""
    command -v wg >/dev/null 2>&1 || return 1
    for iface in $(wg show interfaces 2>/dev/null); do
        [[ "$iface" == "$exclude" ]] && continue
        lp=$(wg show "$iface" listen-port 2>/dev/null || true)
        [[ -n "$lp" && "$lp" == "$port" ]] && return 0
    done
    return 1
}

# Return iface name if overlay IP is already assigned elsewhere
overlay_ip_on_iface() {
    local want="${1%%/*}" got=""
    got=$(ip -o -4 addr show 2>/dev/null | awk -v ip="$want" '
        $4 ~ "^" ip "(/|$)" { print $2; exit }')
    [[ -n "$got" ]] && printf '%s' "$got"
}

# Deterministic GRE subnet id (10-250) for a public IP pair — same value on both servers
gre_subnet_for_pair() {
    local ip1="$1" ip2="$2" b
    b=$(compute_pair_subnet_byte "$ip1" "$ip2")
    (( b < GRE_SUBNET_MIN )) && b=$(( b + GRE_SUBNET_MIN - 1 ))
    (( b > GRE_SUBNET_MAX )) && b=$(( (b % (GRE_SUBNET_MAX - GRE_SUBNET_MIN + 1)) + GRE_SUBNET_MIN ))
    echo "$b"
}

# Another GRE tunnel on THIS server already uses this subnet for a different peer
gre_subnet_taken_locally() {
    local byte="$1" rem="$2" f r mode
    shopt -s nullglob
    local files=("$INSTANCES_DIR"/*.conf)
    shopt -u nullglob
    for f in "${files[@]}"; do
        mode=$(conf_get_field "$f" "TunnelMode")
        [[ "${mode:-gre}" == "gre" ]] || continue
        [[ "$(conf_get_field "$f" "Subnet_Byte")" == "$byte" ]] || continue
        r=$(conf_get_field "$f" "Remote_IP")
        [[ "$r" == "$rem" ]] && continue
        return 0
    done
    return 1
}

# Pick GRE subnet: reuse saved config for same peer, else deterministic pair hash (both servers match)
allocate_gre_subnet_byte() {
    local loc="$1" rem="$2" existing="" saved="" candidate=""
    if existing=$(find_tunnel_for_peer "$rem" "gre"); then
        saved=$(conf_get_field "$INSTANCES_DIR/$existing.conf" "Subnet_Byte")
        [[ -n "$saved" ]] && { echo "$saved"; return 0; }
    fi
    candidate=$(gre_subnet_for_pair "$loc" "$rem")
    if gre_subnet_taken_locally "$candidate" "$rem"; then
        return 1
    fi
    echo "$candidate"
}

overlay_ip_in_use_for_role() {
    local role="$1" subnet_byte="$2" ip=""
    if [[ "$role" == "iran" ]]; then
        ip="${TUNNEL_NET_PREFIX}.${subnet_byte}.2"
    else
        ip="${TUNNEL_NET_PREFIX}.${subnet_byte}.1"
    fi
    overlay_ip_on_iface "$ip"
}

# Same subnet on both servers — derived from the IP pair (no manual Subnet ID)
compute_pair_subnet_byte() {
    local ip1="$1" ip2="$2" u1 u2 key h
    u1=$(ipv4_to_uint "$ip1")
    u2=$(ipv4_to_uint "$ip2")
    if (( u1 < u2 )); then
        key="${ip1}|${ip2}"
    else
        key="${ip2}|${ip1}"
    fi
    if command -v cksum >/dev/null 2>&1; then
        h=$(printf '%s' "$key" | cksum | awk '{print $1}')
    elif command -v md5sum >/dev/null 2>&1; then
        h=$(( 16#$(printf '%s' "$key" | md5sum | awk '{print $1}' | cut -c1-7) ))
    else
        h=$(( u1 ^ u2 ))
    fi
    echo $(( (h % 250) + 1 ))
}

# Unique GRE key per IP pair (required for multiple GRE tunnels on one server)
compute_gre_key() {
    local ip1="$1" ip2="$2" u1 u2 pair h
    u1=$(ipv4_to_uint "$ip1")
    u2=$(ipv4_to_uint "$ip2")
    if (( u1 < u2 )); then
        pair="${ip1}|${ip2}"
    else
        pair="${ip2}|${ip1}"
    fi
    if command -v cksum >/dev/null 2>&1; then
        h=$(printf '%s' "$pair" | cksum | awk '{print $1}')
    elif command -v md5sum >/dev/null 2>&1; then
        h=$(( 16#$(printf '%s' "$pair" | md5sum | awk '{print $1}' | cut -c1-7) ))
    else
        h=$(( u1 ^ u2 ))
    fi
    h=$(( (h % 2147483646) + 1 ))
    echo "$h"
}

# Unique VXLAN VNI per IP pair (1..16777215)
compute_vxlan_vni() {
    local vni
    vni=$(compute_gre_key "$1" "$2")
    (( vni > 16777215 )) && vni=$(( vni % 16777214 + 1 ))
    echo "$vni"
}

detect_server_role() {
    local ip="$1" cc="" raw="" url
    if command -v curl >/dev/null 2>&1; then
        for url in \
            "https://ip-api.com/json/${ip}?fields=countryCode" \
            "https://ipapi.co/${ip}/country_code/" \
            "https://ifconfig.co/country-iso?ip=${ip}"
        do
            raw=$(curl -fsSL --max-time 8 "$url" 2>/dev/null || true)
            cc=$(grep -oE '"countryCode":"[A-Z]{2}"' <<< "$raw" 2>/dev/null | head -1 | cut -d'"' -f4 || true)
            if [[ -z "$cc" ]]; then
                cc=$(tr -d '[:space:]"' <<< "$raw" | grep -oE '^[A-Z]{2}$' | head -1 || true)
            fi
            [[ "$cc" =~ ^[A-Z]{2}$ ]] && break
            cc=""
        done
    fi
    if [[ "$cc" == "IR" ]]; then
        printf '%s' "iran"
        return 0
    elif [[ -n "$cc" ]]; then
        printf '%s' "kharej"
        return 0
    fi
    return 1
}

prompt_server_role() {
    local choice=""
    log_warn "Could not auto-detect server country."
    echo -e "  ${GREEN}1)${NC} Iran (Port Forwarder)" >&2
    echo -e "  ${GREEN}2)${NC} Foreign (Gateway only)" >&2
    read -r -p "Choose [1/2]: " choice </dev/tty
    case "$choice" in
        1) printf '%s' "iran" ;;
        2) printf '%s' "kharej" ;;
        *) return 1 ;;
    esac
}

find_tunnel_for_peer() {
    local peer="$1" want_mode="${2:-}" f n r m o
    shopt -s nullglob
    local files=("$INSTANCES_DIR"/*.conf)
    shopt -u nullglob
    for f in "${files[@]}"; do
        n=$(grep -E '^Name=' "$f" 2>/dev/null | head -1 | cut -d'"' -f2)
        r=$(grep -E '^Remote_IP=' "$f" 2>/dev/null | head -1 | cut -d'"' -f2)
        m=$(grep -E '^TunnelMode=' "$f" 2>/dev/null | head -1 | cut -d'"' -f2)
        m=${m:-gre}
        if [[ -n "$n" && "$r" == "$peer" ]]; then
            if [[ -n "$want_mode" && "$m" != "$want_mode" ]]; then
                continue
            fi
            if [[ "$want_mode" == "wireguard" ]]; then
                # Plain, ICMP and FakeTCP WireGuard to one peer are separate tunnels.
                o=$(grep -E '^WgObfs=' "$f" 2>/dev/null | head -1 | cut -d'"' -f2)
                [[ "$o" == "${WG_OBFS:-}" ]] || continue
            fi
            echo "$n"
            return 0
        fi
    done
    return 1
}

tunnel_name_taken() {
    local name="$1"
    if [[ -f "$INSTANCES_DIR/$name.conf" ]]; then
        return 0
    fi
    ip link show "$name" >/dev/null 2>&1
}

generate_unique_tunnel_name() {
    local base="$1" candidate="" i max_base
    if ! tunnel_name_taken "$base"; then
        echo "$base"
        return 0
    fi
    for i in $(seq 2 99); do
        max_base=$((15 - ${#i}))
        (( max_base < 1 )) && max_base=1
        candidate="${base:0:max_base}${i}"
        if ! tunnel_name_taken "$candidate"; then
            echo "$candidate"
            return 0
        fi
    done
    return 1
}

# Unique interface per peer — e.g. ir195158230128 (foreign) / kh575200210 (iran)
generate_tunnel_name_from_peer() {
    local peer="$1" role="$2" mode="${3:-gre}" subnet_byte="${4:-}"
    local digits prefix base suffix=""
    digits=$(echo "$peer" | tr -d '.')
    if [[ "$mode" == "tun_tcp" ]]; then
        prefix="tc"
    elif [[ "$mode" == "paqet" ]]; then
        prefix="pq"
    elif [[ "$mode" == "vxlan" ]]; then
        prefix="vx"
    elif [[ "$mode" == "wireguard" ]]; then
        case "${WG_OBFS:-}" in
            icmp) prefix="wi" ;;
            faketcp) prefix="wf" ;;
            *) prefix="wg" ;;
        esac
    elif [[ "$mode" == "hysteria2" ]]; then
        prefix="hy"
    elif [[ "$mode" == "rathole" ]]; then
        prefix="rh"
    elif [[ "$mode" == "gre" && -n "$subnet_byte" ]]; then
        prefix="gr"
        suffix="b${subnet_byte}"
    elif [[ "$role" == "kharej" ]]; then
        prefix="ir"
    else
        prefix="kh"
    fi
    base="${prefix}${digits}${suffix}"
    if (( ${#base} > 15 )); then
        if [[ -n "$suffix" ]]; then
            base="${prefix}${digits: -$((15 - ${#prefix} - ${#suffix}))}${suffix}"
        else
            base="${prefix}${digits: -$((15 - ${#prefix}))}"
        fi
    fi
    generate_unique_tunnel_name "$base"
}

any_gre_present() {
    ip -o link show type gre 2>/dev/null | grep -q .
}

allocate_tunnel_name() {
    local peer="$1" role="$2" mode="${3:-gre}" subnet_byte="${4:-}"
    local base=""
    load_stealth_mode
    if [[ "$STEALTH_MODE" == "1" ]]; then
        base=$(generate_stealth_tunnel_name "$peer" "$role" "$mode")
        generate_unique_tunnel_name "$base"
        return 0
    fi
    generate_tunnel_name_from_peer "$peer" "$role" "$mode" "$subnet_byte"
}

wait_for_tunnel_up() {
    local name="$1" mode="$2" max_wait="${3:-60}"
    local i
    for ((i = 1; i <= max_wait; i++)); do
        if [[ "$mode" == "tun_tcp" || "$mode" == "wireguard" ]]; then
            ip link show "$name" >/dev/null 2>&1 && return 0
        elif [[ "$mode" == "paqet" ]]; then
            pgrep -f "paqet run -c.*/${name}\\.yaml" >/dev/null 2>&1 && return 0
        elif [[ "$mode" == "hysteria2" ]]; then
            if pgrep -f "hysteria.*${name}\\.yaml" >/dev/null 2>&1; then
                return 0
            fi
            if systemctl is-active --quiet "jojonet-hy2@${name}.service" 2>/dev/null; then
                return 0
            fi
        elif [[ "$mode" == "rathole" ]]; then
            if pgrep -f "rathole.*${name}\\.toml" >/dev/null 2>&1; then
                return 0
            fi
            if systemctl is-active --quiet "jojonet-rathole@${name}.service" 2>/dev/null; then
                return 0
            fi
        elif [[ "$mode" == "wstunnel" ]]; then
            if pgrep -x wstunnel >/dev/null 2>&1 || pgrep -f "wstunnel.*${name}" >/dev/null 2>&1; then
                return 0
            fi
            if systemctl is-active --quiet "jojonet-wstunnel@${name}.service" 2>/dev/null; then
                return 0
            fi
        elif ip link show "$name" 2>/dev/null | grep -qE 'state UP|UP,'; then
            return 0
        fi
        sleep 1
    done
    return 1
}

verify_tunnel_ping() {
    local target_ip="$1"
    [[ -n "$target_ip" ]] || return 0
    if ping -c 2 -W 3 "$target_ip" >/dev/null 2>&1; then
        echo -e "${GREEN}[+] Ping OK: $target_ip${NC}"
        return 0
    fi
    echo -e "${YELLOW}[!] Ping to $target_ip failed (check peer server / firewall).${NC}"
    return 1
}

repair_single_config() {
    local conf="$1" loc rem gre mode name changed=0
    [[ -f "$conf" ]] || return 0
    repair_tunnel_overlay_ips "$conf" && changed=1
    mode=$(conf_get_field "$conf" "TunnelMode")
    name=$(conf_get_field "$conf" "Name")
    [[ -n "$name" ]] || return 0

    if [[ "${mode:-gre}" == "gre" ]]; then
        : # plain GRE — no key
    elif [[ "${mode:-gre}" == "vxlan" ]]; then
        local vni port
        vni=$(conf_get_field "$conf" "VxlanVni")
        if [[ -z "$vni" ]]; then
            loc=$(conf_get_field "$conf" "Local_IP")
            rem=$(conf_get_field "$conf" "Remote_IP")
            vni=$(compute_vxlan_vni "$loc" "$rem")
            if grep -q '^VxlanVni=' "$conf"; then
                sed -i "s/^VxlanVni=.*/VxlanVni=\"$vni\"/" "$conf"
            else
                echo "VxlanVni=\"$vni\"" >> "$conf"
            fi
            changed=1
            echo -e "${YELLOW}[*] Repaired VxlanVni for [$name] -> $vni${NC}"
        fi
        port=$(conf_get_field "$conf" "VxlanPort")
        if [[ -z "$port" ]]; then
            if grep -q '^VxlanPort=' "$conf"; then
                sed -i "s/^VxlanPort=.*/VxlanPort=\"$DEFAULT_VXLAN_PORT\"/" "$conf"
            else
                echo "VxlanPort=\"$DEFAULT_VXLAN_PORT\"" >> "$conf"
            fi
            changed=1
        fi
    elif [[ "${mode:-gre}" == "paqet" ]]; then
        local yaml tcp_port key_dir role rem fwd proto
        yaml=$(conf_get_field "$conf" "PaqetYaml")
        tcp_port=$(conf_get_field "$conf" "TcpPort")
        key_dir=$(conf_get_field "$conf" "KeyDir")
        role=$(conf_get_field "$conf" "Role")
        rem=$(conf_get_field "$conf" "Remote_IP")
        fwd=$(conf_get_field "$conf" "Ports")
        proto=$(conf_get_field "$conf" "ForwardProto")
        proto=${proto:-tcp}
        if [[ -n "$yaml" && ( ! -f "$yaml" || ! -s "$yaml" ) && -n "$key_dir" ]]; then
            build_paqet_runtime_config "$name" "$role" "$rem" "${tcp_port:-$DEFAULT_PAQET_PORT}" \
                "$key_dir" "$fwd" "$proto" && changed=1
            echo -e "${YELLOW}[*] Repaired Paqet YAML for [$name]${NC}"
        fi
    elif [[ "${mode:-gre}" == "hysteria2" ]]; then
        local yaml tcp_port key_dir role rem fwd sni hop_range hop_interval need_rebuild=0
        yaml=$(conf_get_field "$conf" "HyYaml")
        tcp_port=$(conf_get_field "$conf" "TcpPort")
        key_dir=$(conf_get_field "$conf" "KeyDir")
        role=$(conf_get_field "$conf" "Role")
        rem=$(conf_get_field "$conf" "Remote_IP")
        fwd=$(conf_get_field "$conf" "Ports")
        sni=$(conf_get_field "$conf" "HySni")
        hop_range=$(conf_get_field "$conf" "HyHopRange")
        hop_interval=$(conf_get_field "$conf" "HyHopInterval")
        sni=${sni:-$DEFAULT_HY2_SNI}
        if [[ -z "$hop_range" && "$tcp_port" =~ ^[0-9]+-[0-9]+$ ]]; then
            hop_range="$tcp_port"
        fi
        if [[ -z "$yaml" || ! -f "$yaml" || ! -s "$yaml" ]]; then
            need_rebuild=1
        elif [[ -n "$hop_range" ]]; then
            # YAML stale if missing hop range or hopInterval
            if ! grep -qE "listen: :${hop_range}|server: .*:${hop_range}" "$yaml" 2>/dev/null; then
                need_rebuild=1
            elif [[ "$role" == "iran" ]] && ! grep -qE 'hopInterval:|minHopInterval:' "$yaml" 2>/dev/null; then
                need_rebuild=1
            fi
        fi
        # Kharej HY2 server must always have tls: or acme: (Hysteria2 requirement)
        if (( need_rebuild == 0 )) && [[ "$role" == "kharej" && -n "$yaml" && -f "$yaml" ]]; then
            if ! grep -qE '^[[:space:]]*(tls|acme):' "$yaml" 2>/dev/null; then
                need_rebuild=1
            fi
        fi
        if (( need_rebuild == 1 )) && [[ -n "$key_dir" && -f "$key_dir/hy2.auth" ]]; then
            HyTlsMode="$(conf_get_field "$conf" "HyTlsMode")"
            HyDomain="$(conf_get_field "$conf" "HyDomain")"
            HyAcmeEmail="$(conf_get_field "$conf" "HyAcmeEmail")"
            HyCertPath="$(conf_get_field "$conf" "HyCertPath")"
            HyKeyPath="$(conf_get_field "$conf" "HyKeyPath")"
            export HyTlsMode HyDomain HyAcmeEmail HyCertPath HyKeyPath
            yaml=$(build_hy2_runtime_config "$name" "$role" "$rem" \
                "${tcp_port:-$DEFAULT_HY2_PORT}" "$key_dir" "$fwd" "$sni" \
                "$hop_range" "$hop_interval") && changed=1
            unset HyTlsMode HyDomain HyAcmeEmail HyCertPath HyKeyPath 2>/dev/null || true
            if [[ -n "$yaml" ]]; then
                if grep -q '^HyYaml=' "$conf"; then
                    sed -i "s|^HyYaml=.*|HyYaml=\"$yaml\"|" "$conf"
                else
                    echo "HyYaml=\"$yaml\"" >> "$conf"
                fi
                if [[ -n "$hop_range" ]]; then
                    if grep -q '^HyHopRange=' "$conf"; then
                        sed -i "s|^HyHopRange=.*|HyHopRange=\"$hop_range\"|" "$conf"
                    else
                        echo "HyHopRange=\"$hop_range\"" >> "$conf"
                    fi
                    [[ "$role" == "kharej" ]] && ensure_hy2_hop_firewall "$hop_range" || true
                fi
                echo -e "${YELLOW}[*] Repaired Hysteria2 YAML for [$name]${hop_range:+ (hop $hop_range)}${NC}"
            fi
        fi
    elif [[ "${mode:-gre}" == "rathole" ]]; then
        local toml tcp_port key_dir role rem fwd need_rebuild=0
        toml=$(conf_get_field "$conf" "RatholeToml")
        tcp_port=$(conf_get_field "$conf" "TcpPort")
        key_dir=$(conf_get_field "$conf" "KeyDir")
        role=$(conf_get_field "$conf" "Role")
        rem=$(conf_get_field "$conf" "Remote_IP")
        fwd=$(conf_get_field "$conf" "Ports")
        if [[ -z "$toml" || ! -f "$toml" || ! -s "$toml" ]]; then
            need_rebuild=1
        elif ! grep -qE '^\[(server|client)\]' "$toml" 2>/dev/null; then
            need_rebuild=1
        fi
        if (( need_rebuild == 1 )) && [[ -n "$key_dir" && -f "$key_dir/rathole.token" ]]; then
            toml=$(build_rathole_runtime_config "$name" "$role" "$rem" \
                "${tcp_port:-$DEFAULT_RATHOLE_CTRL_PORT}" "$key_dir" \
                "${fwd:-$DEFAULT_RATHOLE_FWD}") && changed=1
            if [[ -n "$toml" ]]; then
                if grep -q '^RatholeToml=' "$conf"; then
                    sed -i "s|^RatholeToml=.*|RatholeToml=\"$toml\"|" "$conf"
                else
                    echo "RatholeToml=\"$toml\"" >> "$conf"
                fi
                [[ "$role" == "iran" ]] && ensure_rathole_firewall "${tcp_port:-$DEFAULT_RATHOLE_CTRL_PORT}" "${fwd:-$DEFAULT_RATHOLE_FWD}" || true
                echo -e "${YELLOW}[*] Repaired Rathole TOML for [$name]${NC}"
            fi
        fi
    elif [[ "${mode:-gre}" == "wstunnel" ]]; then
        local cmd tcp_port key_dir role rem fwd need_rebuild=0
        cmd=$(conf_get_field "$conf" "WstunnelCmd")
        tcp_port=$(conf_get_field "$conf" "TcpPort")
        key_dir=$(conf_get_field "$conf" "KeyDir")
        role=$(conf_get_field "$conf" "Role")
        rem=$(conf_get_field "$conf" "Remote_IP")
        fwd=$(conf_get_field "$conf" "Ports")
        if [[ -z "$cmd" || ! -f "$cmd" || ! -x "$cmd" ]]; then
            need_rebuild=1
        fi
        if (( need_rebuild == 1 )) && [[ -n "$key_dir" && -f "$key_dir/wstunnel.token" ]]; then
            cmd=$(build_wstunnel_runtime_config "$name" "$role" "$rem"                 "${tcp_port:-$DEFAULT_WSTUNNEL_CTRL_PORT}" "$key_dir"                 "${fwd:-$DEFAULT_WSTUNNEL_FWD}") && changed=1
            if [[ -n "$cmd" ]]; then
                if grep -q '^WstunnelCmd=' "$conf"; then
                    sed -i "s|^WstunnelCmd=.*|WstunnelCmd=\"$cmd\"|" "$conf"
                else
                    echo "WstunnelCmd=\"$cmd\"" >> "$conf"
                fi
                [[ "$role" == "iran" ]] && ensure_wstunnel_firewall "${tcp_port:-$DEFAULT_WSTUNNEL_CTRL_PORT}" "${fwd:-$DEFAULT_WSTUNNEL_FWD}" || true
                echo -e "${YELLOW}[*] Repaired Wstunnel cmd for [$name]${NC}"
            fi
        fi
    fi

    if (( changed )); then
        systemctl restart "$(tunnel_service_unit "$name")" 2>/dev/null || true
    fi
}

