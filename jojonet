        printf '[Resolve]\nDNS=%s\nDomains=~.\n' "${d1}${d2:+ $d2}" > /etc/systemd/resolved.conf.d/99-jojonet.conf
        systemctl restart systemd-resolved || { log_error "systemd-resolved restart failed"; return 1; }
    else
        [[ -e /etc/resolv.conf.jojonet.bak ]] || cp -P /etc/resolv.conf /etc/resolv.conf.jojonet.bak 2>/dev/null || true
        [[ -L /etc/resolv.conf ]] && rm -f /etc/resolv.conf
        printf 'nameserver %s\n' "$d1" ${d2:+"$d2"} > /etc/resolv.conf
    fi
    log_info "DNS set: $d1${d2:+ $d2}"
}

server_ping_test() {
    local h out loss avg
    echo -e "${CYAN}=== Ping test ===${NC}"
    for h in github.com google.com cloudflare.com 1.1.1.1 8.8.8.8; do
        out=$(ping -c 3 -W 2 -q "$h" 2>/dev/null || true)
        loss=$(grep -oE '[0-9.]+% packet loss' <<< "$out" | cut -d% -f1 || true)
        avg=$(grep -oE '= [0-9.]+/[0-9.]+' <<< "$out" | cut -d/ -f2 || true)
        if [[ -n "$avg" ]]; then
            echo -e "  ${GREEN}ok${NC}    ${h}  avg ${avg} ms  loss ${loss:-0}%"
        else
            echo -e "  ${RED}fail${NC}  ${h}"
        fi
    done
}

