ensure_wstunnel_firewall() {
    local ctrl="${1:-$DEFAULT_WSTUNNEL_CTRL_PORT}" ports="${2:-$DEFAULT_WSTUNNEL_FWD}" p
    if command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -qi 'Status: active'; then
        ufw allow "${ctrl}/tcp" comment 'jojonet-wstunnel-ctrl' >/dev/null 2>&1 || true
        IFS=',' read -ra _pl <<< "$ports"
        for p in "${_pl[@]}"; do
            p="${p// /}"
            [[ "$p" =~ ^[0-9]+$ ]] || continue
            ufw allow "${p}/tcp" comment "jojonet-wstunnel-fwd-${p}" >/dev/null 2>&1 || true
        done
    fi
    if command -v firewall-cmd >/dev/null 2>&1 && firewall-cmd --state 2>/dev/null | grep -qi running; then
        firewall-cmd --permanent --add-port="${ctrl}/tcp" >/dev/null 2>&1 || true
        IFS=',' read -ra _pl <<< "$ports"
