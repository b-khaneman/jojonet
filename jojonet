quick_add_tunnel_wg() {
    local peer_ip="${1:-}"
    local peer_from_cli=0 use_auto=0
    [[ -n "$peer_ip" ]] && peer_from_cli=1
    local ins_name="" role_conf="" loc_ip="" rem_ip="" subnet_byte=""
    local tun_ip="" tun_remote="" ins_mtu="$DEFAULT_WG_MTU" fwd_port="" key_dir=""
    local wg_port="$DEFAULT_WG_PORT" existing="" obfs_port="" wg_flag="--wg"

    case "${WG_OBFS:-}" in
        "") ;;
        icmp|faketcp)
            wg_flag="--wg-${WG_OBFS}"
            ins_mtu="$DEFAULT_WG_OBFS_MTU"
            ;;
        *) log_error "Unknown WireGuard obfuscation: ${WG_OBFS}"; return 1 ;;
    esac

    set +e
    clear_screen
    logo
    if [[ -n "${WG_OBFS:-}" ]]; then
        print_banner "WireGuard over ${WG_OBFS^^} (udp2raw)"
    else
        print_banner "WireGuard Tunnel (low latency)"
    fi

    install_wireguard_tools || { sleep 2; set -e; return 1; }
    if [[ -n "${WG_OBFS:-}" ]]; then
        install_udp2raw_binary || { sleep 2; set -e; return 1; }
        create_u2r_runner_script || { set -e; return 1; }
        create_u2r_service || { set -e; return 1; }
    fi

    if ! auto_detect_network; then
        echo -e "${RED}[!] Cannot detect network.${NC}"
        sleep 2; set -e; return 1
    fi
    loc_ip="$DETECTED_IP"
    show_existing_tunnels_summary

    if [[ -z "$peer_ip" ]]; then
        read -r -p "Peer server IP: " peer_ip
    fi
    peer_ip="${peer_ip// /}"
    if ! validate_ipv4 "$peer_ip"; then
        echo -e "${RED}[!] Invalid peer IP.${NC}"
        sleep 2; set -e; return 1
    fi
    rem_ip="$peer_ip"

    if existing=$(find_tunnel_for_peer "$rem_ip" "wireguard"); then
        echo -e "${YELLOW}[!] WireGuard${WG_OBFS:+/${WG_OBFS}} to $rem_ip exists [$existing]. Restarting...${NC}"
        local _rrc=0
        restart_tunnel "$existing" || _rrc=$?
        sleep 2; set -e; return "$_rrc"
    fi

    if ! role_conf=$(resolve_server_role "$loc_ip"); then
        echo -e "${RED}[!] Role required. Set JOJONET_ROLE=iran|kharej${NC}"
        sleep 2; set -e; return 1
    fi
    echo -e "${GREEN}[*] Role:${NC} $role_conf"


    if jojonet_use_auto_defaults "$peer_from_cli"; then
        use_auto=1
    fi

    ins_name=$(allocate_tunnel_name "$rem_ip" "$role_conf" "wireguard") || { set -e; return 1; }
    if [[ "$role_conf" == "iran" ]]; then
        fwd_port=$(allocate_iran_forward_port "443")
        [[ "$fwd_port" != "443" ]] && echo -e "${YELLOW}[*] Port 443 in use — forward port $fwd_port${NC}"
    else
        fwd_port=""
    fi

    subnet_byte=$(compute_pair_subnet_byte "$loc_ip" "$rem_ip")
    if [[ -n "${WG_OBFS:-}" ]]; then
        # Both ports are derived from the pair, so the two servers agree without exchanging them.
        obfs_port="${JOJONET_WG_OBFS_PORT:-$(wg_obfs_default_port "$WG_OBFS" "$subnet_byte")}"
        validate_single_port "$obfs_port" || { log_error "Invalid udp2raw port: $obfs_port"; set -e; return 1; }
        wg_port=$(wg_obfs_wg_port "$obfs_port")
        if [[ "$role_conf" == "kharej" ]] && wg_udp_port_in_use "$wg_port"; then
            log_error "UDP $wg_port is used by another WireGuard interface. Set JOJONET_WG_OBFS_PORT on both servers."
            set -e; return 1
        fi
        echo -e "  ${CYAN}udp2raw port:${NC} $obfs_port  ${CYAN}WG UDP (local):${NC} $wg_port (derived from pair)"
    elif (( use_auto )); then
        wg_port="${JOJONET_WG_PORT:-$wg_port}"
        if [[ "$role_conf" == "kharej" ]] && wg_udp_port_in_use "$wg_port"; then
            local _try
            for _try in 51821 51822 51823 51824 51825; do
                wg_udp_port_in_use "$_try" && continue
                wg_port="$_try"
                break
            done
            echo -e "${YELLOW}[*] Default WG port busy — using UDP $wg_port (auto)${NC}"
        else
            echo -e "  ${CYAN}WG UDP:${NC} $wg_port (auto)"
        fi
    else
        read -r -p "WireGuard UDP port [$wg_port]: " _wp
        wg_port=${_wp:-$wg_port}
        if [[ "$role_conf" == "kharej" ]] && wg_udp_port_in_use "$wg_port"; then
            echo -e "${RED}[!] UDP port $wg_port is already used by another WireGuard interface.${NC}"
            echo -e "${YELLOW}    Check: wg show  |  ip link delete <iface>${NC}"
            echo -e "${YELLOW}    Or enter a different port (e.g. 51821).${NC}"
            read -r -p "WireGuard UDP port: " _wp2
            wg_port=${_wp2:-51821}
        fi
    fi

    resolve_tunnel_ips "$role_conf" "$subnet_byte" "wireguard"
    tun_ip="$Tun_IP"
    tun_remote="$Tun_Remote_IP_Raw"

    local pair_id
    pair_id=$(printf '%s' "$rem_ip" | tr '.' '_')
    key_dir=$(ensure_wg_keys "$pair_id" "$rem_ip" "$role_conf") || { set -e; return 1; }
    if [[ -n "${WG_OBFS:-}" ]]; then
        ensure_udp2raw_key "$pair_id" "$rem_ip" >/dev/null || { set -e; return 1; }
    fi
    WG_OBFS_PORT="$obfs_port"

    echo -e "\n${CYAN}--- WireGuard plan ---${NC}"
    echo -e "  Interface: $ins_name"
    echo -e "  Role:      $role_conf"
    echo -e "  Peer:      $rem_ip"
    echo -e "  Port:      UDP $wg_port"
    [[ -n "${WG_OBFS:-}" ]] && echo -e "  Carrier:   udp2raw ${WG_OBFS} (port ${obfs_port}, MTU ${ins_mtu})"
    echo -e "  Tunnel IP: $tun_ip"
    [[ -n "$fwd_port" ]] && echo -e "  Forward:   $fwd_port"
    echo ""

    if deploy_tunnel "$ins_name" "$role_conf" "$loc_ip" "$rem_ip" "$subnet_byte" \
        "$tun_ip" "$tun_remote" "$ins_mtu" "$fwd_port" "wireguard" "$wg_port" "$key_dir" \
        "$Tun_Server_IP" "$Tun_Client_IP"; then
        echo -e "${GREEN}[+] WireGuard [$ins_name] is up.${NC}"
        [[ "$role_conf" == "kharej" ]] && hint "Run on Iran: sudo jojonet ${wg_flag} $loc_ip"
        sleep 2
        set -e
        return 0
    fi
    sleep 3
    set -e
    return 1
}

# ==========================================
# Hysteria2 helpers
# ==========================================

HY2_RUNNER="/usr/local/bin/jojonet-run-hy2.sh"
HY2_SERVICE="/etc/systemd/system/jojonet-hy2@.service"
HY2_CONFIG_DIR="$JOJONET_ROOT/hysteria"
HY2_BIN="/usr/local/bin/hysteria"
HY2_REPO="apernet/hysteria"
HY2_VERSION="${JOJONET_HY2_VERSION:-v2.6.1}"
DEFAULT_HY2_PORT=443
DEFAULT_HY2_SNI="www.cloudflare.com"
DEFAULT_HY2_HOP_RANGE="20000-50000"
DEFAULT_HY2_HOP_INTERVAL="30s"

normalize_hy2_hop_interval() {
    local raw="${1:-$DEFAULT_HY2_HOP_INTERVAL}" sec="" a b
    raw="${raw//' '/}"
    [[ -z "$raw" ]] && { echo "$DEFAULT_HY2_HOP_INTERVAL"; return 0; }

    # Random interval form: 15s-45s or 15-45
    if [[ "$raw" =~ ^([0-9]+)s?-([0-9]+)s?$ ]]; then
        a="${BASH_REMATCH[1]}"
        b="${BASH_REMATCH[2]}"
        if (( a < 5 )); then a=5; fi
        if (( b < a )); then b=$((a + 15)); fi
        echo "${a}s-${b}s"
        return 0
    fi

    if [[ "$raw" =~ ^[0-9]+$ ]]; then
        sec="$raw"
    elif [[ "$raw" =~ ^([0-9]+)s$ ]]; then
        sec="${BASH_REMATCH[1]}"
    elif [[ "$raw" =~ ^([0-9]+)m$ ]]; then
        sec=$(( BASH_REMATCH[1] * 60 ))
    else
        echo "$DEFAULT_HY2_HOP_INTERVAL"
        return 1
    fi
    if (( sec < 5 )); then
        sec=5
    fi
    echo "${sec}s"
}

hy2_hop_span() {
    local range="$1" a b
    [[ "$range" =~ ^([0-9]+)-([0-9]+)$ ]] || { echo 0; return 1; }
    a="${BASH_REMATCH[1]}"
    b="${BASH_REMATCH[2]}"
    echo $(( b - a + 1 ))
}

hy2_hop_has_firewall_tools() {
    command -v nft >/dev/null 2>&1 || command -v iptables >/dev/null 2>&1
}

ensure_hy2_hop_firewall() {
    local range="$1" a b ufw_range
    [[ "$range" =~ ^([0-9]+)-([0-9]+)$ ]] || return 0
    a="${BASH_REMATCH[1]}"
    b="${BASH_REMATCH[2]}"
    if ! hy2_hop_has_firewall_tools; then
        log_error "Hop Port needs nftables (nft) or iptables on Kharej."
        return 1
    fi
    # Open UDP range in UFW when enabled
    if command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -qi 'Status: active'; then
        ufw_range="${a}:${b}/udp"
        if ! ufw status 2>/dev/null | grep -qE "${a}:${b}/udp|${a}:${b} .*UDP"; then
            ufw allow proto udp from any to any port "${a}:${b}" comment 'jojonet-hy2-hop' >/dev/null 2>&1 || \
                ufw allow "${a}:${b}/udp" >/dev/null 2>&1 || \
                log_warn "UFW active — open UDP ${a}-${b} manually: ufw allow ${a}:${b}/udp"
        fi
    fi
    # firewalld
    if command -v firewall-cmd >/dev/null 2>&1 && firewall-cmd --state 2>/dev/null | grep -qi running; then
        firewall-cmd --permanent --add-port="${a}-${b}/udp" >/dev/null 2>&1 || true
        firewall-cmd --reload >/dev/null 2>&1 || true
    fi
    return 0
}

hy2_first_port_busy() {
    local range="$1" first
    [[ "$range" =~ ^([0-9]+)- ]] || return 1
    first="${BASH_REMATCH[1]}"
    if command -v ss >/dev/null 2>&1; then
        ss -ulnH 2>/dev/null | awk -v p=":$first" '$4 ~ p"$" { found=1 } END { exit !found }'
        return $?
    fi
    return 1
}

validate_hy2_port_or_range() {
    local v="$1" a b
    v="${v//' '/}"
    if [[ "$v" =~ ^[0-9]+$ ]]; then
        (( v >= 1 && v <= 65535 )) || return 1
        return 0
    fi
    if [[ "$v" =~ ^([0-9]+)-([0-9]+)$ ]]; then
        a="${BASH_REMATCH[1]}"
        b="${BASH_REMATCH[2]}"
        (( a >= 1 && b <= 65535 && a < b )) || return 1
        return 0
    fi
    return 1
}

detect_cpu_arch_hy2() {
    case "$(uname -m)" in
        x86_64|amd64) echo "amd64" ;;
        aarch64|arm64) echo "arm64" ;;
        *) return 1 ;;
    esac
}

install_hysteria2_binary() {
    if [[ -x "$HY2_BIN" ]]; then
        return 0
    fi
    local arch tmpdir url fname
    arch=$(detect_cpu_arch_hy2) || { log_error "Unsupported CPU for Hysteria2"; return 1; }
    fname="hysteria-linux-${arch}"
    url="https://github.com/${HY2_REPO}/releases/download/${HY2_VERSION}/${fname}"
    tmpdir=$(mktemp -d /tmp/jojonet-hy2.XXXXXX) || return 1
    log_note "Downloading Hysteria2 ${HY2_VERSION} ($fname)..."
    if ! download_verified "$url" "$tmpdir/$fname" "$fname"; then
        rm -rf "$tmpdir"
        return 1
    fi
    install -m755 "$tmpdir/$fname" "$HY2_BIN"
    rm -rf "$tmpdir"
    log_info "hysteria installed: $HY2_BIN"
    return 0
}

# Pull a shared secret from the peer, or create it and push it. Prints the key dir.
ensure_shared_secret() {
    local pair_id="$1" peer_ip="$2" name="$3" label="$4"
    local keydir="$KEYS_ROOT/pair_${pair_id}"
    install -d -m700 "$keydir"
    if [[ ! -s "$keydir/$name" && -n "$peer_ip" ]]; then
        peer_pull_key "$peer_ip" "$name" "$keydir/$name" || true
    fi
    if [[ ! -s "$keydir/$name" ]]; then
        (umask 077 && openssl rand -hex 24 > "$keydir/$name")
        chmod 600 "$keydir/$name"
        if [[ -n "$peer_ip" ]]; then
            if ! peer_push_key "$peer_ip" "$keydir/$name" "$name"; then
                log_warn "$label secret not copied via SSH — sync manually:"
                hint "sudo jojonet --export-keys $peer_ip /root/jojonet-keys.tar.gz" >&2
                hint "On peer: sudo jojonet --import-keys <THIS_IP> /root/jojonet-keys.tar.gz" >&2
            fi
        else
            log_warn "New $label secret created. Peer must use the same one (export/import keys)."
        fi
    fi
    printf '%s' "$keydir"
}

ensure_hy2_auth() {
    ensure_shared_secret "$1" "${2:-}" hy2.auth "Hysteria2"
}

ensure_hy2_acme_firewall() {
    # ACME (HTTP-01 / TLS-ALPN-01) needs TCP 80 and 443 reachable on Kharej
    local p
    if command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -qi active; then
        for p in 80 443; do ufw allow "${p}/tcp" comment 'jojonet-hy2-acme' >/dev/null 2>&1 || true; done
    fi
    if command -v firewall-cmd >/dev/null 2>&1 && firewall-cmd --state 2>/dev/null | grep -qi running; then
        for p in 80 443; do firewall-cmd --permanent --add-port="${p}/tcp" >/dev/null 2>&1 || true; done
        firewall-cmd --reload >/dev/null 2>&1 || true
    fi
    return 0
}

build_hy2_runtime_config() {
    local name="$1" role="$2" rem="$3" port="$4" keydir="$5" ports="${6:-}" \
        sni="${7:-$DEFAULT_HY2_SNI}" hop_range="${8:-}" hop_interval="${9:-}"
    local auth yaml fwd_block="" p listen_addr server_addr hop_block=""
    local tls_mode domain email cert key server_tls_block="" client_tls_block=""
    install -d -m700 "$HY2_CONFIG_DIR"
    auth=$(tr -d '\n' < "$keydir/hy2.auth")
    yaml="$HY2_CONFIG_DIR/${name}.yaml"

    tls_mode="${HyTlsMode:-${JOJONET_HY2_TLS_MODE:-insecure}}"
    domain="${HyDomain:-${JOJONET_HY2_DOMAIN:-}}"
    email="${HyAcmeEmail:-${JOJONET_HY2_ACME_EMAIL:-}}"
    cert="${HyCertPath:-${JOJONET_HY2_CERT:-}}"
    key="${HyKeyPath:-${JOJONET_HY2_KEY:-}}"
    if [[ ( "$tls_mode" == "acme" || "$tls_mode" == "custom" ) && -n "$domain" ]]; then
        sni="$domain"
    fi
    case "$tls_mode" in
        acme)
            if [[ -z "$domain" ]]; then echo "[!] Hysteria2 ACME needs a domain (HyDomain)" >&2; return 1; fi
            server_tls_block=$'acme:\n  domains:\n    - '"${domain}"$'\n  email: '"${email:-admin@${domain}}"
            client_tls_block=$'tls:\n  sni: '"${sni}"$'\n  insecure: false'
            ;;
        custom)
            if [[ -z "$cert" || -z "$key" ]]; then echo "[!] Hysteria2 custom TLS needs HyCertPath + HyKeyPath" >&2; return 1; fi
            server_tls_block=$'tls:\n  cert: '"${cert}"$'\n  key: '"${key}"
            client_tls_block=$'tls:\n  sni: '"${sni}"$'\n  insecure: false'
            ;;
        *)
            # Self-signed: hysteria server REQUIRES tls or acme — generate a cert once per pair
            if [[ "$role" == "kharej" ]]; then
                if [[ ! -s "$keydir/hy2.crt" || ! -s "$keydir/hy2.key" ]]; then
                    if ! openssl req -x509 -nodes -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 \
                        -keyout "$keydir/hy2.key" -out "$keydir/hy2.crt" \
                        -subj "/CN=${sni}" -days 3650 >/dev/null 2>&1; then
                        echo "[!] Failed to generate self-signed cert for Hysteria2 (need openssl)" >&2
                        return 1
                    fi
                    chmod 600 "$keydir/hy2.key" "$keydir/hy2.crt"
                fi
                server_tls_block=$'tls:\n  cert: '"${keydir}/hy2.crt"$'\n  key: '"${keydir}/hy2.key"
            fi
            client_tls_block=$'tls:\n  sni: '"${sni}"$'\n  insecure: true'
            ;;
    esac

    # Prefer explicit hop range; else treat port as range if "N-M"
    hop_range="${hop_range//' '/}"
    port="${port//' '/}"
    if [[ -z "$hop_range" && "$port" =~ ^[0-9]+-[0-9]+$ ]]; then
        hop_range="$port"
    fi
    if [[ -n "$hop_range" ]]; then
        validate_hy2_port_or_range "$hop_range" || return 1
        listen_addr=":${hop_range}"
        server_addr="${rem}:${hop_range}"
        hop_interval=$(normalize_hy2_hop_interval "${hop_interval:-$DEFAULT_HY2_HOP_INTERVAL}")
        if [[ "$hop_interval" =~ ^([0-9]+)s-([0-9]+)s$ ]]; then
            hop_block="transport:
  udp:
    minHopInterval: ${BASH_REMATCH[1]}s
    maxHopInterval: ${BASH_REMATCH[2]}s"
        else
            hop_block="transport:
  udp:
    hopInterval: ${hop_interval}"
        fi
    else
        validate_hy2_port_or_range "$port" || return 1
        listen_addr=":${port}"
        server_addr="${rem}:${port}"
    fi

    if [[ "$role" == "kharej" ]]; then
        cat > "$yaml" <<EOF
# JojoNet Hysteria2 server${hop_range:+ (hop port ${hop_range})} [tls: ${tls_mode}]
listen: ${listen_addr}
${server_tls_block}
auth:
  type: password
  password: ${auth}
masquerade:
  type: proxy
  proxy:
    url: https://${sni}
    rewriteHost: true
bandwidth:
  up: 1 gbps
  down: 1 gbps
EOF
    else
        fwd_block=""
        if [[ -n "$ports" ]]; then
            fwd_block="tcpForwarding:"
            IFS=',' read -ra _plist <<< "$ports"
            for p in "${_plist[@]}"; do
                p="${p// /}"
                [[ -n "$p" ]] || continue
                if [[ "$p" =~ ^[0-9]+$ ]]; then
                    fwd_block="${fwd_block}
  - listen: 0.0.0.0:${p}
    remote: 127.0.0.1:${p}"
                fi
            done
            fwd_block="${fwd_block}
udpForwarding:"
            for p in "${_plist[@]}"; do
                p="${p// /}"
                [[ -n "$p" ]] || continue
                if [[ "$p" =~ ^[0-9]+$ ]]; then
                    fwd_block="${fwd_block}
  - listen: 0.0.0.0:${p}
    remote: 127.0.0.1:${p}"
                fi
            done
        fi
        cat > "$yaml" <<EOF
# JojoNet Hysteria2 client (Iran)${hop_range:+ (hop port ${hop_range} / ${hop_interval})}
server: ${server_addr}
auth: ${auth}
bandwidth:
  up: 1 gbps
  down: 1 gbps
${client_tls_block}
${hop_block}
${fwd_block}
EOF
    fi
    chmod 600 "$yaml"
    echo "$yaml"
}

create_hy2_runner_script() {
    if ! cat << 'EOF' > "$HY2_RUNNER"
#!/usr/bin/env bash
set -Eeuo pipefail

_JOJONET_CONF_KEYS="Name TunnelMode Role Local_IP Remote_IP Subnet_Byte Tun_IP Tun_Remote_IP_Raw Tun_Server_IP Tun_Client_IP Suggested_MTU Ports TcpPort KeyDir GreKey PaqetYaml ForwardProto VxlanVni VxlanPort WgPrivateKey WgPublicKey WgPeerPublicKey HyYaml HyAuth HySni HyHopRange HyHopInterval HyTlsMode HyDomain HyAcmeEmail HyCertPath HyKeyPath RatholeToml WstunnelCmd WgObfs ObfsPort V6Iface V6Local V6Remote XrayJson XrayNet"

load_safe_config() {
    local file="$1" line key val
    Name="" TunnelMode="gre" Role="" Local_IP="" Remote_IP="" Subnet_Byte=""
    Tun_IP="" Tun_Remote_IP_Raw="" Tun_Server_IP="" Tun_Client_IP=""
    Suggested_MTU="" Ports="" TcpPort="" KeyDir="" GreKey=""
    PaqetYaml="" ForwardProto="" VxlanVni="" VxlanPort=""
    WgPrivateKey="" WgPublicKey="" WgPeerPublicKey="" HyYaml="" HyAuth="" HySni="" HyHopRange="" HyHopInterval="" HyTlsMode="" HyDomain="" HyAcmeEmail="" HyCertPath="" HyKeyPath="" RatholeToml="" WstunnelCmd="" WgObfs="" ObfsPort="" V6Iface="" V6Local="" V6Remote="" XrayJson="" XrayNet=""
    [[ -r "$file" ]] || return 1
    while IFS= read -r line || [[ -n "$line" ]]; do
        line="${line%%#*}"
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"
        [[ -z "$line" ]] && continue
        [[ "$line" =~ ^([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]] || return 1
        key="${BASH_REMATCH[1]}"
        val="${BASH_REMATCH[2]}"
        case " ${_JOJONET_CONF_KEYS} " in *" $key "*) ;; *) return 1 ;; esac
        if [[ "$val" =~ ^\"(.*)\"$ ]]; then val="${BASH_REMATCH[1]}"
        elif [[ "$val" =~ ^\'(.*)\'$ ]]; then val="${BASH_REMATCH[1]}"; fi
        case "$val" in *'$('*|*'`'*|*';'*|*'|'*|*'&'*|*$'\n'*|*$'\r'*) return 1 ;; esac
        printf -v "$key" '%s' "$val"
    done < "$file"
    [[ -n "${Name:-}" ]] || return 1
    return 0
}

ACTION="${1:-}"
CONFIG_FILE="${2:-}"
HY2_BIN="/usr/local/bin/hysteria"

[[ -n "$CONFIG_FILE" && -f "$CONFIG_FILE" ]] || { echo "Config missing" >&2; exit 1; }
load_safe_config "$CONFIG_FILE" || { echo "Bad config" >&2; exit 1; }
yaml="${HyYaml:-}"

stop_hy2() {
    pkill -f "hysteria (server|client) -c ${yaml}" >/dev/null 2>&1 || true
    pkill -f "hysteria.*-c ${yaml}" >/dev/null 2>&1 || true
}

case "$ACTION" in
    start)
        stop_hy2
        [[ -x "$HY2_BIN" ]] || { echo "hysteria binary missing" >&2; exit 1; }
        [[ -f "$yaml" ]] || { echo "yaml missing: $yaml" >&2; exit 1; }
        # Hop Port (Linux): server needs nft or iptables for UDP range redirect
        if [[ "$Role" == "kharej" ]]; then
            _hop="${HyHopRange:-}"
            [[ -z "$_hop" && "${TcpPort:-}" =~ ^[0-9]+-[0-9]+$ ]] && _hop="$TcpPort"
            if [[ -n "$_hop" && "$_hop" =~ - ]]; then
                if ! command -v nft >/dev/null 2>&1 && ! command -v iptables >/dev/null 2>&1; then
                    echo "ERROR: Hop Port requires nftables (nft) or iptables" >&2
                    exit 1
                fi
                echo "[jojonet-hy2:${Name}] Hop Port enabled: $_hop"
            fi
        fi
        if [[ "$Role" == "kharej" ]]; then
            exec "$HY2_BIN" server -c "$yaml"
        else
            exec "$HY2_BIN" client -c "$yaml"
        fi
        ;;
    stop)
        stop_hy2
        exit 0
        ;;
    *)
        echo "Invalid action" >&2
        exit 1
        ;;
esac
EOF
    then
        return 1
    fi
    chmod +x "$HY2_RUNNER"
}

create_hy2_service() {
    local tmp_file
    tmp_file=$(mktemp /tmp/jojonet_hy2_svc.XXXXXX) || return 1
    if ! cat << 'EOF' > "$tmp_file"
[Unit]
Description=JojoNet Hysteria2 Tunnel: %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Restart=always
RestartSec=5
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal
SyslogIdentifier=jojonet-hy2-%i
ExecStart=/usr/local/bin/jojonet-run-hy2.sh start /etc/jojonet/instances/%i.conf
ExecStop=/usr/local/bin/jojonet-run-hy2.sh stop /etc/jojonet/instances/%i.conf
TimeoutStartSec=90
TimeoutStopSec=30
KillMode=mixed

[Install]
WantedBy=multi-user.target
EOF
    then
        rm -f "$tmp_file"
        return 1
    fi
    if [[ -f "$HY2_SERVICE" ]] && cmp -s "$tmp_file" "$HY2_SERVICE"; then
        rm -f "$tmp_file"
    else
        mv -f "$tmp_file" "$HY2_SERVICE" || { rm -f "$tmp_file"; return 1; }
        systemctl daemon-reload || return 1
    fi
}

quick_add_tunnel_hy2() {
    local peer_ip="${1:-}"
    local peer_from_cli=0 use_auto=0
    [[ -n "$peer_ip" ]] && peer_from_cli=1
    local ins_name="" role_conf="" loc_ip="" rem_ip=""
    local fwd_port="" key_dir="" hy_port="$DEFAULT_HY2_PORT" sni="$DEFAULT_HY2_SNI"
    local existing="" hy_yaml="" hop_enable="y"
    local hop_range="${JOJONET_HY2_HOP_RANGE:-$DEFAULT_HY2_HOP_RANGE}"
    local hop_interval="${JOJONET_HY2_HOP_INTERVAL:-$DEFAULT_HY2_HOP_INTERVAL}"
    local hop_style="1" span=0

    set +e
    clear_screen
    logo
    print_banner "Hysteria2 Tunnel (high speed / filtered paths)"

    install_hysteria2_binary || { sleep 2; set -e; return 1; }
    install -d -m700 "$HY2_CONFIG_DIR"

    if ! auto_detect_network; then
        echo -e "${RED}[!] Cannot detect network.${NC}"
        sleep 2; set -e; return 1
    fi
    loc_ip="$DETECTED_IP"
    show_existing_tunnels_summary

    if [[ -z "$peer_ip" ]]; then
        read -r -p "Peer server IP: " peer_ip
    fi
    peer_ip="${peer_ip// /}"
    if ! validate_ipv4 "$peer_ip"; then
        echo -e "${RED}[!] Invalid peer IP.${NC}"
        sleep 2; set -e; return 1
    fi
    rem_ip="$peer_ip"

    if existing=$(find_tunnel_for_peer "$rem_ip" "hysteria2"); then
        echo -e "${YELLOW}[!] Hysteria2 to $rem_ip exists [$existing]. Restarting...${NC}"
        local _rrc=0
        restart_tunnel "$existing" || _rrc=$?
        sleep 2; set -e; return "$_rrc"
    fi

    if ! role_conf=$(resolve_server_role "$loc_ip"); then
        echo -e "${RED}[!] Role required.${NC}"
        sleep 2; set -e; return 1
    fi
    echo -e "${GREEN}[*] Role:${NC} $role_conf"


    if jojonet_use_auto_defaults "$peer_from_cli"; then
        use_auto=1
    fi

    ins_name=$(allocate_tunnel_name "$rem_ip" "$role_conf" "hysteria2") || { set -e; return 1; }

    local hy_tls_mode="insecure" hy_domain="" hy_acme_email="" hy_cert_path="" hy_key_path=""

    if (( use_auto )); then
        hop_enable="y"
        hop_range="${JOJONET_HY2_HOP_RANGE:-$DEFAULT_HY2_HOP_RANGE}"
        hop_range="${hop_range//' '/}"
        if ! validate_hy2_port_or_range "$hop_range" || [[ ! "$hop_range" =~ - ]]; then
            echo -e "${YELLOW}[!] Invalid JOJONET_HY2_HOP_RANGE='${hop_range}' — using ${DEFAULT_HY2_HOP_RANGE}${NC}"
            hop_range="$DEFAULT_HY2_HOP_RANGE"
        fi
        hop_interval=$(normalize_hy2_hop_interval "${JOJONET_HY2_HOP_INTERVAL:-$DEFAULT_HY2_HOP_INTERVAL}")
        if [[ "$role_conf" == "kharej" ]] && ! hy2_hop_has_firewall_tools; then
            echo -e "${RED}[!] Hop Port requires nftables (nft) or iptables on Kharej.${NC}"
            echo -e "${YELLOW}    Install: apt install iptables  OR  apt install nftables${NC}"
            sleep 3
            set -e
            return 1
        fi
        hy_port="$hop_range"
        if [[ "$role_conf" == "iran" ]]; then
            fwd_port=$(allocate_iran_forward_port "443")
        else
            fwd_port=""
        fi
        sni="${JOJONET_HY2_SNI:-$DEFAULT_HY2_SNI}"
        if [[ -n "${JOJONET_HY2_DOMAIN:-}" ]]; then
            hy_domain="$JOJONET_HY2_DOMAIN"
            hy_tls_mode="${JOJONET_HY2_TLS_MODE:-acme}"
            hy_acme_email="${JOJONET_HY2_ACME_EMAIL:-admin@${hy_domain}}"
            hy_cert_path="${JOJONET_HY2_CERT:-}"
            hy_key_path="${JOJONET_HY2_KEY:-}"
            sni="$hy_domain"
            [[ "$hy_tls_mode" == "custom" ]] || hy_tls_mode="acme"
        else
            hy_tls_mode="${JOJONET_HY2_TLS_MODE:-insecure}"
            hy_domain="${JOJONET_HY2_DOMAIN:-}"
            hy_acme_email="${JOJONET_HY2_ACME_EMAIL:-}"
            hy_cert_path="${JOJONET_HY2_CERT:-}"
            hy_key_path="${JOJONET_HY2_KEY:-}"
            [[ "$hy_tls_mode" == "acme" || "$hy_tls_mode" == "custom" ]] || hy_tls_mode="insecure"
        fi
        echo -e "  ${CYAN}Hop:${NC}  ON  $hop_range every $hop_interval (auto)"
        echo -e "  ${CYAN}TLS:${NC}  $hy_tls_mode${hy_domain:+ ($hy_domain)}  SNI=$sni (auto)"
        [[ -n "$fwd_port" ]] && echo -e "  ${CYAN}Fwd:${NC}  $fwd_port (auto)"
    else
        echo ""
        echo -e "${CYAN}Hop Port${NC} — UDP range hopping (ضد محدودیت پورت UDP)"
        echo -e "  Kharej: listen on full range (needs nft/iptables)"
        echo -e "  Iran:   rotates UDP port every N seconds (transparent to traffic)"
        if [[ -n "${JOJONET_HY2_HOP_RANGE:-}" ]]; then
            hop_enable="y"
            echo -e "  ${YELLOW}Env JOJONET_HY2_HOP_RANGE=${JOJONET_HY2_HOP_RANGE}${NC}"
        else
            read -r -p "Enable Hop Port? [Y/n]: " hop_enable
            hop_enable=$(printf '%s' "${hop_enable:-y}" | tr '[:upper:]' '[:lower:]')
        fi

        if [[ "$hop_enable" == "n" || "$hop_enable" == "no" ]]; then
            hop_range=""
            hop_interval=""
            if [[ "$role_conf" == "kharej" ]]; then
                read -r -p "Listen UDP port [$hy_port]: " _hp
                hy_port=${_hp:-$hy_port}
                fwd_port=""
            else
                fwd_port=$(allocate_iran_forward_port "443")
                read -r -p "Server UDP port [$hy_port]: " _hp
                hy_port=${_hp:-$hy_port}
                read -r -p "Forward ports on Iran [$fwd_port]: " _fp
                fwd_port=${_fp:-$fwd_port}
            fi
            if ! validate_hy2_port_or_range "$hy_port"; then
                echo -e "${RED}[!] Invalid UDP port.${NC}"
                sleep 2; set -e; return 1
            fi
        else
            if [[ "$role_conf" == "kharej" ]] && ! hy2_hop_has_firewall_tools; then
                echo -e "${RED}[!] Hop Port requires nftables (nft) or iptables on Kharej.${NC}"
                echo -e "${YELLOW}    Install: apt install iptables  OR  apt install nftables${NC}"
                sleep 3
                set -e
                return 1
            fi
            read -r -p "Hop port range [$hop_range]: " _hr
            hop_range=${_hr:-$hop_range}
            hop_range="${hop_range//' '/}"
            if ! validate_hy2_port_or_range "$hop_range" || [[ ! "$hop_range" =~ - ]]; then
                echo -e "${RED}[!] Invalid range. Example: 20000-50000${NC}"
                sleep 2; set -e; return 1
            fi
            span=$(hy2_hop_span "$hop_range")
            if (( span > 15000 )); then
                echo -e "${YELLOW}[!] Wide range (${span} ports). Prefer e.g. 20000-30000 for lighter DNAT.${NC}"
            fi
            echo -e "  Hop timing: 1) fixed interval  2) random interval (harder to detect)"
            read -r -p "Choose [1/2] (default 1): " hop_style
            if [[ "${hop_style:-1}" == "2" ]]; then
                hop_interval="15s-45s"
                read -r -p "Random hop min-max [${hop_interval}]: " _hi
                hop_interval=$(normalize_hy2_hop_interval "${_hi:-$hop_interval}")
            else
                read -r -p "Hop interval [${hop_interval}] (min 5s): " _hi
                hop_interval=$(normalize_hy2_hop_interval "${_hi:-$hop_interval}")
            fi
            hy_port="$hop_range"
            if [[ "$role_conf" == "iran" ]]; then
                fwd_port=$(allocate_iran_forward_port "443")
                read -r -p "Forward ports on Iran [$fwd_port]: " _fp
                fwd_port=${_fp:-$fwd_port}
            else
                fwd_port=""
            fi
        fi

        read -r -p "TLS SNI [$sni]: " _sni
        sni=${_sni:-$sni}

        echo ""
        echo -e "${CYAN}TLS mode${NC} — نوع گواهی TLS"
        echo -e "  1) Self-signed (بدون دامنه، insecure) — پیش‌فرض"
        echo -e "  2) ACME / Let's Encrypt (دامنه شخصی، گواهی خودکار)"
        echo -e "  3) Custom cert (فایل cert.pem + key.pem)"
        read -r -p "Choose [1/2/3] (default 1): " _tm
        case "${_tm:-1}" in
            2)
                hy_tls_mode="acme"
                read -r -p "Domain (رکورد A → IP سرور خارج): " hy_domain
                hy_domain="${hy_domain// /}"
                if [[ -z "$hy_domain" ]]; then echo -e "${RED}[!] Domain لازم است.${NC}"; sleep 2; set -e; return 1; fi
                read -r -p "ACME email [admin@${hy_domain}]: " hy_acme_email
                hy_acme_email="${hy_acme_email:-admin@${hy_domain}}"
                sni="$hy_domain"
                [[ "$role_conf" == "kharej" ]] && hint "پورت TCP 80 و 443 روی خارج باید برای صدور گواهی باز باشد"
                ;;
            3)
                hy_tls_mode="custom"
                read -r -p "Path to cert.pem: " hy_cert_path
                read -r -p "Path to key.pem: " hy_key_path
                if [[ "$role_conf" == "kharej" ]] && { [[ ! -f "$hy_cert_path" ]] || [[ ! -f "$hy_key_path" ]]; }; then
                    echo -e "${RED}[!] cert/key روی این سرور پیدا نشد.${NC}"; sleep 2; set -e; return 1
                fi
                read -r -p "Domain/SNI [$sni]: " _d
                hy_domain="${_d:-$sni}"
                sni="$hy_domain"
                ;;
            *)
                hy_tls_mode="insecure"
                ;;
        esac
    fi

    local pair_id
    pair_id=$(printf '%s' "$rem_ip" | tr '.' '_')
    key_dir=$(ensure_hy2_auth "$pair_id" "$rem_ip") || { set -e; return 1; }
    export HySni="$sni"
    export JOJONET_HY2_SNI="$sni"
    export HyHopRange="$hop_range"
    export HyHopInterval="$hop_interval"
    export HyTlsMode="$hy_tls_mode"
    export HyDomain="$hy_domain"
    export HyAcmeEmail="$hy_acme_email"
    export HyCertPath="$hy_cert_path"
    export HyKeyPath="$hy_key_path"

    echo -e "\n${CYAN}--- Hysteria2 plan ---${NC}"
    echo -e "  Name:  $ins_name"
    echo -e "  Role:  $role_conf"
    echo -e "  Peer:  $rem_ip"
    if [[ -n "$hop_range" ]]; then
        echo -e "  Hop:   ${GREEN}ON${NC}  range ${hop_range}  every ${hop_interval}"
        [[ "$role_conf" == "kharej" ]] && echo -e "  Note:  server listens on first port + DNAT for the rest"
    else
        echo -e "  Port:  UDP $hy_port (fixed)"
    fi
    echo -e "  SNI:   $sni"
    echo -e "  TLS:   $hy_tls_mode${hy_domain:+  (domain $hy_domain)}"
    [[ -n "$fwd_port" ]] && echo -e "  Fwd:   $fwd_port (via tunnel to foreign localhost)"
    echo ""

    if deploy_tunnel "$ins_name" "$role_conf" "$loc_ip" "$rem_ip" "0" \
        "" "" "1350" "$fwd_port" "hysteria2" "$hy_port" "$key_dir" \
        "" "" "tcp"; then
        if [[ -f "$INSTANCES_DIR/$ins_name.conf" ]]; then
            grep -q '^HySni=' "$INSTANCES_DIR/$ins_name.conf" || \
                echo "HySni=\"$sni\"" >> "$INSTANCES_DIR/$ins_name.conf"
            if [[ -n "$hop_range" ]]; then
                if grep -q '^HyHopRange=' "$INSTANCES_DIR/$ins_name.conf"; then
                    sed -i "s|^HyHopRange=.*|HyHopRange=\"$hop_range\"|" "$INSTANCES_DIR/$ins_name.conf"
                else
                    echo "HyHopRange=\"$hop_range\"" >> "$INSTANCES_DIR/$ins_name.conf"
                fi
                if grep -q '^HyHopInterval=' "$INSTANCES_DIR/$ins_name.conf"; then
                    sed -i "s|^HyHopInterval=.*|HyHopInterval=\"$hop_interval\"|" "$INSTANCES_DIR/$ins_name.conf"
                else
                    echo "HyHopInterval=\"$hop_interval\"" >> "$INSTANCES_DIR/$ins_name.conf"
                fi
            fi
        fi
        echo -e "${GREEN}[+] Hysteria2 [$ins_name] is up.${NC}"
        if [[ -n "$hop_range" ]]; then
            hint "Peer MUST use the SAME hop range: $hop_range (interval $hop_interval)"
