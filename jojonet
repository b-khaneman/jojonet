# WireGuard helpers
# ==========================================

WG_RUNNER="/usr/local/bin/jojonet-run-wg.sh"
WG_SERVICE="/etc/systemd/system/jojonet-wg@.service"
WG_NET_PREFIX="10.66"
DEFAULT_WG_PORT=51820
DEFAULT_WG_MTU=1280

# WireGuard carried inside udp2raw (ICMP echo or fake TCP) — TunnelMode stays "wireguard", WgObfs selects it.
U2R_VERSION="20230206.0"
U2R_TARBALL_SHA256="503cf5781aa97e50b4954c6bc4622c3ea6be02f6a35def4bb3b3eaf95bd2c7e8"
U2R_BIN="/usr/local/bin/udp2raw"
U2R_RUNNER="/usr/local/bin/jojonet-run-u2r.sh"
U2R_SERVICE="/etc/systemd/system/jojonet-u2r@.service"
WG_ICMP_NET_PREFIX="10.67"
WG_FAKETCP_NET_PREFIX="10.68"
DEFAULT_WG_OBFS_MTU=1200
DEFAULT_WG_OBFS_PORT_BASE=4096
WG_OBFS=""
WG_OBFS_PORT=""

install_wireguard_tools() {
    if command -v wg >/dev/null 2>&1; then
        return 0
    fi
    log_note "Installing wireguard-tools..."
    jojonet_pkg_install wireguard-tools wireguard || jojonet_pkg_install wireguard-tools || true
    command -v wg >/dev/null 2>&1 || {
        log_error "wireguard-tools (wg) not available. Install: apt install wireguard-tools"
        return 1
    }
    # wg-quick is optional; we use ip/wg directly
    modprobe wireguard 2>/dev/null || true
    return 0
}

ensure_wg_keys() {
    local pair_id="$1" peer_ip="${2:-}" role="${3:-}"
    local keydir="$KEYS_ROOT/pair_${pair_id}"
    install -d -m700 "$keydir"
    # Each side has its OWN keypair; peer public is the other side's public key
    if [[ ! -f "$keydir/wg_private.key" ]]; then
        umask 077
        wg genkey | tee "$keydir/wg_private.key" | wg pubkey > "$keydir/wg_public.key"
        chmod 600 "$keydir/wg_private.key" "$keydir/wg_public.key"
        log_info "Generated local WireGuard keypair in $keydir"
    fi
    # A placeholder copy of our own public key is never a valid peer key
    if [[ -f "$keydir/wg_peer_public.key" ]] && cmp -s "$keydir/wg_peer_public.key" "$keydir/wg_public.key"; then
        rm -f "$keydir/wg_peer_public.key"
    fi
    if [[ -n "$peer_ip" ]]; then
        peer_push_key "$peer_ip" "$keydir/wg_public.key" wg_peer_public.key || true
        peer_pull_key "$peer_ip" wg_public.key "$keydir/wg_peer_public.key" || true
    fi
    if [[ ! -f "$keydir/wg_peer_public.key" ]]; then
        log_warn "Peer WireGuard public key missing."
        log_warn "Run the same --wg${WG_OBFS:+-$WG_OBFS} command on the other server, or copy keys:"
        log_warn "  sudo jojonet --export-keys $peer_ip"
        if [[ "$role" == "kharej" ]]; then
            log_warn "Kharej will start listen-only until Iran side runs --wg${WG_OBFS:+-$WG_OBFS}."
        else
            log_warn "Temporary: using local public (will NOT handshake until peer key is set)."
            cp -f "$keydir/wg_public.key" "$keydir/wg_peer_public.key"
        fi
    fi
    chmod 600 "$keydir/wg_private.key" "$keydir/wg_public.key" "$keydir/wg_peer_public.key" 2>/dev/null || true
    printf '%s' "$keydir"
}

create_wg_runner_script() {
    if ! cat << 'EOF' > "$WG_RUNNER"
#!/usr/bin/env bash
set -Eeuo pipefail

# Safe config loader — whitelist keys only (never source shell)
_JOJONET_CONF_KEYS="Name TunnelMode Role Local_IP Remote_IP Subnet_Byte Tun_IP Tun_Remote_IP_Raw Tun_Server_IP Tun_Client_IP Suggested_MTU Ports TcpPort KeyDir GreKey PaqetYaml ForwardProto VxlanVni VxlanPort WgPrivateKey WgPublicKey WgPeerPublicKey HyYaml HyAuth HySni HyHopRange HyHopInterval HyTlsMode HyDomain HyAcmeEmail HyCertPath HyKeyPath RatholeToml WstunnelCmd WgObfs ObfsPort V6Iface V6Local V6Remote XrayJson XrayNet DnsDomain DnsResolver DnsMode"

load_safe_config() {
    local file="$1" line key val
    Name="" TunnelMode="gre" Role="" Local_IP="" Remote_IP="" Subnet_Byte=""
    Tun_IP="" Tun_Remote_IP_Raw="" Tun_Server_IP="" Tun_Client_IP=""
    Suggested_MTU="" Ports="" TcpPort="" KeyDir="" GreKey=""
    PaqetYaml="" ForwardProto="" VxlanVni="" VxlanPort=""
    WgPrivateKey="" WgPublicKey="" WgPeerPublicKey="" HyYaml="" HyAuth="" HySni="" HyHopRange="" HyHopInterval="" HyTlsMode="" HyDomain="" HyAcmeEmail="" HyCertPath="" HyKeyPath="" RatholeToml="" WstunnelCmd="" WgObfs="" ObfsPort="" V6Iface="" V6Local="" V6Remote="" XrayJson="" XrayNet="" DnsDomain="" DnsResolver="" DnsMode=""
    [[ -r "$file" ]] || return 1
    while IFS= read -r line || [[ -n "$line" ]]; do
        line="${line%%#*}"
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"
        [[ -z "$line" ]] && continue
        [[ "$line" =~ ^([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]] || return 1
        key="${BASH_REMATCH[1]}"
        val="${BASH_REMATCH[2]}"
        case " ${_JOJONET_CONF_KEYS} " in
            *" $key "*) ;;
            *) return 1 ;;
        esac
        if [[ "$val" =~ ^\"(.*)\"$ ]]; then val="${BASH_REMATCH[1]}"
        elif [[ "$val" =~ ^\'(.*)\'$ ]]; then val="${BASH_REMATCH[1]}"; fi
        case "$val" in
            *'$('*|*'`'*|*';'*|*'|'*|*'&'*|*$'\n'*|*$'\r'*) return 1 ;;
        esac
        printf -v "$key" '%s' "$val"
    done < "$file"
    [[ -n "${Name:-}" ]] || return 1
    TunnelMode=${TunnelMode:-gre}
    return 0
}

ACTION="${1:-}"
CONFIG_FILE="${2:-}"
DEFAULT_WG_MTU=1280

if [[ -z "$CONFIG_FILE" || ! -f "$CONFIG_FILE" ]]; then
    echo "Config missing" >&2
    exit 1
fi
if ! load_safe_config "$CONFIG_FILE"; then
    echo "Invalid or unsafe config: $CONFIG_FILE" >&2
    exit 1
fi

table_name="jojonet_$Name"
priv="${WgPrivateKey:-${KeyDir}/wg_private.key}"
peer_pub="${WgPeerPublicKey:-${KeyDir}/wg_peer_public.key}"
# AppArmor 'wg' on Ubuntu 24+/26 may only read keys under /etc/wireguard/
wg_priv_run="/etc/wireguard/jojonet-${Name}.key"
listen_port="${TcpPort:-51820}"
mtu="${Suggested_MTU:-$DEFAULT_WG_MTU}"
endpoint="${Remote_IP}:${listen_port}"
if [[ -n "${WgObfs:-}" ]]; then
    [[ "${ObfsPort:-}" =~ ^[0-9]{1,5}$ ]] || { echo "ObfsPort missing for WgObfs=$WgObfs" >&2; exit 1; }
    # Iran sends WireGuard to the local udp2raw client, which carries it to Kharej.
    endpoint="127.0.0.1:${ObfsPort}"
fi

cleanup() {
    trap - ERR
    ip link delete "$Name" >/dev/null 2>&1 || true
    nft delete table ip "$table_name" >/dev/null 2>&1 || true
    rm -f "/etc/wireguard/jojonet-${Name}.key"
}

case "$ACTION" in
    start)
        trap cleanup ERR
        log() { echo "[jojonet-wg:${Name}] $*"; }
        command -v wg >/dev/null 2>&1 || { log "ERROR: wg missing"; exit 1; }
        [[ -f "$priv" ]] || { log "ERROR: private key missing: $priv"; exit 1; }
        if [[ ! -f "$peer_pub" && "$Role" != "kharej" ]]; then
            log "ERROR: peer public key missing: $peer_pub"
            exit 1
        fi
        modprobe wireguard 2>/dev/null || true
        if ip link show "$Name" >/dev/null 2>&1; then
            ip link delete "$Name" || true
        fi
        # Drop stale iface holding the same overlay IP (failed prior attempt)
        _busy=$(ip -o -4 addr show 2>/dev/null | awk -v ip="${Tun_IP%%/*}" '$4 ~ "^" ip "(/|$)" { print $2; exit }')
        if [[ -n "$_busy" && "$_busy" != "$Name" ]]; then
            log "Removing stale interface $_busy (overlay IP ${Tun_IP%%/*} busy)"
            ip link delete "$_busy" >/dev/null 2>&1 || true
        fi
        if [[ "$Role" == "kharej" ]]; then
            _lp=""
            for _wi in $(wg show interfaces 2>/dev/null); do
                [[ "$_wi" == "$Name" ]] && continue
                _lp=$(wg show "$_wi" listen-port 2>/dev/null || true)
                if [[ -n "$_lp" && "$_lp" == "$listen_port" ]]; then
                    log "ERROR: UDP $listen_port already used by WireGuard interface $_wi"
                    log "ERROR: pick another port or: ip link delete $_wi"
                    exit 1
                fi
            done
        fi
        # Restrict AllowedIPs to tunnel overlay (backhaul), not full tunnel
        allow="${Tun_Server_IP}/32,${Tun_Client_IP}/32"
        [[ -n "$Tun_Server_IP" && -n "$Tun_Client_IP" ]] || allow="10.66.0.0/16"
        ip link add dev "$Name" type wireguard || { log "ERROR: create wg iface"; exit 1; }
        install -d -m700 /etc/wireguard
        install -m600 "$priv" "$wg_priv_run" || { log "ERROR: cannot stage private key for AppArmor wg"; exit 1; }
        priv="$wg_priv_run"
        if [[ "$Role" == "kharej" ]]; then
            _own_pub=$(wg pubkey < "$priv" 2>/dev/null || true)
            _peer_key=""
            [[ -f "$peer_pub" ]] && _peer_key=$(tr -d '[:space:]' < "$peer_pub" 2>/dev/null || true)
            if [[ -n "$_peer_key" && "$_peer_key" != "$_own_pub" ]]; then
                wg set "$Name" private-key "$priv" listen-port "$listen_port" \
                    peer "$_peer_key" allowed-ips "$allow" \
                    || { log "ERROR: wg set failed (server)"; exit 1; }
            else
                log "WARN: peer key not ready — listen-only until Iran runs --wg"
                wg set "$Name" private-key "$priv" listen-port "$listen_port" \
                    || { log "ERROR: wg set failed (server, listen-only)"; exit 1; }
            fi
        else
            wg set "$Name" private-key "$priv" \
                peer "$(tr -d '[:space:]' < "$peer_pub")" allowed-ips "$allow" \
                endpoint "$endpoint" persistent-keepalive 25 \
                || { log "ERROR: wg set failed (client)"; exit 1; }
        fi
        ip addr flush dev "$Name" >/dev/null 2>&1 || true
        ip addr add "$Tun_IP" dev "$Name" || { log "ERROR: IP assign"; exit 1; }
        ip link set "$Name" mtu "$mtu"
        ip link set "$Name" up || { log "ERROR: up failed"; exit 1; }
        DEFAULT_IFACE=$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{for (i = 1; i < NF; i++) if ($i == "dev") { print $(i + 1); exit }}')
        log "sysctl: ip_forward=1, rp_filter=0 on $Name${DEFAULT_IFACE:+ and $DEFAULT_IFACE}"
        sysctl -w net.ipv4.ip_forward=1 >/dev/null 2>&1 || true
        sysctl -w "net.ipv4.conf.${Name}.rp_filter=0" >/dev/null 2>&1 || true
        [[ -n "$DEFAULT_IFACE" ]] && sysctl -w "net.ipv4.conf.${DEFAULT_IFACE}.rp_filter=0" >/dev/null 2>&1 || true
        sysctl -w net.ipv4.conf.all.rp_filter=0 >/dev/null 2>&1 || true
        sysctl -w net.ipv4.conf.default.rp_filter=0 >/dev/null 2>&1 || true
        if [[ "$Role" == "iran" ]]; then
            [[ -n "$DEFAULT_IFACE" ]] || { log "ERROR: default iface"; exit 1; }
            [[ -n "$Tun_Remote_IP_Raw" ]] || { log "ERROR: remote tun IP"; exit 1; }
            NFT_CONF="table ip $table_name {
            chain prerouting {
                type nat hook prerouting priority dstnat; policy accept;"
            if [[ -n "$Ports" ]]; then
                IFS=',' read -ra PORT_LIST <<< "$Ports"
                for p in "${PORT_LIST[@]}"; do
                    p="${p// /}"
                    [[ -n "$p" ]] || continue
                    if [[ "$p" =~ ^([0-9]{1,5})-([0-9]{1,5})$ ]]; then
                        NFT_CONF="$NFT_CONF
                tcp dport ${BASH_REMATCH[1]}-${BASH_REMATCH[2]} dnat ip to $Tun_Remote_IP_Raw
                udp dport ${BASH_REMATCH[1]}-${BASH_REMATCH[2]} dnat ip to $Tun_Remote_IP_Raw"
                    else
                        NFT_CONF="$NFT_CONF
                tcp dport $p dnat ip to $Tun_Remote_IP_Raw
                udp dport $p dnat ip to $Tun_Remote_IP_Raw"
                    fi
                done
            fi
            NFT_CONF="$NFT_CONF
            }
            chain postrouting {
                type nat hook postrouting priority srcnat; policy accept;
                oifname \"$DEFAULT_IFACE\" masquerade
            }
        }"
            nft delete table ip "$table_name" >/dev/null 2>&1 || true
            echo "$NFT_CONF" | nft -f - || { log "ERROR: nft failed"; exit 1; }
        fi
        log "SUCCESS: WireGuard $Name UP ($Tun_IP)"
        ;;
    stop)
        cleanup
        exit 0
        ;;
    *)
        echo "Invalid action" >&2
        exit 1
        ;;
esac
EOF
    then
        return 1
    fi
    chmod +x "$WG_RUNNER"
}

