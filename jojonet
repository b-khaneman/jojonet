opsec_scrub_history() {
    if [[ "${JOJONET_CLEAR_HISTORY:-1}" == "0" ]]; then
        return 0
    fi
    local f
    for f in "/root/.bash_history" "$HOME/.bash_history"; do
        [[ -n "$f" && -f "$f" && -w "$f" ]] || continue
        sed -i \
            -e '/jojonet/d' \
            -e '/jojonet-panel/d' \
            -e '/\/etc\/jojonet/d' \
            -e '/\/var\/lib\/jojonet/d' \
            -e '/ip tunnel/d' \
            -e '/tun-server/d' \
            -e '/tun-client/d' \
            -e '/nft.*jojonet/d' \
            -e '/GRETun/d' \
            -e '/LocalTun/d' \
            -e '/jojonet-run/d' \
            -e '/paqet/d' \
            -e '/vxlan/d' \
            -e '/udp2raw/d' \
            -e '/hysteria/d' \
            -e '/rathole/d' \
            -e '/wstunnel/d' \
            -e '/dnstt/d' \
            -e '/pingtunnel/d' \
            -e '/wireguard/d' \
            -e '/\<wg\>/d' \
            -e '/xray/d' \
            -e '/dokodemo/d' \
            -e '/spoof/d' \
            -e '/6to4/d' \
            -e '/gre6/d' \
            -e '/ipip6/d' \
            "$f" 2>/dev/null || true
    done
    history -c 2>/dev/null || true
    history -w 2>/dev/null || true
}

toggle_stealth_mode() {
    if [[ -f "$STEALTH_FLAG_FILE" ]]; then
