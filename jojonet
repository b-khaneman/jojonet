install_udp2raw_binary() {
    local member tmpdir actual
    if [[ -x "$U2R_BIN" ]]; then
        return 0
    fi
    case "$(uname -m)" in
        x86_64|amd64) member="udp2raw_amd64" ;;
        aarch64|arm64|armv7l|armv6l) member="udp2raw_arm" ;;
        i386|i686) member="udp2raw_x86" ;;
        *) log_error "udp2raw: unsupported CPU $(uname -m)"; return 1 ;;
    esac
    tmpdir=$(mktemp -d /tmp/jojonet-u2r.XXXXXX) || return 1
    log_note "Downloading udp2raw ${U2R_VERSION}..."
    download_external_asset "https://github.com/wangyu-/udp2raw/releases/download/${U2R_VERSION}/udp2raw_binaries.tar.gz" \
        "$tmpdir/u2r.tgz" || { rm -rf "$tmpdir"; log_error "Could not download udp2raw"; return 1; }
    actual=$(sha256_of "$tmpdir/u2r.tgz")
    if [[ "${actual,,}" != "$U2R_TARBALL_SHA256" ]]; then
        rm -rf "$tmpdir"; log_error "udp2raw checksum mismatch"; return 1
    fi
    tar -xzf "$tmpdir/u2r.tgz" -C "$tmpdir" "$member" || { rm -rf "$tmpdir"; log_error "udp2raw archive is missing $member"; return 1; }
    install -m755 "$tmpdir/$member" "$U2R_BIN"
    rm -rf "$tmpdir"
    command -v iptables >/dev/null 2>&1 || log_warn "iptables not found — udp2raw kernel rules cannot be added"
    log_info "udp2raw installed and checksum verified: $U2R_BIN"
}

wg_obfs_net_prefix() {
    case "${1:-}" in
        icmp) echo "$WG_ICMP_NET_PREFIX" ;;
        faketcp) echo "$WG_FAKETCP_NET_PREFIX" ;;
        *) echo "$WG_NET_PREFIX" ;;
    esac
}

# Same value on both servers (pair subnet), distinct per carrier so ICMP and FakeTCP can coexist.
wg_obfs_default_port() {
    local obfs="$1" subnet_byte="$2"
    case "$obfs" in
        icmp) echo $((DEFAULT_WG_OBFS_PORT_BASE + subnet_byte)) ;;
        faketcp) echo $((DEFAULT_WG_OBFS_PORT_BASE + 256 + subnet_byte)) ;;
        *) return 1 ;;
    esac
}

# udp2raw reserves its port number on UDP too (icmp/udp modes), so WireGuard must listen elsewhere.
wg_obfs_wg_port() {
    local p="$1"
    if (( p <= 55535 )); then echo $((p + 10000)); else echo $((p - 10000)); fi
}

# udp2raw holds its port as a TCP listener (kharej/faketcp) or a UDP socket (icmp, and the iran client's local end).
u2r_port_busy() {
    local obfs="$1" role="$2" port="$3" flags="-Huln"
    command -v ss >/dev/null 2>&1 || return 1
    [[ "$role" == kharej && "$obfs" == faketcp ]] && flags="-Htln"
    [[ -n "$(ss "$flags" "sport = :$port" 2>/dev/null)" ]]
}

create_u2r_runner_script() {
    if ! cat << 'EOF' > "$U2R_RUNNER"
#!/usr/bin/env bash
# udp2raw sidecar for a JojoNet WireGuard instance (WgObfs=icmp|faketcp).
set -Eeuo pipefail
ACTION="${1:-}" NAME="${2:-}"
[[ "$NAME" =~ ^[A-Za-z0-9_.-]{1,15}$ ]] || { echo "invalid name" >&2; exit 1; }
CONF="/etc/jojonet/instances/${NAME}.conf"
TAG="jojonet-u2r-${NAME}"
RUNCONF="/run/jojonet-u2r-${NAME}.conf"

field() { { grep -E "^$1=" "$CONF" 2>/dev/null || true; } | head -1 | cut -d'"' -f2; }

clear_rules() {
    command -v iptables >/dev/null 2>&1 || return 0
    local rule
    local -a parts
    while read -r rule; do
        [[ -n "$rule" ]] || continue
        rule="${rule//\"/}"
        read -ra parts <<< "${rule/-A INPUT/-D INPUT}"
        iptables -w "${parts[@]}" >/dev/null 2>&1 || true
    done < <(iptables -w -S INPUT 2>/dev/null | grep -E -- "--comment \"?${TAG}\"?( |$)" || true)
}

case "$ACTION" in
    start)
        [[ -r "$CONF" ]] || { echo "config missing: $CONF" >&2; exit 1; }
        role=$(field Role); peer=$(field Remote_IP); wgport=$(field TcpPort)
        obfs=$(field WgObfs); port=$(field ObfsPort); keydir=$(field KeyDir)
        [[ "$role" == iran || "$role" == kharej ]] || { echo "bad Role" >&2; exit 1; }
        [[ "$obfs" == icmp || "$obfs" == faketcp ]] || { echo "bad WgObfs" >&2; exit 1; }
        [[ "$peer" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || { echo "bad Remote_IP" >&2; exit 1; }
        [[ "$port" =~ ^[0-9]{1,5}$ && "$wgport" =~ ^[0-9]{1,5}$ ]] || { echo "bad port" >&2; exit 1; }
        [[ "$keydir" == /etc/jojonet/keys/pair_* && "$keydir" != *..* ]] || { echo "bad KeyDir" >&2; exit 1; }
        key=$(tr -d '[:space:]' < "$keydir/udp2raw.key" 2>/dev/null || true)
        [[ "$key" =~ ^[A-Za-z0-9]{16,128}$ ]] || { echo "missing or invalid $keydir/udp2raw.key" >&2; exit 1; }
        clear_rules
        if command -v iptables >/dev/null 2>&1; then
            # Keep the kernel from answering tunnel packets (echo replies / RST); scoped to the peer only.
            # Iran/ICMP needs no rule: the kernel never answers echo replies.
            if [[ "$role" == kharej && "$obfs" == icmp ]]; then
                iptables -w -I INPUT -s "$peer" -p icmp --icmp-type 8 -m comment --comment "$TAG" -j DROP
            elif [[ "$role" == kharej ]]; then
                iptables -w -I INPUT -s "$peer" -p tcp --dport "$port" -m comment --comment "$TAG" -j DROP
            elif [[ "$obfs" == faketcp ]]; then
                iptables -w -I INPUT -s "$peer" -p tcp --sport "$port" -m comment --comment "$TAG" -j DROP
            fi
        fi
        umask 077
        if [[ "$role" == kharej ]]; then
            printf -- '-s\n-l 0.0.0.0:%s\n-r 127.0.0.1:%s\n' "$port" "$wgport" > "$RUNCONF"
        else
            printf -- '-c\n-l 127.0.0.1:%s\n-r %s:%s\n' "$port" "$peer" "$port" > "$RUNCONF"
        fi
        printf -- '-k %s\n--raw-mode %s\n--cipher-mode aes128cbc\n--auth-mode hmac_sha1\n--log-level 3\n--disable-color\n--retry-on-error\n' \
            "$key" "$obfs" >> "$RUNCONF"
        exec /usr/local/bin/udp2raw --conf-file "$RUNCONF"
        ;;
    stop)
        clear_rules
        rm -f "$RUNCONF"
        ;;
    *)
        echo "usage: $0 start|stop NAME" >&2
        exit 1
        ;;
esac
EOF
    then
        return 1
    fi
    chmod +x "$U2R_RUNNER"
}

