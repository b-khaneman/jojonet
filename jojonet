xui_status() {
    local flavor=""
    flavor="$(xui_flavor 2>/dev/null || true)"
    echo -e "${CYAN}--- X-UI ($flavor) ---${NC}"
    if systemctl list-unit-files "$XUI_SERVICE" >/dev/null 2>&1; then
        echo -e "  unit:    $(systemctl is-active "$XUI_SERVICE" 2>/dev/null || echo unknown) / $(systemctl is-enabled "$XUI_SERVICE" 2>/dev/null || echo unknown)"
    else
        echo -e "  unit:    ${YELLOW}not installed${NC}"
    fi
    if [[ -x "$XUI_INSTALL_PATH" ]]; then
        echo -e "  cli:     $XUI_INSTALL_PATH"
        "$XUI_INSTALL_PATH" status 2>/dev/null || true
    elif [[ -x "$XUI_HOME/x-ui" ]]; then
        echo -e "  bin:     $XUI_HOME/x-ui"
    fi
    ss -lntup 2>/dev/null | awk '/x-ui|xray/{print "  listen:  "$0}' || true
}

vpn_creds_write() {
    install -d -m700 /etc/jojonet 2>/dev/null || true
    printf '%s\n' "$@" > "$VPN_CREDS_FILE"
    chmod 600 "$VPN_CREDS_FILE" 2>/dev/null || true
}

vpn_creds_emit() {
    local kind="$1" label="$2" url="$3" user="$4" pass="$5" extra="${6:-}"
    echo ""
    echo "===== JOJONET_VPN_CREDS ====="
    echo "kind=${kind}"
    echo "label=${label}"
    [[ -n "$url" ]] && echo "url=${url}"
    [[ -n "$user" ]] && echo "username=${user}"
    [[ -n "$pass" ]] && echo "password=${pass}"
    [[ -n "$extra" ]] && echo "note=${extra}"
    echo "===== END_JOJONET_VPN_CREDS ====="
    echo ""
    echo "----- مشخصات ورود پنل -----"
    echo "  پنل:   ${label}"
    [[ -n "$url" ]] && echo "  آدرس:  ${url}"
    [[ -n "$user" ]] && echo "  کاربر: ${user}"
    [[ -n "$pass" ]] && echo "  رمز:   ${pass}"
    [[ -n "$extra" ]] && echo "  نکته:  ${extra}"
    echo "  این مشخصات را ذخیره کنید."
    echo "----------------------------"
    vpn_creds_write \
        "kind=${kind}" \
        "label=${label}" \
        "url=${url}" \
        "username=${user}" \
        "password=${pass}" \
        "note=${extra}"
}

xui_settings_raw() {
    local out=""
    if [[ -x "$XUI_HOME/x-ui" ]]; then
        out=$(TERM=dumb timeout 20 "$XUI_HOME/x-ui" setting -show 2>/dev/null || true)
    fi
    if [[ -x "$XUI_INSTALL_PATH" ]]; then
        out+=$'\n'
        out+=$(TERM=dumb timeout 20 "$XUI_INSTALL_PATH" settings </dev/null 2>/dev/null || true)
    fi
    printf '%s' "$out" | sed 's/\x1b\[[0-9;]*[A-Za-z]//g'
}

xui_setting_field() {
    local raw="$1" want="$2"
    printf '%s\n' "$raw" | awk -F: -v want="$want" '
        BEGIN { IGNORECASE=1 }
        {
            key=$1
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", key)
            gsub(/\r/, "", key)
            lk=tolower(key)
            if ((want=="username" && (lk=="username" || lk=="user")) ||
                (want=="password" && (lk=="password" || lk=="pass")) ||
                (want=="port" && lk=="port") ||
                (want=="path" && (lk=="webbasepath" || lk=="web base path")) ||
                (want=="listen" && (lk=="listen" || lk=="listenip")) ||
                (want=="cert" && (lk=="certfile" || lk=="cert" || lk=="webcert")) ||
                (want=="url" && (lk ~ /access[[:space:]]*url/ || lk=="url"))) {
                sub(/^[^:]*:[[:space:]]*/, "")
                gsub(/[[:space:]]+$/, "")
                if (length($0)) { print; exit }
            }
        }'
}

xui_saved_field() {
    local key="$1"
    [[ -f "$VPN_CREDS_FILE" ]] || return 0
    awk -F= -v k="$key" '$1==k {sub(/^[^=]*=/, ""); print; exit}' "$VPN_CREDS_FILE"
}

xui_db_username() {
    local db="/etc/x-ui/x-ui.db"
    [[ -f "$db" ]] || return 0
    python3 - "$db" <<'PY' 2>/dev/null || true
import sqlite3, sys
con = sqlite3.connect(sys.argv[1])
try:
    row = con.execute("SELECT username FROM users ORDER BY id LIMIT 1").fetchone()
    if row and row[0]:
        print(row[0])
except Exception:
    pass
PY
}

xui_print_login() {
    local raw="" text="" user="" pass="" port="" path="" listen="" cert="" ip="" url="" uri="" proto="http" flavor="" label="" note=""
    xui_present || { echo "X-UI is not installed."; return 1; }
    raw="$(xui_settings_raw || true)"
    text="$raw"
    if [[ -f "$XUI_INSTALL_LOG" ]]; then
        text+=$'\n'
        text+=$(cat "$XUI_INSTALL_LOG" 2>/dev/null || true)
    fi
    user="$(xui_setting_field "$text" username)"
    pass="$(xui_setting_field "$text" password)"
    port="$(xui_setting_field "$raw" port)"
    path="$(xui_setting_field "$raw" path)"
    listen="$(xui_setting_field "$raw" listen)"
    cert="$(xui_setting_field "$raw" cert)"
    url="$(xui_setting_field "$raw" url)"
    [[ -z "$url" ]] && url="$(xui_setting_field "$text" url)"
    [[ -z "$user" ]] && user="$(xui_saved_field username)"
    [[ -z "$pass" ]] && pass="$(xui_saved_field password)"
    [[ -z "$user" ]] && user="$(xui_db_username)"
    if [[ "$pass" == \$2[aby]\$* ]]; then
        pass=""
    fi
    path="${path:-/}"
    [[ "$path" == /* ]] || path="/${path}"
    [[ "$path" == "/" ]] || path="${path%/}"
    if [[ -n "$cert" && "$cert" != "none" && "$cert" != "-" ]]; then
        proto="https"
    fi
    if [[ -z "$url" ]]; then
        ip="$(pg_public_ip)"
        if [[ -n "$listen" && "$listen" != "0.0.0.0" && "$listen" != "::" && "$listen" != "*" && -n "$port" ]]; then
            url="${proto}://${listen}:${port}${path}"
        elif [[ -n "$ip" && -n "$port" ]]; then
            url="${proto}://${ip}:${port}${path}"
        fi
    fi
    if [[ -z "$url" && -x "$XUI_HOME/x-ui" ]]; then
        uri=$(TERM=dumb timeout 10 "$XUI_HOME/x-ui" uri 2>/dev/null | grep -oE 'https?://[^[:space:]]+' | head -1 || true)
        [[ -n "$uri" ]] && url="$uri"
    fi
    [[ -z "$url" ]] && url="$(printf '%s\n' "$raw" | grep -oE 'https?://[^[:space:]]+' | head -1 || true)"
    flavor="$(xui_flavor 2>/dev/null || true)"
    if [[ "$flavor" == "classic" ]]; then
        label="X-UI اصلی"
    else
        label="3x-ui سنایی"
    fi
    if [[ -z "$pass" ]]; then
        note="رمز هنگام نصب چاپ می‌شود. اگر نیست: x-ui setting -username USER -password NEW"
    fi
    vpn_creds_emit "xui" "$label" "$url" "$user" "$pass" "$note"
}

pg_print_login() {
    local ip="" port="8000" url="" key="" note=""
    pg_present || { echo "PasarGuard is not installed."; return 1; }
    if [[ -f "$PG_APP_DIR/.env" ]]; then
        port=$(awk -F= '/^[[:space:]]*UVICORN_PORT=/{gsub(/[[:space:]\"]/, "", $2); print $2; exit}' "$PG_APP_DIR/.env")
        port="${port:-8000}"
    fi
    ip="$(pg_public_ip)"
    url="http://${ip:-SERVER-IP}:${port}/dashboard/"
    if command -v pasarguard >/dev/null 2>&1; then
        key=$(TERM=dumb timeout 20 pasarguard cli generate-temp-key 2>/dev/null | sed 's/\x1b\[[0-9;]*[A-Za-z]//g' | awk 'NF{line=$0} END{print line}')
    fi
    if [[ -n "$key" ]]; then
        note="کلید یک‌بارمصرف ورود اول"
        vpn_creds_emit "pasarguard" "پاسارگارد" "$url" "" "$key" "$note"
    else
        note="روی سرور بزن: pasarguard cli generate-temp-key"
        vpn_creds_emit "pasarguard" "پاسارگارد" "$url" "" "" "$note"
    fi
}

vpn_panel_check() {
    local xf="" xr=0 pr=0
    echo "===== JOJONET_VPN_CHECK ====="
    if xui_present; then
        xf="$(xui_flavor 2>/dev/null || true)"
        xui_running && xr=1
        echo "xui=1"
        echo "xui_flavor=${xf:-unknown}"
        echo "xui_running=${xr}"
    else
        echo "xui=0"
        echo "xui_flavor="
        echo "xui_running=0"
    fi
    if pg_present; then
        pg_running && pr=1
        echo "pasarguard=1"
        echo "pasarguard_running=${pr}"
    else
        echo "pasarguard=0"
        echo "pasarguard_running=0"
    fi
    echo "===== END_JOJONET_VPN_CHECK ====="
    echo ""
    echo "----- وضعیت پنل‌های نصب‌شده -----"
    if xui_present; then
        if [[ "$xf" == "classic" ]]; then
            echo -n "  X-UI اصلی: نصب است"
        else
            echo -n "  3x-ui سنایی: نصب است"
        fi
        if (( xr == 1 )); then
            echo " (روشن)"
        else
            echo " (خاموش)"
        fi
    else
        echo "  3x-ui / X-UI: نصب نیست"
    fi
    if pg_present; then
        if (( pr == 1 )); then
            echo "  پاسارگارد: نصب است (روشن)"
        else
            echo "  پاسارگارد: نصب است (خاموش)"
        fi
    else
        echo "  پاسارگارد: نصب نیست"
    fi
    echo "------------------------------"
}

vpn_panel_creds() {
    if xui_present; then
        xui_print_login
        return 0
    fi
    if pg_present; then
        pg_print_login
        return 0
    fi
    if [[ -f "$VPN_CREDS_FILE" ]]; then
        echo "===== JOJONET_VPN_CREDS ====="
        cat "$VPN_CREDS_FILE"
        echo "===== END_JOJONET_VPN_CREDS ====="
        return 0
    fi
    echo "No VPN panel login found."
    return 1
}

xui_uninstall() {
    (( EUID == 0 )) || { log_error "root required"; return 1; }
    xui_present || { echo -e "${YELLOW}[!] X-UI is not installed.${NC}"; return 0; }
    if [[ -x "$XUI_INSTALL_PATH" ]]; then
        echo uninstall | "$XUI_INSTALL_PATH" uninstall 2>/dev/null || true
    fi
    systemctl stop "$XUI_SERVICE" 2>/dev/null || true
    systemctl disable "$XUI_SERVICE" 2>/dev/null || true
    rm -f /etc/systemd/system/x-ui.service "$XUI_FLAVOR_FILE" "$VPN_CREDS_FILE"
    systemctl daemon-reload 2>/dev/null || true
    echo -e "${GREEN}[+] X-UI service stopped. Remove leftover files under /usr/local/x-ui and /etc/x-ui manually if you want a clean slate.${NC}"
}

# ==========================================
# PasarGuard panel (official) — one-click, SQLite, no domain
# https://github.com/PasarGuard/scripts
# ==========================================
PG_APP_DIR="/opt/pasarguard"
PG_SERVICE_NAME="pasarguard"

pg_present() {
    [[ -f "$PG_APP_DIR/docker-compose.yml" || -x /usr/local/bin/pasarguard ]] \
        || command -v pasarguard >/dev/null 2>&1 \
        || { command -v docker >/dev/null 2>&1 && docker ps -a --format '{{.Names}}' 2>/dev/null | grep -qi pasarguard; }
}

pg_running() {
    command -v docker >/dev/null 2>&1 || return 1
    docker ps --format '{{.Names}}' 2>/dev/null | grep -qi pasarguard
}

pg_fetch_installer() {
    local dest="$1" url=""
    for url in \
        "https://raw.githubusercontent.com/PasarGuard/scripts/main/pasarguard.sh" \
        "https://cdn.jsdelivr.net/gh/PasarGuard/scripts@main/pasarguard.sh" \
        "https://ghproxy.net/https://raw.githubusercontent.com/PasarGuard/scripts/main/pasarguard.sh" \
        "https://mirror.ghproxy.com/https://raw.githubusercontent.com/PasarGuard/scripts/main/pasarguard.sh"
    do
        echo -e "  ${CYAN}try${NC} $url" >&2
        if xray_fetch "$url" "$dest"; then
            [[ -s "$dest" ]] || continue
            head -1 "$dest" | grep -q '^#!/' || continue
            grep -q 'pasarguard' "$dest" || continue
            return 0
        fi
    done
    return 1
}

pg_compose() {
    if [[ -x /usr/local/bin/pasarguard ]]; then
        pasarguard "$@"
        return $?
    fi
    command -v docker >/dev/null 2>&1 || return 1
    [[ -f "$PG_APP_DIR/docker-compose.yml" ]] || return 1
    if docker compose version >/dev/null 2>&1; then
        docker compose -f "$PG_APP_DIR/docker-compose.yml" -p "$PG_SERVICE_NAME" "$@"
    else
        docker-compose -f "$PG_APP_DIR/docker-compose.yml" -p "$PG_SERVICE_NAME" "$@"
    fi
}

pg_expose_lan() {
    local envf="$PG_APP_DIR/.env"
    [[ -f "$envf" ]] || return 0
    if grep -qE '^[[:space:]]*UVICORN_HOST=' "$envf"; then
        sed -i 's/^[[:space:]]*UVICORN_HOST=.*/UVICORN_HOST=0.0.0.0/' "$envf"
    else
        printf '\nUVICORN_HOST=0.0.0.0\n' >> "$envf"
    fi
    pg_compose up -d >/dev/null 2>&1 || true
}

pg_public_ip() {
    auto_detect_network >/dev/null 2>&1 || true
    printf '%s' "${DETECTED_IP:-$(hostname -I 2>/dev/null | awk '{print $1}')}"
}

pg_install() {
    local tmp="" ip=""
    (( EUID == 0 )) || { log_error "PasarGuard install needs root"; return 1; }
    command -v systemctl >/dev/null 2>&1 || { log_error "systemd is required"; return 1; }
    if pg_present; then
        echo -e "${YELLOW}[!] همین پنل از قبل روی این سرور نصب است: پاسارگارد${NC}"
        if pg_running; then
            echo -e "    وضعیت: روشن است. نصب دوباره انجام نشد."
        else
            echo -e "    وضعیت: فایل‌ها هست (کانتینر الان خاموش است). نصب دوباره انجام نشد."
        fi
        pg_status
        pg_print_login || true
        return 0
    fi
    confirm_panel_install "PasarGuard" || { echo "Cancelled."; return 1; }
    echo -e "${CYAN}[*] Installing official PasarGuard (SQLite, one-click). Not a JojoNet tunnel.${NC}"
    echo -e "    Needs Docker. 1GB RAM is tight — prefer 2GB+."
    tmp=$(mktemp /tmp/jojonet-pg-install.XXXXXX) || return 1
    if ! pg_fetch_installer "$tmp"; then
        rm -f "$tmp"
        log_error "Could not download PasarGuard installer (GitHub + mirrors)."
        return 1
    fi
    chmod 700 "$tmp"
    # Official script ends by following docker logs (blocks). Skip that for one-click.
    sed -i 's/^follow_pasarguard_logs$/true/' "$tmp"
    # Answer "install node?" with no. --no-ssl = no domain prompt.
    if ! printf 'n\n' | bash "$tmp" install --no-ssl; then
        rm -f "$tmp"
        log_error "PasarGuard installer failed."
        return 1
    fi
    rm -f "$tmp"
    pg_expose_lan
    echo -e "${GREEN}[+] PasarGuard install finished.${NC}"
    pg_status
    pg_print_login || true
}

pg_status() {
    local ip="" port="8000"
    echo -e "${CYAN}--- PasarGuard ---${NC}"
    if ! pg_present; then
        echo -e "  unit:    ${YELLOW}not installed${NC}"
        return 0
    fi
    if [[ -f "$PG_APP_DIR/.env" ]]; then
        port=$(awk -F= '/^[[:space:]]*UVICORN_PORT=/{gsub(/[[:space:]\"]/, "", $2); print $2; exit}' "$PG_APP_DIR/.env")
        port="${port:-8000}"
    fi
    ip=$(pg_public_ip)
    echo -e "  dir:     $PG_APP_DIR"
    if command -v docker >/dev/null 2>&1; then
        docker ps --filter "name=pasarguard" --format '  docker:  {{.Names}} {{.Status}}' 2>/dev/null || true
    fi
    [[ -n "$ip" ]] && echo -e "  url:     ${GREEN}http://${ip}:${port}/dashboard/${NC}"
    echo -e "  first login: jojonet --vpn-panel-creds"
    ss -lntup 2>/dev/null | awk -v p=":$port" '$0 ~ p {print "  listen:  "$0}' || true
}

pg_uninstall() {
    (( EUID == 0 )) || { log_error "root required"; return 1; }
    pg_present || { echo -e "${YELLOW}[!] PasarGuard is not installed.${NC}"; return 0; }
    pg_compose down >/dev/null 2>&1 || true
    if ! xui_present; then
        rm -f "$VPN_CREDS_FILE"
    fi
    echo -e "${GREEN}[+] PasarGuard containers stopped. Files under $PG_APP_DIR kept.${NC}"
}

