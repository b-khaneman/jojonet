# Auto-defaults for quick tunnel setup.
# JOJONET_AUTO=1 → always auto | =0 → advanced prompts
# Unset: CLI with peer IP → auto; menu → ask once [Y/n] (default Y)
# peer_from_cli=1 means peer IP was passed as an argument (skip confirm).
jojonet_use_auto_defaults() {
    local peer_from_cli="${1:-0}" ans
    case "${JOJONET_AUTO:-}" in
        0|n|N|no|NO|false|FALSE|off|OFF)
            echo -e "${YELLOW}[*] Advanced prompts (JOJONET_AUTO=0)${NC}" >&2
            return 1
            ;;
        1|y|Y|yes|YES|true|TRUE|on|ON)
            echo -e "${GREEN}[*] Automatic defaults (JOJONET_AUTO=1)${NC}" >&2
            return 0
            ;;
    esac
    if [[ "$peer_from_cli" == "1" ]]; then
        echo -e "${GREEN}[*] Automatic defaults${NC}" >&2
        return 0
    fi
    if [[ ! -t 0 ]]; then
        return 0
    fi
    read -r -p "Use automatic defaults? [Y/n]: " ans
    ans=$(printf '%s' "${ans:-y}" | tr '[:upper:]' '[:lower:]')
    if [[ "$ans" == "n" || "$ans" == "no" ]]; then
        echo -e "${YELLOW}[*] Advanced prompts${NC}" >&2
        return 1
    fi
    echo -e "${GREEN}[*] Using automatic defaults${NC}" >&2
    return 0
}

