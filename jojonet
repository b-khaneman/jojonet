# ==========================================
# External standalone transports
# Spoof Tunnel and QS-Tunnel are not JojoNet overlay instances.
# ==========================================

json_escape() {
    local s="${1-}"
    case "$s" in
        *$'\n'*|*$'\r'*) return 1 ;;
    esac
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

json_string() {
    local escaped
    escaped=$(json_escape "${1-}") || return 1
    printf '"%s"' "$escaped"
}

csv_json_array() {
    local raw="${1-}" item first=1 escaped
    local -a values=()
    local IFS=','
    read -ra values <<< "$raw"
    printf '['
    for item in "${values[@]}"; do
        item="${item#"${item%%[![:space:]]*}"}"
        item="${item%"${item##*[![:space:]]}"}"
        [[ -n "$item" ]] || continue
        escaped=$(json_escape "$item") || return 1
        (( first )) || printf ', '
        printf '"%s"' "$escaped"
        first=0
    done
    printf ']'
}

csv_has_value() {
    local raw="${1-}" item
    local -a values=()
    local IFS=','
    read -ra values <<< "$raw"
    for item in "${values[@]}"; do
        item="${item#"${item%%[![:space:]]*}"}"
        item="${item%"${item##*[![:space:]]}"}"
        [[ -n "$item" ]] && return 0
    done
    return 1
}

validate_single_port() {
    [[ "${1-}" =~ ^[0-9]{1,5}$ ]] && (( 10#${1} >= 1 && 10#${1} <= 65535 ))
}

validate_transport() {
    case "${1-}" in
        tcp|udp|icmp|icmpv6) return 0 ;;
        *) return 1 ;;
    esac
}

validate_host_port() {
    local value="${1-}" port
    [[ "$value" =~ ^[^[:space:]:/]+:([0-9]{1,5})$ ]] || return 1
    port="${BASH_REMATCH[1]}"
    validate_single_port "$port"
}

validate_json_file() {
    local file="$1" py=""
    if command -v python3 >/dev/null 2>&1; then
        py=python3
    elif command -v python >/dev/null 2>&1; then
        py=python
    else
        grep -q '^{\|^\[' "$file" && grep -q '}$\|]$' "$file"
        return
    fi
    "$py" -m json.tool "$file" >/dev/null
}

external_role() {
    local forced choice
    forced=$(printf '%s' "${JOJONET_ROLE:-}" | tr '[:upper:]' '[:lower:]')
    case "$forced" in
        iran|ir) printf 'iran'; return 0 ;;
        kharej|foreign|out|abroad) printf 'kharej'; return 0 ;;
    esac
    echo -e "  ${GREEN}1)${NC} Iran" >&2
    echo -e "  ${GREEN}2)${NC} Kharej / Foreign" >&2
    read -r -p "Server role [1/2]: " choice </dev/tty
    case "$choice" in
        1) printf 'iran' ;;
        2) printf 'kharej' ;;
        *) return 1 ;;
    esac
}

download_external_asset() {
    local github_url="$1" dest="$2" url
    for url in \
        "$github_url" \
        "https://ghproxy.net/${github_url}" \
        "https://mirror.ghproxy.com/${github_url}"
    do
        echo -e "  ${CYAN}try${NC} $url" >&2
        if command -v curl >/dev/null 2>&1; then
            curl -fsSL --connect-timeout 10 --max-time 180 "$url" -o "$dest" 2>/dev/null && [[ -s "$dest" ]] && return 0
        elif command -v wget >/dev/null 2>&1; then
            wget -qO "$dest" --timeout=180 "$url" 2>/dev/null && [[ -s "$dest" ]] && return 0
        else
            log_error "curl or wget is required"
            return 1
        fi
        rm -f "$dest"
    done
    return 1
}

detect_spoof_asset() {
    case "$(uname -m)" in
        x86_64|amd64) printf 'spoof-linux-amd64' ;;
        aarch64|arm64) printf 'spoof-linux-arm64' ;;
        *) return 1 ;;
    esac
}

install_spoof_binary() {
    local asset tmpdir sums expected actual base
    if [[ -x "$SPOOF_BIN" ]]; then
        log_info "Spoof Tunnel binary already present: $SPOOF_BIN"
        return 0
    fi
    asset=$(detect_spoof_asset) || { log_error "Spoof Tunnel supports only amd64 and arm64"; return 1; }
    tmpdir=$(mktemp -d /tmp/jojonet-spoof.XXXXXX) || return 1
    base="https://github.com/${SPOOF_REPO}/releases/download/${SPOOF_VERSION}"
    log_note "Downloading Spoof Tunnel ${SPOOF_VERSION} ($asset)..."
    download_external_asset "$base/checksums.txt" "$tmpdir/checksums.txt" || {
        rm -rf "$tmpdir"; log_error "Could not download upstream checksums.txt"; return 1;
    }
    download_external_asset "$base/$asset" "$tmpdir/$asset" || {
        rm -rf "$tmpdir"; log_error "Could not download Spoof Tunnel binary"; return 1;
    }
    expected=$(awk -v n="$asset" '{
        f=$2; sub(/^\*/, "", f)
        if (f==n || f=="./" n) { print $1; exit }
    }' "$tmpdir/checksums.txt")
    [[ "$expected" =~ ^[A-Fa-f0-9]{64}$ ]] || {
        rm -rf "$tmpdir"; log_error "No valid checksum for $asset in upstream checksums.txt"; return 1;
    }
    actual=$(sha256_of "$tmpdir/$asset")
    if [[ "${actual,,}" != "${expected,,}" ]]; then
        rm -rf "$tmpdir"
        log_error "Spoof Tunnel checksum mismatch"
        return 1
    fi
    install -m755 "$tmpdir/$asset" "$SPOOF_BIN"
    rm -rf "$tmpdir"
    log_info "Spoof Tunnel installed and checksum verified: $SPOOF_BIN"
}

write_spoof_config() {
    local role="$1" listen="$2" remote="$3" remote_port="$4" recv_port="$5"
    local forward="$6" client_ip="$7" client_port="$8" spoof_ip="$9"
    local spoof_port="${10}" peer_spoof_ip="${11}" send_transport="${12}" recv_transport="${13}"
    local spoof_source_type="${14:-ip}" tmp spoof_source_json
    install -d -m700 "$SPOOF_CONFIG_DIR"
    tmp=$(mktemp "$SPOOF_CONFIG_DIR/.config.XXXXXX") || return 1
    if [[ "$spoof_source_type" == "file" ]]; then
        spoof_source_json="  \"spoof_ip_file\": $(json_string "$spoof_ip"),"
    else
        spoof_source_json="  \"spoof_ip\": $(json_string "$spoof_ip"),"
    fi
    if [[ "$role" == "iran" ]]; then
        cat > "$tmp" <<EOF
{
  "mode": "local",
  "listen": $(json_string "$listen"),
  "remote": $(json_string "$remote"),
  "remote_port": $remote_port,
  "recv_port": $recv_port,
${spoof_source_json}
  "spoof_port": $spoof_port,
  "peer_spoof_ip": $(json_string "$peer_spoof_ip"),
  "send_transport": $(json_string "$send_transport"),
  "recv_transport": $(json_string "$recv_transport")
}
EOF
    else
        cat > "$tmp" <<EOF
{
  "mode": "remote",
  "listen_port": $recv_port,
  "forward": $(json_string "$forward"),
  "client_ip": $(json_string "$client_ip"),
  "client_port": $client_port,
${spoof_source_json}
  "spoof_port": $spoof_port,
  "peer_spoof_ip": $(json_string "$peer_spoof_ip"),
  "send_transport": $(json_string "$send_transport"),
  "recv_transport": $(json_string "$recv_transport")
}
EOF
    fi
    if ! validate_json_file "$tmp"; then
        rm -f "$tmp"; log_error "Generated Spoof Tunnel JSON is invalid"; return 1
    fi
    chmod 600 "$tmp"
    mv -f "$tmp" "$SPOOF_CONFIG"
}

create_spoof_service() {
    cat > "$SPOOF_SERVICE" <<EOF
[Unit]
Description=JojoNet external Spoof Tunnel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=${SPOOF_BIN} run -c ${SPOOF_CONFIG}
Restart=on-failure
RestartSec=3
User=root
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
EOF
    chmod 644 "$SPOOF_SERVICE"
    systemctl daemon-reload
}

setup_spoof_tunnel() {
    local peer_hint="${1:-}" role listen remote remote_port recv_port forward client_ip client_port
    local spoof_ip spoof_port peer_spoof_ip send_transport recv_transport value spoof_source_type
    print_banner "Spoof Tunnel (standalone external transport)"
    echo -e "${RED}[!] Mandatory:${NC} both hosts and both providers must permit source-IP spoofing."
    echo "    Raw sockets/root are required. This is not a JojoNet overlay mode."
    local peer_from_cli=0 use_auto=0
    [[ -n "$peer_hint" ]] && peer_from_cli=1
    role=$(external_role) || { log_error "Invalid role"; return 1; }
    install_spoof_binary || return 1
    if jojonet_use_auto_defaults "$peer_from_cli"; then use_auto=1; fi
    listen="" remote="" remote_port=0 recv_port=0 forward="" client_ip="" client_port=0
    # Same env on both sides: UP = Iran -> Kharej, DOWN = Kharej -> Iran.
    local up_port="${JOJONET_SPOOF_REMOTE_PORT:-9000}" down_port="${JOJONET_SPOOF_RECV_PORT:-9001}"
    local up_tr="${JOJONET_SPOOF_UP_TRANSPORT:-tcp}" down_tr="${JOJONET_SPOOF_DOWN_TRANSPORT:-udp}"
    if (( use_auto )); then
        if [[ "$role" == "iran" ]]; then
            listen="${JOJONET_SPOOF_LISTEN:-127.0.0.1:8443}"
            remote="${peer_hint}"
            [[ -z "$remote" ]] && read -r -p "Kharej address: " remote
            remote_port="$up_port"
            recv_port="$down_port"
            send_transport="$up_tr"; recv_transport="$down_tr"
        else
            recv_port="$up_port"
            forward="${JOJONET_SPOOF_FORWARD:-127.0.0.1:443}"
            client_ip="${peer_hint}"
            [[ -z "$client_ip" ]] && read -r -p "Iran/client address: " client_ip
            client_port="$down_port"
            send_transport="$down_tr"; recv_transport="$up_tr"
        fi
        echo -e "  ${CYAN}Ports:${NC} up ${up_port}/${up_tr}, down ${down_port}/${down_tr} (auto)"
    elif [[ "$role" == "iran" ]]; then
        read -r -p "Local listen endpoint [127.0.0.1:8443]: " listen
        listen="${listen:-127.0.0.1:8443}"
        validate_host_port "$listen" || { log_error "Use HOST:PORT for local listen"; return 1; }
        read -r -p "Kharej address [$peer_hint]: " remote
        remote="${remote:-$peer_hint}"
        [[ -n "$remote" && "$remote" != *[[:space:]/]* ]] || { log_error "Invalid Kharej address"; return 1; }
        read -r -p "Kharej remote port [9000]: " remote_port
        remote_port="${remote_port:-9000}"
        read -r -p "Iran receive port [9001]: " recv_port
        recv_port="${recv_port:-9001}"
        send_transport="tcp"; recv_transport="udp"
    else
        read -r -p "Remote listen port [9000]: " recv_port
        recv_port="${recv_port:-9000}"
        read -r -p "Forward UDP/TCP endpoint [127.0.0.1:443]: " forward
        forward="${forward:-127.0.0.1:443}"
        validate_host_port "$forward" || { log_error "Use HOST:PORT for forward endpoint"; return 1; }
        read -r -p "Iran/client address [$peer_hint]: " client_ip
        client_ip="${client_ip:-$peer_hint}"
        [[ -n "$client_ip" && "$client_ip" != *[[:space:]/]* ]] || { log_error "Invalid client address"; return 1; }
        read -r -p "Iran/client receive port [9001]: " client_port
        client_port="${client_port:-9001}"
        send_transport="udp"; recv_transport="tcp"
    fi
    if (( use_auto )); then
        [[ "$role" != "iran" ]] || validate_host_port "$listen" || { log_error "Use HOST:PORT for local listen"; return 1; }
        [[ "$role" != "kharej" ]] || validate_host_port "$forward" || { log_error "Use HOST:PORT for forward endpoint"; return 1; }
        [[ -n "${remote:-$client_ip}" && "${remote:-$client_ip}" != *[[:space:]/]* ]] || {
            log_error "Peer address is required"; return 1;
        }
    fi
    validate_single_port "$recv_port" || { log_error "Invalid listen/receive port"; return 1; }
    [[ "$role" != "iran" ]] || validate_single_port "$remote_port" || { log_error "Invalid remote port"; return 1; }
    [[ "$role" != "kharej" ]] || validate_single_port "$client_port" || { log_error "Invalid client port"; return 1; }
    spoof_ip="${JOJONET_SPOOF_IP:-}"
    [[ -n "$spoof_ip" ]] || read -r -p "Spoof source IP, or absolute list file prefixed with @: " spoof_ip
    spoof_source_type="ip"
    if [[ "$spoof_ip" == @* ]]; then
        spoof_source_type="file"
        spoof_ip="${spoof_ip#@}"
        [[ "$spoof_ip" == /* && -r "$spoof_ip" ]] || {
            log_error "Spoof IP list must be an existing readable absolute path"; return 1;
        }
    else
        validate_ipv4 "$spoof_ip" || { log_error "Spoof IP must be a valid IPv4 address"; return 1; }
    fi
    if (( use_auto )); then
        spoof_port="${JOJONET_SPOOF_PORT:-53}"
        peer_spoof_ip="${JOJONET_SPOOF_PEER_IP:-}"
        [[ -n "$peer_spoof_ip" ]] || read -r -p "Peer spoof IP: " peer_spoof_ip
    else
        read -r -p "Spoof source port [53]: " spoof_port
        spoof_port="${spoof_port:-53}"
        read -r -p "Peer spoof IP: " peer_spoof_ip
        read -r -p "Send transport [$send_transport] (tcp/udp/icmp/icmpv6): " value
        send_transport="${value:-$send_transport}"
        read -r -p "Receive transport [$recv_transport] (tcp/udp/icmp/icmpv6): " value
        recv_transport="${value:-$recv_transport}"
    fi
    validate_single_port "$spoof_port" || { log_error "Invalid spoof port"; return 1; }
    validate_ipv4 "$peer_spoof_ip" || { log_error "Peer spoof IP must be a valid IPv4 address"; return 1; }
    validate_transport "$send_transport" && validate_transport "$recv_transport" || {
        log_error "Transports must be tcp, udp, icmp, or icmpv6"; return 1;
    }
    validate_ipv4 "${remote:-$client_ip}" || { log_error "Peer address must be a valid IPv4 address"; return 1; }
    write_spoof_config "$role" "$listen" "$remote" "$remote_port" "$recv_port" \
        "$forward" "$client_ip" "$client_port" "$spoof_ip" "$spoof_port" \
        "$peer_spoof_ip" "$send_transport" "$recv_transport" "$spoof_source_type" || return 1
    create_spoof_service || return 1
    spoof_open_firewall "$role" "$listen" "$recv_port" "$recv_transport" "$peer_spoof_ip" || true
    systemctl enable jojonet-spoof.service >/dev/null 2>&1 || true
    systemctl restart jojonet-spoof.service || true
    sleep 2
    systemctl --no-pager --full status jojonet-spoof.service 2>/dev/null || true
    if ! systemctl is-active --quiet jojonet-spoof.service; then
        journalctl -u jojonet-spoof.service -n 30 --no-pager 2>/dev/null || true
        log_error "jojonet-spoof.service failed to start"
        return 1
    fi
    log_info "Spoof Tunnel ($role) is running"
}

ufw_is_active() {
    command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -qi 'Status: active'
}

# Rules are recorded as "PROTO PORT FROM" lines in ufw.rules so they can be removed exactly.
spoof_ufw_rule() {
    local proto="$1" port="$2" from="$3"
    ufw_is_active || return 0
    if ufw allow proto "$proto" from "$from" to any port "$port" comment 'jojonet-spoof' >/dev/null 2>&1; then
        printf '%s %s %s\n' "$proto" "$port" "$from" >> "$SPOOF_CONFIG_DIR/ufw.rules"
    else
        log_warn "UFW active — open ${proto} ${port} from ${from} manually"
    fi
}

# Incoming tunnel packets carry the peer's spoofed source; a default-deny INPUT chain would drop them.
spoof_open_firewall() {
    local role="$1" listen="$2" recv_port="$3" recv_transport="$4" peer_spoof_ip="$5" host port
    spoof_close_firewall
    case "$recv_transport" in
        tcp|udp) spoof_ufw_rule "$recv_transport" "$recv_port" "$peer_spoof_ip" ;;
    esac
    [[ "$role" == "iran" ]] || return 0
    host="${listen%:*}" port="${listen##*:}"
    [[ "$host" == 127.* || "$host" == "localhost" ]] && return 0
    validate_single_port "$port" && spoof_ufw_rule udp "$port" any
}

spoof_close_firewall() {
    local proto port from
    if [[ -r "$SPOOF_CONFIG_DIR/ufw.rules" ]] && ufw_is_active; then
        while read -r proto port from; do
            [[ "$proto" == tcp || "$proto" == udp ]] || continue
            validate_single_port "$port" || continue
            [[ "$from" == any ]] || validate_ipv4 "$from" || continue
            ufw delete allow proto "$proto" from "$from" to any port "$port" >/dev/null 2>&1 || true
        done < "$SPOOF_CONFIG_DIR/ufw.rules"
    fi
    rm -f "$SPOOF_CONFIG_DIR/ufw.rules"
}

remove_spoof_tunnel() {
    systemctl disable --now jojonet-spoof.service >/dev/null 2>&1 || true
    spoof_close_firewall
    rm -f "$SPOOF_SERVICE" "$SPOOF_CONFIG"
    rmdir "$SPOOF_CONFIG_DIR" 2>/dev/null || true
    systemctl daemon-reload 2>/dev/null || true
    systemctl reset-failed jojonet-spoof.service 2>/dev/null || true
    if [[ -x "$SPOOF_BIN" ]]; then
        log_info "Spoof Tunnel removed (binary kept at $SPOOF_BIN)"
    else
        log_info "Spoof Tunnel removed"
    fi
}

find_python312() {
    local py version
    for py in python3.13 python3.12 python3; do
        command -v "$py" >/dev/null 2>&1 || continue
        version=$("$py" -c 'import sys; print(int(sys.version_info >= (3, 12)))' 2>/dev/null || true)
        [[ "$version" == "1" ]] && { printf '%s' "$py"; return 0; }
    done
    return 1
}

install_qs_tunnel() {
    local py tmpdir archive url
    py=$(find_python312) || {
        log_error "QS-Tunnel requires Python 3.12 or newer (install python3.12 + python3.12-venv)"; return 1;
    }
    command -v tar >/dev/null 2>&1 || { log_error "tar is required"; return 1; }
    tmpdir=$(mktemp -d /tmp/jojonet-qs.XXXXXX) || return 1
    archive="$tmpdir/qs.tar.gz"
    url="https://github.com/${QS_REPO}/archive/${QS_COMMIT}.tar.gz"
    log_note "Downloading pinned QS-Tunnel commit ${QS_COMMIT}..."
    download_external_asset "$url" "$archive" || { rm -rf "$tmpdir"; log_error "QS-Tunnel download failed"; return 1; }
    rm -rf "$QS_DIR"
    install -d -m755 "$QS_DIR"
    tar -xzf "$archive" --strip-components=1 -C "$QS_DIR" || {
        rm -rf "$tmpdir" "$QS_DIR"; log_error "QS-Tunnel archive extraction failed"; return 1;
    }
    rm -rf "$tmpdir"
    "$py" -m venv "$QS_DIR/.venv" || {
        log_error "Could not create venv (install the Python venv package)"; return 1;
    }
    install -d -m700 "$QS_DIR/.tmp"
    PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_NO_CACHE_DIR=1 TMPDIR="$QS_DIR/.tmp" \
        "$QS_DIR/.venv/bin/python" -m pip install --no-cache-dir -r "$QS_DIR/requirements.txt" || return 1
    rm -rf "$QS_DIR/.tmp"
    log_info "QS-Tunnel installed at $QS_DIR (pinned commit)"
}

write_qs_config() {
    local role="$1" dns_ips="$2" send_domains="$3" fake_ip="$4" fake_port="$5"
    local h_addr="$6" max_domain="$7" max_sub="$8" retries="$9" sockets="${10}"
    local public_ip="${11}" query_type="${12}" interval="${13}" wait_limit="${14}"
    local password="${15}" receive_port="${16}" recv_domains="${17}" tmp
    install -d -m700 "$QS_CONFIG_DIR"
    tmp=$(mktemp "$QS_CONFIG_DIR/.config.XXXXXX") || return 1
    if [[ "$role" == "iran" ]]; then
        cat > "$tmp" <<EOF
{
  "mode": "1-1",
  "dns_ips": $(csv_json_array "$dns_ips"),
  "send_domains": $(csv_json_array "$send_domains"),
  "fake_send_ip": $(json_string "$fake_ip"),
  "fake_send_port": $fake_port,
  "h_in_address": $(json_string "$h_addr"),
  "max_domain_len": $max_domain,
  "max_sub_len": $max_sub,
  "retries": $retries,
  "send_sock_numbers": $sockets,
  "my_public_ip": $(json_string "$public_ip"),
  "send_query_type_int": $query_type,
  "packets_send_interval": $interval,
  "packets_wait_time_limit": $wait_limit,
  "info_encryption_pass": $(json_string "$password")
}
EOF
    else
        cat > "$tmp" <<EOF
{
  "mode": "1-1",
  "receive_port": $receive_port,
  "recv_domains": $(csv_json_array "$recv_domains"),
  "h_out_address": $(json_string "$h_addr"),
  "info_decryption_pass": $(json_string "$password")
}
EOF
    fi
    if ! validate_json_file "$tmp"; then
        rm -f "$tmp"; log_error "Generated QS-Tunnel JSON is invalid"; return 1
    fi
    chmod 600 "$tmp"
    mv -f "$tmp" "$QS_CONFIG"
    ln -sfn "$QS_CONFIG" "$QS_DIR/config_$([[ "$role" == "iran" ]] && echo client || echo server).json"
}

create_qs_service() {
    local role="$1" entry
    [[ "$role" == "iran" ]] && entry=main_client.py || entry=main_server.py
    cat > "$QS_SERVICE" <<EOF
[Unit]
Description=JojoNet external QS-Tunnel (${role})
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=${QS_DIR}
ExecStart=${QS_DIR}/.venv/bin/python ${QS_DIR}/${entry}
Restart=on-failure
RestartSec=3
User=root
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
EOF
    chmod 644 "$QS_SERVICE"
    systemctl daemon-reload
}

