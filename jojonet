        systemctl daemon-reload || return 1
    fi
}

quick_add_tunnel_v6() {
    local mode="$1" peer_ip="${2:-}"
    local peer_from_cli=0 use_auto=0 ins_name="" role_conf="" loc_ip="" rem_ip=""
    local fwd_port="" existing="" other="" _fp=""
    v6_mode "$mode" || { log_error "Unknown IPv6 mode: $mode"; return 1; }
    [[ -n "$peer_ip" ]] && peer_from_cli=1

    set +e
    clear_screen
    logo
    print_banner "$(tunnel_mode_label "$mode")"
    echo -e "${CYAN}How it works:${NC}"
    echo -e "  6to4 SIT: IPv6 inside IPv4 (protocol 41) with private IPv6 fd6a:… on both servers"
    if [[ "$mode" == "sit" ]]; then
        echo -e "  Use the private IPv6 of the peer directly (e.g. as an Xray/V2Ray outbound address)"
    else
        echo -e "  $( [[ "$mode" == "gre6" ]] && echo "GRE6" || echo "IPIP6" ) over the SIT link carries IPv4; Iran forwards ports with DNAT"
    fi
    echo ""

    if ! auto_detect_network; then
        echo -e "${RED}[!] Cannot detect network.${NC}"
        sleep 2; set -e; return 1
    fi
    loc_ip="$DETECTED_IP"
    show_existing_tunnels_summary

    if [[ -z "$peer_ip" ]]; then
        read -r -p "Peer server IP: " peer_ip
    fi
    peer_ip="${peer_ip// /}"
    if ! validate_ipv4 "$peer_ip"; then
        echo -e "${RED}[!] Invalid peer IP.${NC}"
        sleep 2; set -e; return 1
    fi
    rem_ip="$peer_ip"

    if other=$(v6_tunnel_for_peer "$rem_ip"); then
        existing="${other%% *}"
        if [[ "${other##* }" == "$mode" ]]; then
            echo -e "${YELLOW}[!] $(tunnel_mode_label "$mode") to $rem_ip exists [$existing]. Restarting...${NC}"
            local _rrc=0
            restart_tunnel "$existing" || _rrc=$?
            sleep 2; set -e; return "$_rrc"
        fi
        echo -e "${RED}[!] $rem_ip already has an IPv6 tunnel [$existing] (${other##* }). Only one 6to4/GRE6/IPIP6 per peer — delete it first.${NC}"
        sleep 2; set -e; return 1
    fi

    if ! role_conf=$(resolve_server_role "$loc_ip"); then
        echo -e "${RED}[!] Role required. Set JOJONET_ROLE=iran|kharej${NC}"
        sleep 2; set -e; return 1
    fi
    echo -e "${GREEN}[*] Role:${NC} $role_conf"

    if jojonet_use_auto_defaults "$peer_from_cli"; then
        use_auto=1
    fi
    ins_name=$(allocate_tunnel_name "$rem_ip" "$role_conf" "$mode") || { set -e; return 1; }

    if [[ "$role_conf" == "iran" && "$mode" != "sit" ]]; then
        if (( use_auto )); then
            fwd_port="${JOJONET_FWD_PORTS:-}"
        else
            fwd_port=$(allocate_iran_forward_port "443")
            read -r -p "Ports to forward to Kharej [$fwd_port]: " _fp
            fwd_port=${_fp:-$fwd_port}
        fi
        if [[ -n "$fwd_port" ]]; then
            fwd_port=$(normalize_port_list "$fwd_port")
            if ! valid_port_csv "$fwd_port"; then
                echo -e "${RED}[!] Invalid port list: $fwd_port${NC}"
                sleep 2; set -e; return 1
            fi
        fi
    fi

    v6_plan "$ins_name" "$role_conf" "$loc_ip" "$rem_ip" "$mode"
    echo -e "\n${CYAN}--- IPv6 tunnel plan ---${NC}"
    echo -e "  Name:     $ins_name ($(tunnel_mode_label "$mode"))"
    echo -e "  Role:     $role_conf"
    echo -e "  Peer:     $rem_ip"
    echo -e "  SIT:      $V6_IFACE  ${V6_LOCAL} ↔ ${V6_REMOTE}"
    [[ "$mode" != "sit" ]] && echo -e "  Overlay:  $ins_name  ${V6_TUN_IP}"
    [[ -n "$fwd_port" ]] && echo -e "  Forward:  $fwd_port"
    hint "Now run on the peer: sudo jojonet $(tunnel_cli_flag "$mode") $loc_ip"
    echo ""

    if deploy_tunnel "$ins_name" "$role_conf" "$loc_ip" "$rem_ip" "" \
        "" "" "0" "$fwd_port" "$mode" "" "" "" "" "tcp"; then
        echo -e "${GREEN}[+] $(tunnel_mode_label "$mode") [$ins_name] is up.${NC}"
        sleep 2
        set -e
        return 0
    fi
    sleep 3
    set -e
    return 1
}

# ==========================================
# v1.6.0 — DNSTT (DoH/DoT/UDP DNS tunnel) and ICMP (pingtunnel + ChaCha20)
# Iran dials Kharej. Public ports on Iran are forwarded to 127.0.0.1 on Kharej.
# One DNSTT per Kharej (UDP/53). One ICMP tunnel per host (raw ICMP socket).
# ==========================================

DNSTT_SERVER_BIN="/usr/local/bin/dnstt-server"
DNSTT_CLIENT_BIN="/usr/local/bin/dnstt-client"
DNSTT_VERSION="${JOJONET_DNSTT_VERSION:-v1.20260501.0}"
DNSTT_GOMOD="www.bamsoftware.com/git/dnstt.git"
DEFAULT_DNSTT_DNS_PORT=5300
DEFAULT_DNSTT_MODE="doh"
DEFAULT_DNSTT_DOH="https://cloudflare-dns.com/dns-query"
DEFAULT_DNSTT_DOT="1.1.1.1:853"
DEFAULT_DNSTT_UDP="1.1.1.1:53"
DEFAULT_DNSTT_FWD="443"
PINGTUNNEL_BIN="/usr/local/bin/pingtunnel"
PINGTUNNEL_VERSION="${JOJONET_PINGTUNNEL_VERSION:-2.10}"
PINGTUNNEL_SHA256_AMD64="2a4902f62ffc2eae7fefde97a6edbc3db9f2d63a53cd17501c2dc4277b05a897"
PINGTUNNEL_SHA256_ARM64="e4b4ee5e208eac377a2308883ac75a592b02cc56c45de11d331c85ee25e4e8b7"
STREAM_RUNNER="/usr/local/bin/jojonet-run-stream.sh"
STREAM_SERVICE="/etc/systemd/system/jojonet-stream@.service"
STREAM_RUN_DIR="/run/jojonet"
ICMP_CONFIG_DIR="$JOJONET_ROOT/icmp"
DNSTT_CONFIG_DIR="$JOJONET_ROOT/dnstt"

dnstt_mode() { [[ "${1:-}" == "dnstt" ]]; }
icmp_mode() { [[ "${1:-}" == "icmp" ]]; }
stream_mode() { dnstt_mode "$1" || icmp_mode "$1"; }

valid_dns_name() {
    local n="${1:-}"
    [[ ${#n} -ge 4 && ${#n} -le 253 ]] || return 1
    [[ "$n" == *.* ]] || return 1
    [[ "$n" =~ ^[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?(\.[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?)+$ ]]
}

valid_dnstt_mode() { [[ "${1:-}" =~ ^(doh|dot|udp)$ ]]; }

valid_https_url() {
    local u="${1:-}" re
    re='^https://[A-Za-z0-9./_~:?&=%+-]+$'
    [[ "$u" =~ $re ]] || return 1
    [[ "$u" != *..* && "$u" != *$'\n'* && "$u" != *$'\r'* && ${#u} -le 200 ]]
}

valid_dnstt_resolver() {
    local mode="$1" r="$2"
    case "$mode" in
        doh) valid_https_url "$r" ;;
        dot)
            if [[ "$r" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}(:[0-9]{1,5})?$ ]]; then
                validate_ipv4 "${r%%:*}" || return 1
                [[ "$r" == *:* ]] && { validate_single_port "${r##*:}" || return 1; }
                return 0
            fi
            valid_dns_name "${r%%:*}" || return 1
            [[ "$r" == *:* ]] && { validate_single_port "${r##*:}" || return 1; }
            return 0
            ;;
        udp)
            [[ "$r" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}(:[0-9]{1,5})?$ ]] || return 1
            validate_ipv4 "${r%%:*}" || return 1
            [[ "$r" == *:* ]] && { validate_single_port "${r##*:}" || return 1; }
            return 0
            ;;
        *) return 1 ;;
    esac
}

count_tunnels_of_mode() {
    local want="$1" skip="${2:-}" n=0 f m nm
    shopt -s nullglob
    for f in "$INSTANCES_DIR"/*.conf; do
        nm=$(conf_get_field "$f" "Name")
        [[ "$nm" == "$skip" ]] && continue
        m=$(conf_get_field "$f" "TunnelMode")
        [[ "$m" == "$want" ]] && n=$((n + 1))
    done
    shopt -u nullglob
    echo "$n"
}

stream_loop_port() {
    local base="$1" sb="${2:-10}"
    [[ "$sb" =~ ^[0-9]+$ ]] || sb=10
    (( sb < 1 )) && sb=10
    echo $((base + (sb % 400)))
}

hex64_file() {
    local v
    [[ -s "$1" ]] || return 1
    v=$(tr -d '\r\n ' < "$1")
    [[ "$v" =~ ^[0-9a-fA-F]{64}$ ]]
}

hex_file_min() {
    local v
    [[ -s "$1" ]] || return 1
    v=$(tr -d '\r\n ' < "$1")
    [[ "$v" =~ ^[0-9a-fA-F]{16,128}$ ]]
}

icmpint_file() {
    local v
    [[ -s "$1" ]] || return 1
    v=$(tr -d '\r\n ' < "$1")
    [[ "$v" =~ ^[0-9]+$ ]] && (( 10#$v >= 1 && 10#$v <= 2147483647 ))
}

ensure_go_compiler() {
    command -v go >/dev/null 2>&1 && return 0
    log_note "Installing Go to build dnstt..."
    jojonet_pkg_install golang-go golang || true
    command -v go >/dev/null 2>&1 || { log_error "Go compiler is required to build dnstt"; return 1; }
}

install_dnstt_binaries() {
    if [[ -x "$DNSTT_SERVER_BIN" && -x "$DNSTT_CLIENT_BIN" ]]; then
        return 0
    fi
    ensure_go_compiler || return 1
    local tmp goproxy
    tmp=$(mktemp -d /tmp/jojonet-dnstt.XXXXXX) || return 1
    goproxy="${GOPROXY:-https://proxy.golang.org,https://goproxy.io,https://goproxy.cn,direct}"
    log_note "Building dnstt ${DNSTT_VERSION} (Go module, checksum database)..."
    if ! env GOPROXY="$goproxy" GO111MODULE=on GOSUMDB="${GOSUMDB:-sum.golang.org}" GOPATH="$tmp" GOBIN="$tmp/bin" \
        GOCACHE="$tmp/cache" \
        go install "${DNSTT_GOMOD}/dnstt-server@${DNSTT_VERSION}" \
        "${DNSTT_GOMOD}/dnstt-client@${DNSTT_VERSION}" >&2; then
        rm -rf "$tmp"
        log_error "Failed to build dnstt ${DNSTT_VERSION}. Check outbound HTTPS to a Go module proxy."
        return 1
    fi
    if [[ ! -x "$tmp/bin/dnstt-server" || ! -x "$tmp/bin/dnstt-client" ]]; then
        rm -rf "$tmp"
        log_error "dnstt binaries missing after go install"
        return 1
    fi
    install -m755 "$tmp/bin/dnstt-server" "$DNSTT_SERVER_BIN"
    install -m755 "$tmp/bin/dnstt-client" "$DNSTT_CLIENT_BIN"
    rm -rf "$tmp"
    log_info "dnstt installed: $DNSTT_SERVER_BIN + $DNSTT_CLIENT_BIN ($DNSTT_VERSION)"
}

detect_pingtunnel_asset() {
    case "$(uname -m)" in
        x86_64|amd64) echo "pingtunnel_linux_amd64.zip ${PINGTUNNEL_SHA256_AMD64}" ;;
        aarch64|arm64) echo "pingtunnel_linux_arm64.zip ${PINGTUNNEL_SHA256_ARM64}" ;;
        *) return 1 ;;
    esac
}

install_pingtunnel_binary() {
    [[ -x "$PINGTUNNEL_BIN" ]] && return 0
    local spec asset want tmpdir got
    spec=$(detect_pingtunnel_asset) || { log_error "Unsupported CPU for pingtunnel: $(uname -m)"; return 1; }
    asset="${spec%% *}"
    want="${spec#* }"
    ensure_unzip || return 1
    tmpdir=$(mktemp -d /tmp/jojonet-icmp.XXXXXX) || return 1
    log_note "Downloading pingtunnel ${PINGTUNNEL_VERSION} ($asset)..."
    if ! download_external_asset \
        "https://github.com/esrrhs/pingtunnel/releases/download/${PINGTUNNEL_VERSION}/${asset}" \
        "$tmpdir/$asset"; then
        rm -rf "$tmpdir"
        log_error "Failed to download pingtunnel ${PINGTUNNEL_VERSION}"
        return 1
    fi
    got=$(sha256_of "$tmpdir/$asset")
    if [[ "${got,,}" != "${want,,}" ]]; then
        rm -rf "$tmpdir"
        log_error "pingtunnel checksum mismatch"
        log_error "  expected: $want"
        log_error "  actual:   $got"
        return 1
    fi
    if ! unzip -o -q "$tmpdir/$asset" pingtunnel -d "$tmpdir" || [[ ! -f "$tmpdir/pingtunnel" ]]; then
        rm -rf "$tmpdir"
        log_error "pingtunnel binary missing in $asset"
        return 1
    fi
    install -m755 "$tmpdir/pingtunnel" "$PINGTUNNEL_BIN"
    rm -rf "$tmpdir"
    log_info "pingtunnel installed: $PINGTUNNEL_BIN (${PINGTUNNEL_VERSION})"
}

ensure_dnstt_keys() {
    local pair_id="$1" peer_ip="${2:-}"
    local keydir="$KEYS_ROOT/pair_${pair_id}"
    install -d -m700 "$keydir"
    if [[ ! -s "$keydir/dnstt.priv" && -n "$peer_ip" ]]; then
        peer_pull_key "$peer_ip" "dnstt.priv" "$keydir/dnstt.priv" || true
        peer_pull_key "$peer_ip" "dnstt.pub" "$keydir/dnstt.pub" || true
        peer_pull_key "$peer_ip" "dnstt.auth" "$keydir/dnstt.auth" || true
    fi
    if ! hex64_file "$keydir/dnstt.priv" || ! hex64_file "$keydir/dnstt.pub"; then
        [[ -x "$DNSTT_SERVER_BIN" ]] || { log_error "dnstt-server missing for keygen"; return 1; }
        rm -f "$keydir/dnstt.priv" "$keydir/dnstt.pub"
        (umask 077 && "$DNSTT_SERVER_BIN" -gen-key -privkey-file "$keydir/dnstt.priv" -pubkey-file "$keydir/dnstt.pub") \
            >/dev/null || { log_error "dnstt-server -gen-key failed"; return 1; }
        hex64_file "$keydir/dnstt.priv" && hex64_file "$keydir/dnstt.pub" || {
            log_error "dnstt produced invalid keys"
            return 1
        }
        chmod 600 "$keydir/dnstt.priv" "$keydir/dnstt.pub"
        if [[ -n "$peer_ip" ]]; then
            peer_push_key "$peer_ip" "$keydir/dnstt.priv" "dnstt.priv" || true
            peer_push_key "$peer_ip" "$keydir/dnstt.pub" "dnstt.pub" || true
        fi
    fi
    if ! hex_file_min "$keydir/dnstt.auth"; then
        ensure_shared_secret "$pair_id" "$peer_ip" dnstt.auth "DNSTT SOCKS" hex >/dev/null || return 1
    fi
    printf '%s' "$keydir"
}

ensure_icmp_keys() {
    local pair_id="$1" peer_ip="${2:-}"
    local keydi
    keydir=$(ensure_shared_secret "$pair_id" "$peer_ip" pingtunnel.key "ICMP" icmpint) || return 1
    ensure_shared_secret "$pair_id" "$peer_ip" pingtunnel.encrypt "ICMP encrypt" hex >/dev/null || return 1
    printf '%s' "$keydir"
}

ensure_dnstt_firewall() {
    local role="$1" dns_port="$2" ports="${3:-}" item p
    local -a open_udp=() open_tcp=() plist=()
    if [[ "$role" == "kharej" ]]; then
        open_udp+=(53)
        [[ "$dns_port" != "53" ]] && open_udp+=("$dns_port")
    elif [[ "$role" == "iran" ]]; then
        IFS=',' read -ra plist <<< "$ports"
        for item in "${plist[@]}"; do
            open_tcp+=("${item%%:*}")
        done
    fi
    if command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -qi 'Status: active'; then
        for p in "${open_udp[@]+"${open_udp[@]}"}"; do
            ufw allow "${p}/udp" comment "jojonet-dnstt-${p}" >/dev/null 2>&1 || true
        done
        for p in "${open_tcp[@]+"${open_tcp[@]}"}"; do
            ufw allow "${p}/tcp" comment "jojonet-dnstt-${p}" >/dev/null 2>&1 || true
        done
    fi
    if command -v firewall-cmd >/dev/null 2>&1 && firewall-cmd --state 2>/dev/null | grep -qi running; then
        for p in "${open_udp[@]+"${open_udp[@]}"}"; do
            firewall-cmd --permanent --add-port="${p}/udp" >/dev/null 2>&1 || true
        done
        for p in "${open_tcp[@]+"${open_tcp[@]}"}"; do
            firewall-cmd --permanent --add-port="${p}/tcp" >/dev/null 2>&1 || true
        done
        firewall-cmd --reload >/dev/null 2>&1 || true
    fi
    return 0
}

ensure_icmp_firewall() {
    local role="$1" ports="${2:-}" item p
    [[ "$role" == "iran" ]] || return 0
    local -a open_tcp=() plist=()
    IFS=',' read -ra plist <<< "$ports"
    for item in "${plist[@]}"; do
        open_tcp+=("${item%%:*}")
    done
    if command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -qi 'Status: active'; then
        for p in "${open_tcp[@]+"${open_tcp[@]}"}"; do
            ufw allow "${p}/tcp" comment "jojonet-icmp-${p}" >/dev/null 2>&1 || true
        done
    fi
    if command -v firewall-cmd >/dev/null 2>&1 && firewall-cmd --state 2>/dev/null | grep -qi running; then
        for p in "${open_tcp[@]+"${open_tcp[@]}"}"; do
            firewall-cmd --permanent --add-port="${p}/tcp" >/dev/null 2>&1 || true
        done
        firewall-cmd --reload >/dev/null 2>&1 || true
    fi
    return 0
}

create_stream_runner_script() {
    if ! cat << 'EOF' > "$STREAM_RUNNER"
#!/usr/bin/env bash
set -Eeuo pipefail

_JOJONET_CONF_KEYS="Name TunnelMode Role Local_IP Remote_IP Subnet_Byte Tun_IP Tun_Remote_IP_Raw Tun_Server_IP Tun_Client_IP Suggested_MTU Ports TcpPort KeyDir GreKey PaqetYaml ForwardProto VxlanVni VxlanPort WgPrivateKey WgPublicKey WgPeerPublicKey HyYaml HyAuth HySni HyHopRange HyHopInterval HyTlsMode HyDomain HyAcmeEmail HyCertPath HyKeyPath RatholeToml WstunnelCmd WgObfs ObfsPort V6Iface V6Local V6Remote XrayJson XrayNet DnsDomain DnsResolver DnsMode"

load_safe_config() {
    local file="$1" line key val
    Name="" TunnelMode="gre" Role="" Local_IP="" Remote_IP="" Subnet_Byte=""
    Tun_IP="" Tun_Remote_IP_Raw="" Tun_Server_IP="" Tun_Client_IP=""
    Suggested_MTU="" Ports="" TcpPort="" KeyDir="" GreKey=""
    PaqetYaml="" ForwardProto="" VxlanVni="" VxlanPort=""
    WgPrivateKey="" WgPublicKey="" WgPeerPublicKey="" HyYaml="" HyAuth="" HySni="" HyHopRange="" HyHopInterval="" HyTlsMode="" HyDomain="" HyAcmeEmail="" HyCertPath="" HyKeyPath="" RatholeToml="" WstunnelCmd="" WgObfs="" ObfsPort="" V6Iface="" V6Local="" V6Remote="" XrayJson="" XrayNet="" DnsDomain="" DnsResolver="" DnsMode=""
    [[ -r "$file" ]] || return 1
    while IFS= read -r line || [[ -n "$line" ]]; do
        line="${line%%#*}"
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"
        [[ -z "$line" ]] && continue
        [[ "$line" =~ ^([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]] || return 1
        key="${BASH_REMATCH[1]}"
        val="${BASH_REMATCH[2]}"
        case " ${_JOJONET_CONF_KEYS} " in *" $key "*) ;; *) return 1 ;; esac
        if [[ "$val" =~ ^\"(.*)\"$ ]]; then val="${BASH_REMATCH[1]}"
        elif [[ "$val" =~ ^\'(.*)\'$ ]]; then val="${BASH_REMATCH[1]}"; fi
        case "$val" in *'$('*|*'`'*|*';'*|*'|'*|*'&'*|*$'\n'*|*$'\r'*) return 1 ;; esac
        printf -v "$key" '%s' "$val"
    done < "$file"
    [[ -n "${Name:-}" ]] || return 1
    return 0
}

ACTION="${1:-}"
CONFIG_FILE="${2:-}"
[[ -n "$CONFIG_FILE" && -f "$CONFIG_FILE" ]] || { echo "Config missing" >&2; exit 1; }
load_safe_config "$CONFIG_FILE" || { echo "Bad config" >&2; exit 1; }

RUN_DIR="/run/jojonet"
PID_DIR="${RUN_DIR}/${Name}"
GOST_BIN="/usr/local/bin/gost"
DNSTT_SERVER_BIN="/usr/local/bin/dnstt-server"
DNSTT_CLIENT_BIN="/usr/local/bin/dnstt-client"
PINGTUNNEL_BIN="/usr/local/bin/pingtunnel"
ICMP_ECHO_SAVE="${PID_DIR}/icmp_echo_ignore_all"
DNS_TAG="jojonet-dnstt-${Name}"
PIDS=()

log() { echo "[jojonet-stream:${Name}] $*"; }

valid_port() { [[ "${1:-}" =~ ^[0-9]+$ ]] && (( 10#$1 >= 1 && 10#$1 <= 65535 )); }

read_hex() {
    local v
    v=$(tr -d '\r\n ' < "$1")
    [[ "$v" =~ ^[0-9a-fA-F]{16,128}$ ]] || return 1
    printf '%s' "$v"
}

read_icmp_key() {
    local v
    v=$(tr -d '\r\n ' < "$1")
    [[ "$v" =~ ^[0-9]+$ ]] && (( 10#$v >= 1 && 10#$v <= 2147483647 )) || return 1
    printf '%s' "$v"
}

loop_port() {
    local base="$1" sb="${Subnet_Byte:-10}"
    [[ "$sb" =~ ^[0-9]+$ ]] || sb=10
    (( sb < 1 )) && sb=10
    echo $((base + (sb % 400)))
}

kill_pids() {
    local p
    for p in "${PIDS[@]+"${PIDS[@]}"}"; do
        [[ -n "$p" ]] || continue
        kill "$p" >/dev/null 2>&1 || true
        wait "$p" >/dev/null 2>&1 || true
    done
    PIDS=()
}

dns_nat_clear() {
    local port="${1:-}"
    command -v iptables >/dev/null 2>&1 || return 0
    valid_port "$port" || return 0
    while iptables -w -t nat -C PREROUTING -p udp --dport 53 -m comment --comment "$DNS_TAG" -j REDIRECT --to-ports "$port" >/dev/null 2>&1; do
        iptables -w -t nat -D PREROUTING -p udp --dport 53 -m comment --comment "$DNS_TAG" -j REDIRECT --to-ports "$port" >/dev/null 2>&1 || break
    done
}

dns_nat_add() {
    local port="$1"
    command -v iptables >/dev/null 2>&1 || { log "ERROR: iptables required to redirect UDP/53"; return 1; }
    iptables -w -t nat -C PREROUTING -p udp --dport 53 -m comment --comment "$DNS_TAG" -j REDIRECT --to-ports "$port" >/dev/null 2>&1 && return 0
    iptables -w -t nat -A PREROUTING -p udp --dport 53 -m comment --comment "$DNS_TAG" -j REDIRECT --to-ports "$port"
}

icmp_sysctl_restore() {
    local prev
    [[ -f "$ICMP_ECHO_SAVE" ]] || return 0
    prev=$(tr -d '\r\n ' < "$ICMP_ECHO_SAVE" || true)
    [[ "$prev" =~ ^[01]$ ]] || prev=0
    sysctl -w net.ipv4.icmp_echo_ignore_all="$prev" >/dev/null 2>&1 || true
    rm -f "$ICMP_ECHO_SAVE"
}

icmp_sysctl_apply() {
    local prev
    prev=$(sysctl -n net.ipv4.icmp_echo_ignore_all 2>/dev/null || echo 0)
    [[ "$prev" =~ ^[01]$ ]] || prev=0
    printf '%s\n' "$prev" > "$ICMP_ECHO_SAVE"
    sysctl -w net.ipv4.icmp_echo_ignore_all=1 >/dev/null 2>&1 || true
    sysctl -w net.ipv4.icmp_ratelimit=0 >/dev/null 2>&1 || true
    sysctl -w net.ipv4.icmp_msgs_per_sec=10000 >/dev/null 2>&1 || true
    sysctl -w net.ipv4.icmp_msgs_burst=1000 >/dev/null 2>&1 || true
}

gost_forwards() {
    local socks="$1" auth="$2" item l t
    local -a args=() plist=()
    [[ -x "$GOST_BIN" ]] || { log "ERROR: gost missing"; return 1; }
    IFS=',' read -ra plist <<< "${Ports:-}"
    (( ${#plist[@]} > 0 )) || { log "ERROR: no forward ports"; return 1; }
    for item in "${plist[@]}"; do
        [[ -n "$item" ]] || continue
        if [[ "$item" == *:* ]]; then
            l="${item%%:*}"
            t="${item##*:}"
        else
            l="$item"
            t="$item"
        fi
        valid_port "$l" && valid_port "$t" || { log "ERROR: bad port $item"; return 1; }
        args+=(-L "tcp://:${l}/127.0.0.1:${t}")
    done
    args+=(-F "socks5://jojonet:${auth}@127.0.0.1:${socks}")
    log "gost ${args[*]}"
    "$GOST_BIN" "${args[@]}" &
    PIDS+=($!)
}

cleanup() {
    kill_pids
    if [[ "${TunnelMode}" == "dnstt" && "${Role}" == "kharej" ]]; then
        dns_nat_clear "${TcpPort:-5300}"
    fi
    if [[ "${TunnelMode}" == "icmp" ]]; then
        icmp_sysctl_restore
    fi
}

start_dnstt() {
    local dns_port socks_port client_port auth domain mode resolve
    domain="${DnsDomain:-}"
    mode="${DnsMode:-doh}"
    resolver="${DnsResolver:-}"
    dns_port="${TcpPort:-5300}"
    [[ -n "$domain" ]] || { log "ERROR: DnsDomain missing"; return 1; }
    valid_port "$dns_port" || { log "ERROR: bad DNS port"; return 1; }
    [[ -s "$KeyDir/dnstt.priv" && -s "$KeyDir/dnstt.pub" ]] || { log "ERROR: dnstt keys missing"; return 1; }
    auth=$(read_hex "$KeyDir/dnstt.auth") || { log "ERROR: dnstt.auth missing"; return 1; }
    socks_port=$(loop_port 14000)
    client_port=$(loop_port 14400)
    if [[ "$Role" == "kharej" ]]; then
        [[ -x "$DNSTT_SERVER_BIN" ]] || { log "ERROR: dnstt-server missing"; return 1; }
        "$GOST_BIN" -L "socks5://jojonet:${auth}@127.0.0.1:${socks_port}" &
        PIDS+=($!)
        sleep 0.3
        "$DNSTT_SERVER_BIN" -udp ":${dns_port}" -privkey-file "$KeyDir/dnstt.priv" \
            -fallback 1.1.1.1:53 "$domain" "127.0.0.1:${socks_port}" &
        PIDS+=($!)
        if [[ "$dns_port" != "53" ]]; then
            dns_nat_add "$dns_port" || return 1
        fi
        log "dnstt-server UDP ${dns_port} domain=${domain} socks=127.0.0.1:${socks_port}"
    else
        [[ -x "$DNSTT_CLIENT_BIN" ]] || { log "ERROR: dnstt-client missing"; return 1; }
        case "$mode" in
            doh)
                [[ -n "$resolver" ]] || resolver="https://cloudflare-dns.com/dns-query"
                "$DNSTT_CLIENT_BIN" -doh "$resolver" -pubkey-file "$KeyDir/dnstt.pub" \
                    "$domain" "127.0.0.1:${client_port}" &
                ;;
            dot)
                [[ -n "$resolver" ]] || resolver="1.1.1.1:853"
                "$DNSTT_CLIENT_BIN" -dot "$resolver" -pubkey-file "$KeyDir/dnstt.pub" \
                    "$domain" "127.0.0.1:${client_port}" &
                ;;
            udp)
                [[ -n "$resolver" ]] || resolver="1.1.1.1:53"
                "$DNSTT_CLIENT_BIN" -udp "$resolver" -pubkey-file "$KeyDir/dnstt.pub" \
                    "$domain" "127.0.0.1:${client_port}" &
                ;;
            *)
                log "ERROR: bad DnsMode $mode"
                return 1
                ;;
        esac
        PIDS+=($!)
        sleep 0.4
        gost_forwards "$client_port" "$auth" || return 1
        log "dnstt-client ${mode} ${resolver} domain=${domain} local=127.0.0.1:${client_port}"
    fi
}

start_icmp() {
    local key enc socks_port json
    [[ -x "$PINGTUNNEL_BIN" ]] || { log "ERROR: pingtunnel missing"; return 1; }
    key=$(read_icmp_key "$KeyDir/pingtunnel.key") || { log "ERROR: pingtunnel.key missing"; return 1; }
    enc=$(read_hex "$KeyDir/pingtunnel.encrypt") || { log "ERROR: pingtunnel.encrypt missing"; return 1; }
    socks_port="${TcpPort:-$(loop_port 14800)}"
    valid_port "$socks_port" || { log "ERROR: bad SOCKS port"; return 1; }
    json="${PID_DIR}/pingtunnel.json"
    icmp_sysctl_apply
    if [[ "$Role" == "kharej" ]]; then
        printf '{"type":"server","key":%s,"encrypt":"chacha20","encrypt_key":"%s","nolog":1,"noprint":1,"loglevel":"error"}\n' \
            "$key" "$enc" > "$json"
        chmod 600 "$json"
        "$PINGTUNNEL_BIN" -c "$json" &
        PIDS+=($!)
        log "pingtunnel server (ChaCha20) ready"
    else
        [[ -n "$Remote_IP" ]] || { log "ERROR: Remote_IP missing"; return 1; }
        printf '{"type":"client","listen":"127.0.0.1:%s","server":"%s","sock5":1,"s5user":"jojonet","s5pass":"%s","key":%s,"encrypt":"chacha20","encrypt_key":"%s","nolog":1,"noprint":1,"loglevel":"error"}\n' \
            "$socks_port" "$Remote_IP" "$enc" "$key" "$enc" > "$json"
        chmod 600 "$json"
        "$PINGTUNNEL_BIN" -c "$json" &
        PIDS+=($!)
        sleep 0.4
        gost_forwards "$socks_port" "$enc" || return 1
        log "pingtunnel client SOCKS 127.0.0.1:${socks_port} -> ${Remote_IP}"
    fi
}

case "$ACTION" in
    start)
        install -d -m700 "$RUN_DIR" "$PID_DIR"
        trap cleanup EXIT INT TERM
        case "$TunnelMode" in
            dnstt) start_dnstt || exit 1 ;;
            icmp) start_icmp || exit 1 ;;
            *) log "ERROR: unsupported mode $TunnelMode"; exit 1 ;;
        esac
        (( ${#PIDS[@]} > 0 )) || { log "ERROR: no child processes"; exit 1; }
        log "SUCCESS: $TunnelMode $Role up (pids ${PIDS[*]})"
        wait -n || true
        log "child exited — stopping"
        exit 1
        ;;
    stop)
        shopt -s nullglob
        for f in "${PID_DIR}"/*.pid; do
            [[ -r "$f" ]] || continue
            kill "$(cat "$f")" >/dev/null 2>&1 || true
        done
        shopt -u nullglob
        if [[ -n "${KeyDir:-}" ]]; then
            pkill -f "dnstt-server .* ${KeyDir}/dnstt.priv" >/dev/null 2>&1 || true
            pkill -f "dnstt-client .* ${KeyDir}/dnstt.pub" >/dev/null 2>&1 || true
        fi
        pkill -f "pingtunnel -c ${PID_DIR}/pingtunnel.json" >/dev/null 2>&1 || true
        if [[ "$TunnelMode" == "dnstt" && "$Role" == "kharej" ]]; then
            dns_nat_clear "${TcpPort:-5300}"
        fi
        icmp_sysctl_restore
        exit 0
        ;;
    *)
        echo "Invalid action" >&2
        exit 1
        ;;
esac
EOF
    then
        return 1
    fi
    chmod +x "$STREAM_RUNNER"
}

create_stream_service() {
    local tmp_file
    tmp_file=$(mktemp /tmp/jojonet_stream_svc.XXXXXX) || return 1
    if ! cat << 'EOF' > "$tmp_file"
[Unit]
Description=JojoNet DNSTT/ICMP tunnel: %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Restart=always
RestartSec=5
LimitNOFILE=65535
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
StandardOutput=journal
StandardError=journal
SyslogIdentifier=jojonet-stream-%i
ExecStart=/usr/local/bin/jojonet-run-stream.sh start /etc/jojonet/instances/%i.conf
ExecStop=/usr/local/bin/jojonet-run-stream.sh stop /etc/jojonet/instances/%i.conf
TimeoutStartSec=90
TimeoutStopSec=30
KillMode=mixed

[Install]
WantedBy=multi-user.target
EOF
    then
        rm -f "$tmp_file"
        return 1
    fi
    if [[ -f "$STREAM_SERVICE" ]] && cmp -s "$tmp_file" "$STREAM_SERVICE"; then
        rm -f "$tmp_file"
    else
        mv -f "$tmp_file" "$STREAM_SERVICE" || { rm -f "$tmp_file"; return 1; }
        systemctl daemon-reload || return 1
    fi
}

stream_process_running() {
    local name="$1"
    pgrep -f "jojonet-run-stream.sh start /etc/jojonet/instances/${name}\\.conf" >/dev/null 2>&1 \
        || systemctl is-active --quiet "jojonet-stream@${name}.service" 2>/dev/null
}

show_direct_client_card() {
    local mode="$1" loc_ip="$2" key_dir="$3" domain="${4:-}" dns_mode="${5:-doh}" resolver="${6:-}"
    local pub="" auth="" key="" enc="" socks=1080 card=""
    [[ "$STEALTH_MODE" == "1" ]] && return 0
    echo ""
    echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${GREEN}  Direct Kharej — no Iran VPS${NC}"
    echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "  Users run the client on their own device. This server is the ${CYAN}only${NC} VPS."
    if [[ "$mode" == "dnstt" ]]; then
        [[ -s "$key_dir/dnstt.pub" ]] && pub=$(tr -d '\r\n ' < "$key_dir/dnstt.pub")
        [[ -s "$key_dir/dnstt.auth" ]] && auth=$(tr -d '\r\n ' < "$key_dir/dnstt.auth")
        [[ -n "$resolver" ]] || resolver="$DEFAULT_DNSTT_DOH"
        echo -e "  ${CYAN}NS:${NC}     ${domain}.  NS → this IP ${loc_ip}"
        echo -e "  ${CYAN}Pub:${NC}    ${pub}"
        echo -e "  ${CYAN}Client (PC/phone with dnstt-client):${NC}"
        echo -e "    printf '%s\\n' '${pub}' > dnstt.pub"
        echo -e "    dnstt-client -${dns_mode} ${resolver} -pubkey-file dnstt.pub ${domain} 127.0.0.1:${socks}"
        echo -e "  ${CYAN}Then SOCKS5${NC}  127.0.0.1:${socks}  user=${GREEN}jojonet${NC}  pass=${GREEN}${auth}${NC}"
        card="domain=${domain}
ns=${loc_ip}
mode=${dns_mode}
resolver=${resolver}
pubkey=${pub}
socks=127.0.0.1:${socks}
socks_user=jojonet
socks_pass=${auth}
"
    else
        [[ -s "$key_dir/pingtunnel.key" ]] && key=$(tr -d '\r\n ' < "$key_dir/pingtunnel.key")
        [[ -s "$key_dir/pingtunnel.encrypt" ]] && enc=$(tr -d '\r\n ' < "$key_dir/pingtunnel.encrypt")
        echo -e "  ${CYAN}Server:${NC} ${loc_ip}  (ICMP echo + ChaCha20)"
        echo -e "  ${CYAN}Client:${NC}"
        echo -e "    pingtunnel -type client -l 127.0.0.1:${socks} -s ${loc_ip} -sock5 1 \\"
        echo -e "      -s5user jojonet -s5pass ${enc} -key ${key} -encrypt chacha20 -encrypt-key ${enc}"
        echo -e "  ${CYAN}Then SOCKS5${NC}  127.0.0.1:${socks}  user=${GREEN}jojonet${NC}  pass=${GREEN}${enc}${NC}"
        card="server=${loc_ip}
key=${key}
encrypt_key=${enc}
socks=127.0.0.1:${socks}
socks_user=jojonet
socks_pass=${enc}
"
    fi
    install -d -m700 "$JOJONET_ROOT/direct"
    printf '%s' "$card" > "$JOJONET_ROOT/direct/${mode}.txt"
    chmod 600 "$JOJONET_ROOT/direct/${mode}.txt"
    echo -e "  ${CYAN}Saved:${NC}  $JOJONET_ROOT/direct/${mode}.txt"
    echo ""
}

