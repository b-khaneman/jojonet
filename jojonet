# Human-readable tunnel mode label
tunnel_mode_label() {
    case "${1:-gre}" in
        gre)           printf '%s' "GRE" ;;
        tun_tcp)       printf '%s' "TUN/TCP" ;;
        paqet)         printf '%s' "Paqet" ;;
        vxlan)         printf '%s' "VXLAN" ;;
        wireguard|wg)
            case "${WgObfs:-}" in
                icmp) printf '%s' "WireGuard/ICMP" ;;
                faketcp) printf '%s' "WireGuard/FakeTCP" ;;
                *) printf '%s' "WireGuard" ;;
            esac
            ;;
        hysteria2|hy2) printf '%s' "Hysteria2" ;;
        rathole|rh)    printf '%s' "Rathole Reverse" ;;
        wstunnel|ws)   printf '%s' "Wstunnel Reverse" ;;
        dokodemo)      printf '%s' "Xray Dokodemo-door" ;;
        xray_reverse)  printf '%s' "Xray Reverse" ;;
        sit)           printf '%s' "6to4 (SIT IPv6)" ;;
        gre6)          printf '%s' "GRE6 over 6to4" ;;
        ipip6)         printf '%s' "IPIP6 over 6to4" ;;
        dnstt)         printf '%s' "DNSTT (DNS tunnel)" ;;
        icmp)          printf '%s' "ICMP (pingtunnel)" ;;
        *)             printf '%s' "${1:-?}" ;;
    esac
}

# UP / DOWN / FAIL for a tunnel instance name
tunnel_status_word() {
    local name="$1" svc=""
    svc=$(tunnel_service_unit "$name")
    if systemctl is-active --quiet "$svc" 2>/dev/null; then
        printf '%s' "UP"
    elif systemctl is-failed --quiet "$svc" 2>/dev/null; then
        printf '%s' "FAIL"
    else
        printf '%s' "DOWN"
    fi
}

tunnel_status_colored() {
    local name="$1" st
    st=$(tunnel_status_word "$name")
    case "$st" in
        UP)   echo -e "${GREEN}${st}${NC}" ;;
        FAIL) echo -e "${RED}${st}${NC}" ;;
        *)    echo -e "${YELLOW}${st}${NC}" ;;
    esac
}

tunnel_role_label() {
    case "${1:-}" in
        iran)   printf '%s' "Iran" ;;
        kharej) printf '%s' "Kharej" ;;
        *)      printf '%s' "${1:-?}" ;;
    esac
}

# Resolve public IPs by country (independent of which server you are on)
resolve_iran_foreign_ips() {
    if [[ "${Role:-}" == "iran" ]]; then
        TUNNEL_IRAN_IP="${Local_IP:-?}"
        TUNNEL_KHAREJ_IP="${Remote_IP:-?}"
    else
        TUNNEL_IRAN_IP="${Remote_IP:-?}"
        TUNNEL_KHAREJ_IP="${Local_IP:-?}"
    fi
}

# Colored country tag for display
tunnel_country_tag() {
    case "${1:-}" in
        iran|Iran|ایران)
            echo -e "${GREEN}[Iran/ایران]${NC}"
            ;;
        kharej|Kharej|خارج)
            echo -e "${MAGENTA}[Kharej/خارج]${NC}"
            ;;
        *)
            echo -e "${YELLOW}[?]${NC}"
            ;;
    esac
}

# Overlay tunnel IPs labeled by country
tunnel_overlay_iran_foreign() {
    local iran_tun="" kharej_tun=""
    case "${Role:-}" in
        iran)
            iran_tun=$(echo "${Tun_IP:-}" | awk -F'/' '{print $1}')
            kharej_tun="${Tun_Remote_IP_Raw:-${Tun_Server_IP:-?}}"
            ;;
        kharej)
            kharej_tun=$(echo "${Tun_IP:-}" | awk -F'/' '{print $1}')
            iran_tun="${Tun_Client_IP:-?}"
            ;;
    esac
    if [[ -n "$iran_tun" && -n "$kharej_tun" ]]; then
        printf 'overlay %s (Iran/ایران) ↔ %s (Kharej/خارج)' "$iran_tun" "$kharej_tun"
    fi
}
# Overlay / port summary for a loaded instance config
tunnel_endpoint_summary() {
    local mode="${TunnelMode:-gre}" extra="" overlay=""
    case "$mode" in
        gre|vxlan|wireguard|tun_tcp|gre6|ipip6)
            overlay=$(tunnel_overlay_iran_foreign)
            [[ -n "$overlay" ]] && extra="$overlay"
            ;;
        sit)
            extra="IPv6 ${V6Local%%/*} ↔ ${V6Remote:-?}"
            ;;
        dokodemo|xray_reverse)
            extra="VLESS/${XrayNet:-tcp} control TCP ${TcpPort:-?}"
            ;;
        dnstt)
            extra="DNS ${DnsDomain:-?} ${DnsMode:-doh}"
            ;;
        icmp)
            extra="ICMP echo ChaCha20"
            ;;
        paqet)
            extra="KCP port ${TcpPort:-?}"
            [[ -n "${Ports:-}" ]] && extra="${extra} | forward ${Ports}"
            ;;
        hysteria2)
            extra="UDP ${TcpPort:-?}"
            [[ -n "${Ports:-}" ]] && extra="${extra} | forward ${Ports}"
            ;;
    esac
    case "$mode" in
        vxlan)
            [[ -n "${VxlanVni:-}" ]] && extra="${extra:+$extra | }VNI ${VxlanVni}"
            [[ -n "${VxlanPort:-}" ]] && extra="${extra:+$extra | }UDP ${VxlanPort}"
            ;;
        wireguard)
            [[ -n "${TcpPort:-}" ]] && extra="${extra:+$extra | }WG UDP ${TcpPort}"
            [[ -n "${WgObfs:-}" ]] && extra="${extra:+$extra | }over ${WgObfs} (udp2raw)"
            ;;
    esac
    printf '%s' "$extra"
}

# One-line description with explicit Iran / Kharej labels on both public IPs
format_tunnel_map_line() {
    local mode_l st st_c extra fwd="" iran_ip kharej_ip
    mode_l=$(tunnel_mode_label "${TunnelMode:-gre}")
    resolve_iran_foreign_ips
    iran_ip="$TUNNEL_IRAN_IP"
    kharej_ip="$TUNNEL_KHAREJ_IP"
    st=$(tunnel_status_word "$Name")
    case "$st" in
        UP)   st_c="${GREEN}${st}${NC}" ;;
        FAIL) st_c="${RED}${st}${NC}" ;;
        *)    st_c="${YELLOW}${st}${NC}" ;;
    esac
    extra=$(tunnel_endpoint_summary)
    [[ -n "${Ports:-}" && "${TunnelMode:-gre}" != "paqet" && "${TunnelMode:-gre}" != "hysteria2" ]] && \
        fwd=" | forward ${Ports}" || true
    echo -e "  ${st_c}  $(tunnel_country_tag iran) ${CYAN}${iran_ip}${NC}  ──${YELLOW}[${mode_l}]${NC}──►  $(tunnel_country_tag kharej) ${CYAN}${kharej_ip}${NC}"
    [[ -n "$extra$fwd" ]] && echo -e "         ${extra}${fwd}" || true
}

# Print all configured tunnels (detail: 0=compact header+lines, 1=full cards)
list_all_tunnels() {
    local detail="${1:-0}"
    shopt -s nullglob
    local files=("$INSTANCES_DIR"/*.conf)
    shopt -u nullglob

    if (( ${#files[@]} == 0 )); then
        echo -e "${YELLOW}[!] No tunnels configured.${NC}"
        return 0
    fi

    echo -e "\n${CYAN}=== Tunnel Map (${#files[@]} configured) ===${NC}"
    local file idx=0 total_up=0
    local Name="" TunnelMode="" Role="" Local_IP="" Remote_IP="" Subnet_Byte=""
    local Tun_IP="" Tun_Remote_IP_Raw="" Tun_Server_IP="" Tun_Client_IP=""
    local Suggested_MTU="" Ports="" TcpPort="" KeyDir="" GreKey=""
    local PaqetYaml="" ForwardProto="" VxlanVni="" VxlanPort=""
    local WgPrivateKey="" WgPublicKey="" WgPeerPublicKey="" HyYaml="" HyAuth="" HySni="" HyHopRange="" HyHopInterval="" HyTlsMode="" HyDomain="" HyAcmeEmail="" HyCertPath="" HyKeyPath="" RatholeToml="" WstunnelCmd="" WgObfs="" ObfsPort="" V6Iface="" V6Local="" V6Remote="" XrayJson="" XrayNet="" DnsDomain="" DnsResolver="" DnsMode=""

    for file in "${files[@]}"; do
        idx=$((idx + 1))
        if ! load_instance_config "$file"; then
            echo -e "  ${RED}[!] Invalid config: $(basename "$file")${NC}"
            continue
        fi
        [[ "$(tunnel_status_word "$Name")" == "UP" ]] && total_up=$((total_up + 1)) || true

        if (( detail == 0 )); then
            echo -e "${BLUE}#${idx} ${Name}${NC}"
            format_tunnel_map_line
        else
            show_tunnel_detail_card "$idx"
        fi
        echo ""
    done

    echo -e "${CYAN}Summary:${NC} ${GREEN}${total_up}${NC}/${#files[@]} active"
    return 0
}

list_all_tunnels_json() {
    shopt -s nullglob
    local files=("$INSTANCES_DIR"/*.conf)
    shopt -u nullglob
    local file first=1 unit status boot_json
    local Name="" TunnelMode="" Role="" Local_IP="" Remote_IP="" Subnet_Byte=""
    local Tun_IP="" Tun_Remote_IP_Raw="" Tun_Server_IP="" Tun_Client_IP=""
    local Suggested_MTU="" Ports="" TcpPort="" KeyDir="" GreKey=""
    local PaqetYaml="" ForwardProto="" VxlanVni="" VxlanPort=""
    local WgPrivateKey="" WgPublicKey="" WgPeerPublicKey="" HyYaml="" HyAuth="" HySni="" HyHopRange="" HyHopInterval="" HyTlsMode="" HyDomain="" HyAcmeEmail="" HyCertPath="" HyKeyPath="" RatholeToml="" WstunnelCmd="" WgObfs="" ObfsPort="" V6Iface="" V6Local="" V6Remote="" XrayJson="" XrayNet="" DnsDomain="" DnsResolver="" DnsMode=""

    printf '['
    for file in "${files[@]}"; do
        if ! load_instance_config "$file"; then
            continue
        fi
        [[ -n "${Name:-}" ]] || continue
        unit=$(tunnel_service_unit "$Name")
        status=$(tunnel_status_word "$Name")
        if tunnel_boot_enabled "$Name"; then boot_json=true; else boot_json=false; fi
        (( first )) || printf ','
        first=0
        printf '\n  {"name":%s,"mode":%s,"role":%s,"local_ip":%s,"remote_ip":%s,"status":%s,"boot":%s,"unit":%s}' \
            "$(json_string "${Name}")" \
            "$(json_string "${TunnelMode:-gre}")" \
            "$(json_string "${Role:-}")" \
            "$(json_string "${Local_IP:-}")" \
            "$(json_string "${Remote_IP:-}")" \
            "$(json_string "${status}")" \
            "$boot_json" \
            "$(json_string "${unit}")"
    done
    if (( first )); then
        printf ']\n'
    else
        printf '\n]\n'
    fi
    return 0
}

show_tunnel_detail_card() {
    local num="${1:-?}"
    local mode_l svc boot mode="${TunnelMode:-gre}" st st_c
    mode_l=$(tunnel_mode_label "$mode")
    svc=$(tunnel_service_unit "$Name")
    st=$(tunnel_status_word "$Name")
    case "$st" in
        UP)   st_c="${GREEN}${st}${NC}" ;;
        FAIL) st_c="${RED}${st}${NC}" ;;
        *)    st_c="${YELLOW}${st}${NC}" ;;
    esac

    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${BLUE}#${num} ${Name}${NC}  |  ${st_c}  |  ${YELLOW}${mode_l}${NC}"
    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    resolve_iran_foreign_ips
    echo -e "  ${GREEN}Iran / ایران:${NC}     ${CYAN}${TUNNEL_IRAN_IP}${NC}  $(tunnel_country_tag iran)"
    echo -e "  ${GREEN}Kharej / خارج:${NC}    ${CYAN}${TUNNEL_KHAREJ_IP}${NC}  $(tunnel_country_tag kharej)"
    echo -e "  ${GREEN}This server:${NC}      ${CYAN}${Local_IP:-?}${NC}  ($(tunnel_role_label "${Role:-}"))"
    echo -e "  ${GREEN}Method:${NC}           ${YELLOW}${mode_l}${NC} (${mode})"

    case "$mode" in
        gre)
            echo -e "  ${GREEN}GRE:${NC}             plain (no key)"
            echo -e "  ${GREEN}Overlay:${NC}          ${Tun_Client_IP:-?} (Iran) ↔ ${Tun_Server_IP:-?} (Kharej)"
            ;;
        tun_tcp)
            echo -e "  ${GREEN}TCP port:${NC}         ${TcpPort:-?}"
            echo -e "  ${GREEN}Private IP:${NC}       ${Tun_Server_IP:-?} (Kharej) ↔ ${Tun_Client_IP:-?} (Iran)"
            echo -e "  ${GREEN}Local TUN:${NC}        ${Tun_IP:-?} ($(tunnel_role_label "${Role:-}"))"
            ;;
        paqet)
            echo -e "  ${GREEN}Port:${NC}         ${TcpPort:-?}  |  forward ${ForwardProto:-tcp}"
            [[ -n "${Ports:-}" ]] && echo -e "  ${GREEN}Forward:${NC}      ${Ports}" || true
            [[ -n "${PaqetYaml:-}" ]] && echo -e "  ${GREEN}Config:${NC}       ${PaqetYaml}" || true
            ;;
        vxlan)
            echo -e "  ${GREEN}VNI:${NC}              ${VxlanVni:-?}  |  UDP ${VxlanPort:-?}"
            echo -e "  ${GREEN}Overlay:${NC}          ${Tun_Client_IP:-?} (Iran) ↔ ${Tun_Server_IP:-?} (Kharej)"
            ;;
        wireguard)
            echo -e "  ${GREEN}WG port:${NC}          UDP ${TcpPort:-?}"
            [[ -n "${WgObfs:-}" ]] && echo -e "  ${GREEN}Carrier:${NC}          udp2raw ${WgObfs} (port ${ObfsPort:-?})"
            echo -e "  ${GREEN}Overlay:${NC}          ${Tun_Client_IP:-?} (Iran) ↔ ${Tun_Server_IP:-?} (Kharej)"
            ;;
        hysteria2)
            if [[ -n "${HyHopRange:-}" ]]; then
                echo -e "  ${GREEN}Hop Port:${NC}    ${HyHopRange} every ${HyHopInterval:-$DEFAULT_HY2_HOP_INTERVAL}"
            else
                echo -e "  ${GREEN}UDP port:${NC}     ${TcpPort:-?}  |  SNI ${HySni:-${DEFAULT_HY2_SNI}}"
            fi
            echo -e "  ${GREEN}SNI:${NC}         ${HySni:-${DEFAULT_HY2_SNI}}"
            echo -e "  ${GREEN}TLS:${NC}         ${HyTlsMode:-insecure}${HyDomain:+  (domain ${HyDomain})}"
            [[ -n "${Ports:-}" ]] && echo -e "  ${GREEN}Forward:${NC}      ${Ports}" || true
            [[ -n "${HyYaml:-}" ]] && echo -e "  ${GREEN}Config:${NC}       ${HyYaml}" || true
            ;;
        rathole)
            echo -e "  ${GREEN}Control:${NC}     TCP ${TcpPort:-?} (Kharej → Iran dial)"
            echo -e "  ${GREEN}Side:${NC}        $([[ "${Role:-}" == "iran" ]] && echo "SERVER (Iran)" || echo "CLIENT (Kharej)")"
            [[ -n "${Ports:-}" ]] && echo -e "  ${GREEN}Forward:${NC}     ${Ports}" || true
            [[ -n "${RatholeToml:-}" ]] && echo -e "  ${GREEN}Config:${NC}      ${RatholeToml}" || true
            ;;
        dokodemo|xray_reverse)
            echo -e "  ${GREEN}Control:${NC}     TCP ${TcpPort:-?} ($(xray_ctrl_listener "$mode" "${Role:-}" && echo "listens here" || echo "dials ${Remote_IP:-?}"))"
            echo -e "  ${GREEN}Transport:${NC}   VLESS/${XrayNet:-tcp}"
            [[ -n "${Ports:-}" ]] && echo -e "  ${GREEN}Forward:${NC}     ${Ports}  (Iran LISTEN:TARGET → Kharej 127.0.0.1)" || true
            [[ -n "${XrayJson:-}" ]] && echo -e "  ${GREEN}Config:${NC}      ${XrayJson}" || true
            ;;
        dnstt)
            echo -e "  ${GREEN}Domain:${NC}      ${DnsDomain:-?}"
            echo -e "  ${GREEN}Resolver:${NC}    ${DnsMode:-doh} ${DnsResolver:-}"
            echo -e "  ${GREEN}DNS UDP:${NC}     ${TcpPort:-5300}  ($([[ "${Role:-}" == "kharej" ]] && echo 'server NS' || echo client))"
            [[ -n "${Ports:-}" ]] && echo -e "  ${GREEN}Forward:${NC}     ${Ports}  (Iran LISTEN:TARGET → Kharej 127.0.0.1)" || true
            ;;
        icmp)
            echo -e "  ${GREEN}Carrier:${NC}     ICMP echo + ChaCha20 (pingtunnel)"
            echo -e "  ${GREEN}Side:${NC}        $([[ "${Role:-}" == "kharej" ]] && echo SERVER || echo CLIENT)"
            [[ -n "${Ports:-}" ]] && echo -e "  ${GREEN}Forward:${NC}     ${Ports}  (Iran LISTEN:TARGET → Kharej 127.0.0.1)" || true
            ;;
        sit|gre6|ipip6)
            echo -e "  ${GREEN}SIT:${NC}         ${V6Iface:-$Name}  ${V6Local:-?} ↔ ${V6Remote:-?}"
            [[ "$mode" != "sit" ]] && echo -e "  ${GREEN}Overlay:${NC}     ${Tun_Client_IP:-?} (Iran) ↔ ${Tun_Server_IP:-?} (Kharej)" || true
            ;;
    esac

    [[ -n "${Ports:-}" && "$mode" != "paqet" && "$mode" != "hysteria2" && "$mode" != "rathole" && "$mode" != "wstunnel" && \
        "$mode" != "dokodemo" && "$mode" != "xray_reverse" && "$mode" != "dnstt" && "$mode" != "icmp" ]] && \
        echo -e "  ${GREEN}Port forward:${NC}   ${Ports} → Kharej tunnel IP" || true
    echo -e "  ${GREEN}MTU:${NC}          ${Suggested_MTU:-default}"
    echo -e "  ${GREEN}Subnet ID:${NC}    ${Subnet_Byte:-?}"
    echo -e "  ${GREEN}Service:${NC}      ${svc}"
    if tunnel_boot_enabled "$Name"; then
        echo -e "  ${GREEN}Boot:${NC}         enabled"
    else
        echo -e "  ${GREEN}Boot:${NC}         ${YELLOW}disabled${NC}"
    fi
    [[ -n "${KeyDir:-}" ]] && echo -e "  ${GREEN}Keys:${NC}         ${KeyDir}" || true
    local peer_ping="${Tun_Remote_IP_Raw:-}"
    [[ -z "$peer_ping" && "$Role" == "kharej" ]] && peer_ping="${Tun_Client_IP:-}"
    [[ -n "$peer_ping" ]] && echo -e "  ${GREEN}Ping test:${NC}     ping ${peer_ping}  (peer overlay on this link)" || true
}

show_tunnel_overview_menu() {
