        fwd_port="${JOJONET_FWD_PORTS:-$DEFAULT_XRAY_FWD}"
    else
        read -r -p "Transport tcp/ws/grpc (same on both servers) [$net]: " _nt
        net=${_nt:-$net}
        read -r -p "Control port (same on both servers) [$ctrl_port]: " _cp
        ctrl_port=${_cp:-$ctrl_port}
        read -r -p "Kharej service ports, e.g. 443,2053 or 8443:443 [$DEFAULT_XRAY_FWD]: " _fp
        fwd_port=${_fp:-$DEFAULT_XRAY_FWD}
    fi
    net=$(printf '%s' "$net" | tr '[:upper:]' '[:lower:]')
    if ! valid_xray_net "$net"; then
        echo -e "${RED}[!] Invalid transport: $net (tcp|ws|grpc)${NC}"
        sleep 2; set -e; return 1
    fi
    if ! validate_single_port "$ctrl_port"; then
        echo -e "${RED}[!] Invalid control port.${NC}"
        sleep 2; set -e; return 1
    fi
    ctrl_port=$((10#$ctrl_port))
    fwd_port=$(xray_normalize_ports "$fwd_port") || { sleep 2; set -e; return 1; }
    if [[ "$role_conf" == "iran" ]]; then
        fwd_port=$(xray_plan_iran_ports "$fwd_port" "$ctrl_port") || { sleep 2; set -e; return 1; }
    fi

    pair_id=$(printf '%s' "$rem_ip" | tr '.' '_')
    key_dir=$(ensure_shared_secret "$pair_id" "$rem_ip" xray.uuid "Xray" uuid) || { set -e; return 1; }

    echo -e "\n${CYAN}--- Xray plan ---${NC}"
    echo -e "  Name:      $ins_name"
    echo -e "  Mode:      $(tunnel_mode_label "$mode")"
    echo -e "  Role:      $role_conf"
    echo -e "  Peer:      $rem_ip"
    echo -e "  Transport: VLESS over $net"
    echo -e "  Control:   TCP $ctrl_port ($(xray_ctrl_listener "$mode" "$role_conf" && echo "listens here" || echo "dials peer"))"
    echo -e "  Forward:   $fwd_port"
    echo -e "  UUID:      $key_dir/xray.uuid"
    if [[ "$role_conf" == "iran" ]]; then
        hint "Now run on Kharej: sudo jojonet $(tunnel_cli_flag "$mode") $loc_ip"
    else
        hint "Kharej services must listen on 127.0.0.1 (or all) for the target ports"
        hint "Now run on Iran: sudo jojonet $(tunnel_cli_flag "$mode") $loc_ip"
    fi
    echo ""

    if XRAY_NET="$net" deploy_tunnel "$ins_name" "$role_conf" "$loc_ip" "$rem_ip" "0" \
        "" "" "0" "$fwd_port" "$mode" "$ctrl_port" "$key_dir" "" "" "tcp"; then
        echo -e "${GREEN}[+] $(tunnel_mode_label "$mode") [$ins_name] is up.${NC}"
        sleep 2
        set -e
        return 0
    fi
    sleep 3
    set -e
    return 1
}

tunnel_cli_flag() {
    case "${1:-}" in
        dokodemo) echo "--dokodemo" ;;
        xray_reverse) echo "--xray-reverse" ;;
        sit) echo "--6to4" ;;
        gre6) echo "--gre6" ;;
        ipip6) echo "--ipip6" ;;
        dnstt) echo "--dnstt" ;;
        icmp) echo "--icmp" ;;
        *) echo "--${1:-gre}" ;;
    esac
}

# Sets V6_IFACE V6_LOCAL V6_REMOTE V6_TUN_IP V6_TUN_REMOTE V6_SB V6_SERVER V6_CLIENT V6_MTU
v6_plan() {
    local name="$1" role="$2" loc="$3" rem="$4" mode="$5" h hx prefix
    h=$(compute_gre_key "$loc" "$rem")
    hx=$(printf '%04x:%04x' $(( (h >> 16) & 0xffff )) $(( h & 0xffff )))
    if [[ "$role" == "kharej" ]]; then
        V6_LOCAL="fd6a:${hx}::1/64"
        V6_REMOTE="fd6a:${hx}::2"
    else
        V6_LOCAL="fd6a:${hx}::2/64"
        V6_REMOTE="fd6a:${hx}::1"
    fi
    V6_TUN_IP="" V6_TUN_REMOTE="" V6_SB="" V6_SERVER="" V6_CLIENT=""
    if [[ "$mode" == "sit" ]]; then
        V6_IFACE="$name"
        V6_MTU="$DEFAULT_SIT_MTU"
        return 0
    fi
    if (( ${#name} > 13 )); then
        V6_IFACE="6s${name: -13}"
    else
        V6_IFACE="6s${name}"
    fi
    V6_SB=$(compute_pair_subnet_byte "$loc" "$rem")
    prefix=$(tunnel_net_prefix_for_mode "$mode")
    V6_SERVER="${prefix}.${V6_SB}.1"
    V6_CLIENT="${prefix}.${V6_SB}.2"
    if [[ "$role" == "kharej" ]]; then
        V6_TUN_IP="${V6_SERVER}/30"
    else
        V6_TUN_IP="${V6_CLIENT}/30"
        V6_TUN_REMOTE="$V6_SERVER"
    fi
    V6_MTU="$DEFAULT_V6_OVERLAY_MTU"
}

# One SIT underlay per IPv4 pair: only one 6to4/GRE6/IPIP6 tunnel per peer.
v6_tunnel_for_peer() {
    local peer="$1" m n
    for m in sit gre6 ipip6; do
        if n=$(find_tunnel_for_peer "$peer" "$m"); then
            printf '%s %s' "$n" "$m"
            return 0
        fi
    done
    return 1
}

create_v6_runner_script() {
    if ! cat << 'EOF' > "$V6_RUNNER"
#!/usr/bin/env bash
set -Euo pipefail

_JOJONET_CONF_KEYS="Name TunnelMode Role Local_IP Remote_IP Subnet_Byte Tun_IP Tun_Remote_IP_Raw Tun_Server_IP Tun_Client_IP Suggested_MTU Ports TcpPort KeyDir GreKey PaqetYaml ForwardProto VxlanVni VxlanPort WgPrivateKey WgPublicKey WgPeerPublicKey HyYaml HyAuth HySni HyHopRange HyHopInterval HyTlsMode HyDomain HyAcmeEmail HyCertPath HyKeyPath RatholeToml WstunnelCmd WgObfs ObfsPort V6Iface V6Local V6Remote XrayJson XrayNet DnsDomain DnsResolver DnsMode"

load_safe_config() {
    local file="$1" line key val
    Name="" TunnelMode="gre" Role="" Local_IP="" Remote_IP="" Subnet_Byte=""
    Tun_IP="" Tun_Remote_IP_Raw="" Tun_Server_IP="" Tun_Client_IP=""
    Suggested_MTU="" Ports="" TcpPort="" KeyDir="" GreKey=""
    PaqetYaml="" ForwardProto="" VxlanVni="" VxlanPort=""
    WgPrivateKey="" WgPublicKey="" WgPeerPublicKey="" HyYaml="" HyAuth="" HySni="" HyHopRange="" HyHopInterval="" HyTlsMode="" HyDomain="" HyAcmeEmail="" HyCertPath="" HyKeyPath="" RatholeToml="" WstunnelCmd="" WgObfs="" ObfsPort="" V6Iface="" V6Local="" V6Remote="" XrayJson="" XrayNet="" DnsDomain="" DnsResolver="" DnsMode=""
    [[ -r "$file" ]] || return 1
    while IFS= read -r line || [[ -n "$line" ]]; do
        line="${line%%#*}"
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"
        [[ -z "$line" ]] && continue
        [[ "$line" =~ ^([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]] || return 1
        key="${BASH_REMATCH[1]}"
        val="${BASH_REMATCH[2]}"
        case " ${_JOJONET_CONF_KEYS} " in *" $key "*) ;; *) return 1 ;; esac
        if [[ "$val" =~ ^\"(.*)\"$ ]]; then val="${BASH_REMATCH[1]}"
        elif [[ "$val" =~ ^\'(.*)\'$ ]]; then val="${BASH_REMATCH[1]}"; fi
        case "$val" in *'$('*|*'`'*|*';'*|*'|'*|*'&'*|*$'\n'*|*$'\r'*) return 1 ;; esac
        printf -v "$key" '%s' "$val"
    done < "$file"
    [[ -n "${Name:-}" ]] || return 1
    return 0
}

ACTION="${1:-}"
CONFIG_FILE="${2:-}"
[[ -n "$CONFIG_FILE" && -f "$CONFIG_FILE" ]] || { echo "Config missing" >&2; exit 1; }
load_safe_config "$CONFIG_FILE" || { echo "Bad config" >&2; exit 1; }
U="${V6Iface:-$Name}"

log() { echo "[jojonet-v6:${Name}] $*"; }

nat_rules() {
    local op="$1" p proto
    local -a plist=()
    [[ "$Role" == "iran" && "$TunnelMode" != "sit" && -n "$Tun_Remote_IP_Raw" ]] || return 0
    command -v iptables >/dev/null 2>&1 || { [[ "$op" == "add" ]] && return 1; return 0; }
    IFS=',' read -ra plist <<< "${Ports:-}"
    for p in "${plist[@]}"; do
        p="${p// /}"
        [[ "$p" =~ ^[0-9]+$ ]] || continue
        for proto in tcp udp; do
            if [[ "$op" == "add" ]]; then
                iptables -t nat -C PREROUTING -p "$proto" --dport "$p" -j DNAT --to-destination "${Tun_Remote_IP_Raw}:$p" 2>/dev/null || \
                    iptables -t nat -A PREROUTING -p "$proto" --dport "$p" -j DNAT --to-destination "${Tun_Remote_IP_Raw}:$p" || return 1
            else
                while iptables -t nat -D PREROUTING -p "$proto" --dport "$p" -j DNAT --to-destination "${Tun_Remote_IP_Raw}:$p" 2>/dev/null; do :; done
            fi
        done
    done
    if [[ "$op" == "add" ]]; then
        iptables -t nat -C POSTROUTING -o "$Name" -j MASQUERADE 2>/dev/null || \
            iptables -t nat -A POSTROUTING -o "$Name" -j MASQUERADE || return 1
    else
        while iptables -t nat -D POSTROUTING -o "$Name" -j MASQUERADE 2>/dev/null; do :; done
    fi
    return 0
}

proto41_rule() {
    command -v iptables >/dev/null 2>&1 || return 0
    if [[ "$1" == "add" ]]; then
        iptables -C INPUT -s "$Remote_IP" -p 41 -j ACCEPT 2>/dev/null || \
            iptables -I INPUT -s "$Remote_IP" -p 41 -j ACCEPT 2>/dev/null || true
    else
        while iptables -D INPUT -s "$Remote_IP" -p 41 -j ACCEPT 2>/dev/null; do :; done
    fi
    return 0
}

cleanup() {
    nat_rules del || true
    proto41_rule del
    if [[ "$U" != "$Name" ]]; then
        ip link delete "$Name" >/dev/null 2>&1 || true
    fi
    ip link delete "$U" >/dev/null 2>&1 || true
}

fail() {
    log "ERROR: $*"
    cleanup
    exit 1
}

case "$ACTION" in
    start)
        case "$TunnelMode" in
            sit|gre6|ipip6) ;;
            *) fail "unsupported mode: $TunnelMode" ;;
        esac
        [[ -d /proc/sys/net/ipv6 ]] || fail "IPv6 is disabled in the kernel (ipv6.disable=1) — enable it and reboot"
        [[ -n "$V6Local" && -n "$V6Remote" ]] || fail "IPv6 addresses missing in config"
        mtu="${Suggested_MTU:-}"
        if [[ "$TunnelMode" == "sit" ]]; then
            [[ "$mtu" =~ ^[0-9]+$ ]] && (( mtu >= 1280 && mtu <= 1480 )) || mtu=1480
            umtu="$mtu"
        else
            [[ "$mtu" =~ ^[0-9]+$ ]] && (( mtu >= 576 && mtu <= 1440 )) || mtu=1420
            umtu=1480
        fi
        modprobe sit >/dev/null 2>&1 || true
        [[ "$TunnelMode" == "gre6" ]] && { modprobe ip6_gre >/dev/null 2>&1 || true; }
        [[ "$TunnelMode" == "ipip6" ]] && { modprobe ip6_tunnel >/dev/null 2>&1 || true; }
        cleanup

        log "ip tunnel add $U mode sit remote $Remote_IP local $Local_IP ttl 255"
        ip tunnel add "$U" mode sit remote "$Remote_IP" local "$Local_IP" ttl 255 \
            || fail "SIT creation failed (another SIT tunnel to $Remote_IP already exists?)"
        sysctl -w "net.ipv6.conf.${U}.disable_ipv6=0" >/dev/null 2>&1 || true
        ip link set "$U" mtu "$umtu" || fail "cannot set MTU on $U"
        ip link set "$U" up || fail "cannot bring $U up"
        ip -6 addr add "$V6Local" dev "$U" nodad || fail "cannot add $V6Local to $U (IPv6 disabled on this server?)"
        proto41_rule add

        if [[ "$TunnelMode" != "sit" ]]; then
            [[ -n "$Tun_IP" ]] || fail "overlay IPv4 missing in config"
            if [[ "$TunnelMode" == "gre6" ]]; then mode6="ip6gre"; else mode6="ipip6"; fi
            log "ip -6 tunnel add $Name mode $mode6 remote $V6Remote local ${V6Local%%/*}"
            ip -6 tunnel add "$Name" mode "$mode6" remote "$V6Remote" local "${V6Local%%/*}" \
                hoplimit 255 encaplimit none || fail "$mode6 creation failed"
            ip addr add "$Tun_IP" dev "$Name" || fail "cannot add $Tun_IP to $Name"
            ip link set "$Name" mtu "$mtu" || fail "cannot set MTU on $Name"
            ip link set "$Name" up || fail "cannot bring $Name up"
            sysctl -w "net.ipv4.conf.${Name}.rp_filter=0" >/dev/null 2>&1 || true
            sysctl -w net.ipv4.conf.all.rp_filter=0 >/dev/null 2>&1 || true
            if [[ "$Role" == "iran" ]]; then
                sysctl -w net.ipv4.ip_forward=1 >/dev/null 2>&1 || true
                nat_rules add || fail "iptables DNAT/MASQUERADE failed (is iptables installed?)"
            fi
        fi
        log "SUCCESS: $TunnelMode $Name up (IPv6 ${V6Local} ↔ ${V6Remote}${Tun_IP:+, IPv4 $Tun_IP})"
        ;;
    stop)
        log "Stopping..."
        cleanup
        exit 0
        ;;
    *)
        echo "Invalid action: $ACTION" >&2
        exit 1
        ;;
esac
EOF
    then
        return 1
    fi
    chmod +x "$V6_RUNNER"
}

create_v6_service() {
    local tmp_file
    tmp_file=$(mktemp /tmp/jojonet_v6_svc.XXXXXX) || return 1
    if ! cat << 'EOF' > "$tmp_file"
[Unit]
Description=JojoNet IPv6 Tunnel (6to4/GRE6/IPIP6): %i
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal
SyslogIdentifier=jojonet-v6-%i
ExecStart=/usr/local/bin/jojonet-run-v6.sh start /etc/jojonet/instances/%i.conf
ExecStop=/usr/local/bin/jojonet-run-v6.sh stop /etc/jojonet/instances/%i.conf
TimeoutStartSec=60
TimeoutStopSec=30
