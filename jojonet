    while IFS= read -r line || [[ -n "$line" ]]; do
        line="${line%%#*}"
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"
        [[ -z "$line" ]] && continue
        [[ "$line" =~ ^([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]] || return 1
        key="${BASH_REMATCH[1]}"
        val="${BASH_REMATCH[2]}"
        case " ${_JOJONET_CONF_KEYS} " in *" $key "*) ;; *) return 1 ;; esac
        if [[ "$val" =~ ^\"(.*)\"$ ]]; then val="${BASH_REMATCH[1]}"
        elif [[ "$val" =~ ^\'(.*)\'$ ]]; then val="${BASH_REMATCH[1]}"; fi
        case "$val" in *'$('*|*'`'*|*';'*|*'|'*|*'&'*|*$'\n'*|*$'\r'*) return 1 ;; esac
        printf -v "$key" '%s' "$val"
    done < "$file"
    [[ -n "${Name:-}" ]] || return 1
    return 0
}

ACTION="${1:-}"
CONFIG_FILE="${2:-}"
WSTUNNEL_BIN="/usr/local/bin/wstunnel"

[[ -n "$CONFIG_FILE" && -f "$CONFIG_FILE" ]] || { echo "Config missing" >&2; exit 1; }
load_safe_config "$CONFIG_FILE" || { echo "Bad config" >&2; exit 1; }
cmdsh="${WstunnelCmd:-}"

stop_ws() {
    pkill -f "wstunnel.*${cmdsh}" >/dev/null 2>&1 || true
    pkill -f "wstunnel .*/${Name}\\.cmd.sh" >/dev/null 2>&1 || true
    pkill -f "bash.*${Name}\\.cmd.sh" >/dev/null 2>&1 || true
}

case "$ACTION" in
    start)
        stop_ws
        [[ -x "$WSTUNNEL_BIN" ]] || { echo "wstunnel binary missing" >&2; exit 1; }
        [[ -f "$cmdsh" ]] || { echo "cmd script missing: $cmdsh" >&2; exit 1; }
        echo "[jojonet-wstunnel:${Name}] Starting ($Role) $cmdsh"
        exec bash "$cmdsh"
        ;;
    stop)
        stop_ws
        exit 0
        ;;
    *)
        echo "Invalid action" >&2
        exit 1
        ;;
esac
EOF
    then
        return 1
    fi
    chmod +x "$WSTUNNEL_RUNNER"
}

