relay_firewall() {
    local op="$1" ports="$2" proto="$3" item l p
    local -a protos=() plist=()
    case "$proto" in tcp) protos=(tcp) ;; udp) protos=(udp) ;; *) protos=(tcp udp) ;; esac
    command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -qi 'Status: active' || return 0
    IFS=',' read -ra plist <<< "$ports"
    for item in "${plist[@]}"; do
        l="${item%%:*}"
        for p in "${protos[@]}"; do
            if [[ "$op" == "add" ]]; then
                ufw allow "${l}/${p}" comment "jojonet-relay" >/dev/null 2>&1 || true
            else
                ufw --force delete allow "${l}/${p}" >/dev/null 2>&1 || true
            fi
        done
    done
    return 0
}

# relay_add ENGINE TARGET PORTS [PROTO] [NAME]
relay_add() {
    local engine="${1:-}" target="${2:-}" ports="${3:-}" proto="${4:-}" name="${5:-}"
    local conf tmp unit item l api="" r0 r1
    local Name="" Engine="" Target="" Ports="" Proto="" ApiPort=""
    engine=$(printf '%s' "$engine" | tr '[:upper:]' '[:lower:]')
    valid_relay_engine "$engine" || { log_error "Engine must be iptables|gost|haproxy|socat|xray"; return 1; }
    target="${target// /}"
    if [[ "$engine" == "iptables" ]]; then
        validate_ipv4 "$target" || { log_error "iptables relay needs an IPv4 destination"; return 1; }
    else
        valid_relay_target "$target" || { log_error "Invalid destination (IPv4 or domain): $target"; return 1; }
    fi
    proto=$(printf '%s' "${proto:-}" | tr '[:upper:]' '[:lower:]')
    [[ -n "$proto" ]] || { [[ "$engine" == "haproxy" ]] && proto="tcp" || proto="both"; }
    [[ "$proto" =~ ^(tcp|udp|both)$ ]] || { log_error "Protocol must be tcp|udp|both"; return 1; }
    [[ "$engine" == "haproxy" && "$proto" != "tcp" ]] && { log_error "HAProxy relays TCP only"; return 1; }
    ports=$(xray_normalize_ports "$ports") || return 1
    [[ -n "$name" ]] || name="${engine}-${ports%%[:,]*}"
    name=$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]')
    valid_relay_name "$name" || { log_error "Relay name: a-z 0-9 - (max 24): $name"; return 1; }
    conf="$RELAY_DIR/$name.conf"
    [[ -e "$conf" ]] && { log_error "Relay [$name] already exists"; return 1; }
    for item in ${ports//,/ }; do
        l="${item%%:*}"
        if xray_port_busy "$l"; then
            log_error "Port $l is already used on this server"
            return 1
        fi
    done

    case "$engine" in
        iptables)
            command -v iptables >/dev/null 2>&1 || jojonet_pkg_install iptables || true
            command -v iptables >/dev/null 2>&1 || { log_error "iptables is required"; return 1; }
            ;;
        gost) install_gost_binary || return 1 ;;
        haproxy|socat)
            # Prefer local installs (/usr/local) used when apt mirrors are unreachable (common in Iran).
            if ! command -v "$engine" >/dev/null 2>&1; then
                for cand in "/usr/local/sbin/$engine" "/usr/local/bin/$engine" "/usr/sbin/$engine" "/usr/bin/$engine"; do
                    if [[ -x "$cand" ]]; then
                        export PATH="$(dirname "$cand"):$PATH"
                        break
                    fi
                done
            fi
            if ! command -v "$engine" >/dev/null 2>&1; then
                log_note "Installing $engine..."
                jojonet_pkg_install "$engine" || true
            fi
            if ! command -v "$engine" >/dev/null 2>&1; then
                log_error "$engine is required but not installed (apt/DNS failed)."
                log_error "Fix DNS (jojonet --dns 8.8.8.8 1.1.1.1) and apt, or use gost/xray relay instead."
                return 1
            fi
            if [[ "$engine" == "haproxy" ]] && systemctl is-enabled --quiet haproxy 2>/dev/null && \
                ! systemctl is-active --quiet haproxy 2>/dev/null; then
                systemctl disable haproxy >/dev/null 2>&1 || true
            fi
            ;;
        xray)
            install_xray_binary || return 1
            api=$(relay_alloc_api_port) || { log_error "No free local port for the Xray stats API"; return 1; }
            ;;
    esac

    install -d -m700 "$RELAY_DIR"
    create_relay_runner_script || return 1
    create_relay_service || return 1
    tmp="${conf}.tmp"
    {
        printf 'Name="%s"\nEngine="%s"\nTarget="%s"\nPorts="%s"\nProto="%s"\nApiPort="%s"\n' \
            "$name" "$engine" "$target" "$ports" "$proto" "$api"
    } > "$tmp" && chmod 600 "$tmp" && mv -f "$tmp" "$conf" || { rm -f "$tmp"; return 1; }

    unit=$(relay_unit "$name" "$engine")
    r0=$(systemctl show -p NRestarts --value "$unit" 2>/dev/null || echo 0)
    if ! systemctl enable --now "$unit" >/dev/null 2>&1; then
        log_error "Relay [$name] failed to start:"
        journalctl -u "$unit" -b --no-pager -n 15 2>/dev/null || true
        relay_remove "$name" >/dev/null 2>&1 || true
        return 1
    fi
    if [[ "$engine" != "iptables" ]]; then
        sleep 3
        r1=$(systemctl show -p NRestarts --value "$unit" 2>/dev/null || echo 0)
        if ! systemctl is-active --quiet "$unit" || [[ "${r1:-0}" != "${r0:-0}" ]]; then
            log_error "Relay [$name] is not running:"
            journalctl -u "$unit" -b --no-pager -n 15 2>/dev/null || true
            relay_remove "$name" >/dev/null 2>&1 || true
            return 1
        fi
    fi
    relay_firewall add "$ports" "$proto"
    log_info "Relay [$name] UP: $engine ${proto} ${ports} → ${target}"
    return 0
}

relay_remove() {
    local name="${1:-}" conf unit
    local Name="" Engine="" Target="" Ports="" Proto="" ApiPort=""
    valid_relay_name "$name" || { log_error "Invalid relay name: $name"; return 1; }
    conf="$RELAY_DIR/$name.conf"
    [[ -f "$conf" ]] || { log_error "Relay not found: $name"; return 1; }
    load_relay_config "$conf" || Engine=$(conf_get_field "$conf" "Engine")
    unit=$(relay_unit "$name" "${Engine:-}")
    systemctl disable --now "$unit" >/dev/null 2>&1 || true
    systemctl reset-failed "$unit" >/dev/null 2>&1 || true
    [[ -x "$RELAY_RUNNER" ]] && "$RELAY_RUNNER" stop "$conf" >/dev/null 2>&1 || true
    [[ -n "$Ports" ]] && relay_firewall del "$Ports" "${Proto:-both}"
    rm -f "$conf"
    log_info "Relay [$name] removed"
}

relay_list() {
    local f st n=0
    local Name="" Engine="" Target="" Ports="" Proto="" ApiPort=""
    shopt -s nullglob
    local files=("$RELAY_DIR"/*.conf)
    shopt -u nullglob
    echo -e "${CYAN}=== Relays (${#files[@]}) ===${NC}"
    for f in "${files[@]}"; do
        if ! load_relay_config "$f"; then
            echo -e "  ${RED}[!] Invalid relay config: $(basename "$f")${NC}"
            continue
        fi
        n=$((n + 1))
        if systemctl is-active --quiet "$(relay_unit "$Name" "$Engine")" 2>/dev/null; then
            st="${GREEN}UP${NC}"
        else
            st="${RED}DOWN${NC}"
        fi
        echo -e "  ${st}  ${BLUE}${Name}${NC}  ${YELLOW}${Engine}${NC}  ${Proto:-both}  ${Ports} → ${CYAN}${Target}${NC}"
    done
    (( n > 0 )) || echo -e "  ${YELLOW}No relays configured.${NC}"
    return 0
}

human_bytes() {
    awk -v b="${1:-0}" 'BEGIN { split("B KB MB GB TB", u, " "); i = 1; while (b >= 1024 && i < 5) { b /= 1024; i++ } printf "%.2f %s", b, u[i] }'
}

relay_stats() {
    local only="${1:-}" f item l up down out cnt
    local Name="" Engine="" Target="" Ports="" Proto="" ApiPort=""
    shopt -s nullglob
    local files=("$RELAY_DIR"/*.conf)
    shopt -u nullglob
    if [[ -n "$only" ]]; then
        valid_relay_name "$only" || { log_error "Invalid relay name: $only"; return 1; }
        [[ -f "$RELAY_DIR/$only.conf" ]] || { log_error "Relay not found: $only"; return 1; }
        files=("$RELAY_DIR/$only.conf")
    fi
    (( ${#files[@]} > 0 )) || { echo -e "${YELLOW}No relays configured.${NC}"; return 0; }
    for f in "${files[@]}"; do
        load_relay_config "$f" || continue
        echo -e "${CYAN}=== ${Name} (${Engine}) → ${Target} ===${NC}"
        case "$Engine" in
            xray)
                if ! out=$("$XRAY_BIN" api statsquery --server="127.0.0.1:${ApiPort}" 2>/dev/null); then
                    echo -e "  ${YELLOW}stats API not reachable (relay down?)${NC}"
                    continue
                fi
                for item in ${Ports//,/ }; do
                    l="${item%%:*}"
                    up=$(tr -d ' \n' <<< "$out" | grep -oE "\"name\":\"inbound>>>in-${l}>>>traffic>>>uplink\"(,\"value\":\"?[0-9]+)?" | grep -oE '[0-9]+$' || true)
                    down=$(tr -d ' \n' <<< "$out" | grep -oE "\"name\":\"inbound>>>in-${l}>>>traffic>>>downlink\"(,\"value\":\"?[0-9]+)?" | grep -oE '[0-9]+$' || true)
                    echo -e "  port ${l}: ↑ $(human_bytes "${up:-0}")  ↓ $(human_bytes "${down:-0}")"
                done
                ;;
            iptables)
                iptables -t nat -L PREROUTING -v -n -x 2>/dev/null | \
                    awk -v tag="jojonet-relay-${Name} " '
                        index($0, tag) {
                            d = "?"
                            for (i = 1; i <= NF; i++) if ($i ~ /^dpt:/) d = substr($i, 5)
                            printf "  %s port %s → %s: %s packets, %s bytes\n", $4, d, substr($NF, 4), $1, $2
                        }' || true
                ;;
            *)
                for item in ${Ports//,/ }; do
                    l="${item%%:*}"
                    cnt=$(ss -Htn state established "( sport = :${l} )" 2>/dev/null | wc -l || echo 0)
                    echo -e "  port ${l}: ${cnt} active TCP connection(s)"
                done
                ;;
        esac
    done
}

relay_menu() {
    local c="" e="" t="" p="" pr="" n=""
    while true; do
        clear_screen
        logo
        print_banner "Relays — single server (hiddify-relay style)"
        echo -e "  Users → ${GREEN}this server${NC}:port → main server:port (no JojoNet needed there)"
        echo ""
        relay_list
        echo ""
        menu_line "1) Add iptables relay (DNAT, fastest, TCP+UDP)"
        menu_line "2) Add GOST relay"
        menu_line "3) Add HAProxy relay (TCP)"
        menu_line "4) Add Socat relay"
        menu_line "5) Add Xray dokodemo relay (with traffic stats)"
        menu_line "6) Traffic / connection stats"
        menu_line "7) Remove relay"
        menu_line "0) Back"
        read -r -p "Choice: " c || return 0
        case "$c" in
            1|2|3|4|5)
                case "$c" in 1) e=iptables ;; 2) e=gost ;; 3) e=haproxy ;; 4) e=socat ;; 5) e=xray ;; esac
                read -r -p "Main server IP${e:+ (or domain)}: " t || continue
                read -r -p "Ports, e.g. 443,8443 or 2096:443: " p || continue
                pr=""
                if [[ "$e" != "haproxy" ]]; then
                    read -r -p "Protocol tcp/udp/both [both]: " pr || continue
                fi
                read -r -p "Name (optional): " n || continue
                relay_add "$e" "$t" "$p" "$pr" "$n" || true
                press_enter
                ;;
            6) relay_stats || true; press_enter ;;
            7)
                read -r -p "Relay name: " n || continue
                [[ -n "$n" ]] && relay_remove "$n" || true
                press_enter
                ;;
            0) return 0 ;;
            *) echo -e "${RED}Invalid.${NC}"; sleep 1 ;;
        esac
    done
}

