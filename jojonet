license_b64url_decode() {
    local s="$1" pad
    s="${s//-/+}"
    s="${s//_/\/}"
    case $(( ${#s} % 4 )) in
        2) s+="==" ;;
        3) s+="=" ;;
    esac
    printf '%s' "$s" | base64 -d 2>/dev/null
}

license_read_key() {
    local raw="$1" rest payload_b64 sig_b64
    raw="${raw#"${raw%%[![:space:]]*}"}"
    raw="${raw%"${raw##*[![:space:]]}"}"
    raw="${raw//$'\r'/}"
    [[ "$raw" == JN1.* ]] || return 1
    rest="${raw#JN1.}"
    payload_b64="${rest%%.*}"
    sig_b64="${rest#*.}"
    [[ -n "$payload_b64" && -n "$sig_b64" && "$sig_b64" != *.* ]] || return 1
    LICENSE_PAYLOAD="$(license_b64url_decode "$payload_b64" | tr -d '\n')" || return 1
    LICENSE_SIG_B64="$sig_b64"
    [[ -n "$LICENSE_PAYLOAD" && -n "$LICENSE_SIG_B64" ]] || return 1
    LICENSE_ID="$(sed -n 's/.*"id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' <<< "$LICENSE_PAYLOAD" | head -1)"
    LICENSE_EMAIL="$(sed -n 's/.*"email"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' <<< "$LICENSE_PAYLOAD" | head -1)"
    LICENSE_PLAN="$(sed -n 's/.*"plan"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' <<< "$LICENSE_PAYLOAD" | head -1)"
    LICENSE_EXP="$(sed -n 's/.*"exp"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' <<< "$LICENSE_PAYLOAD" | head -1)"
    [[ "$LICENSE_PLAN" == "monthly" && "$LICENSE_EXP" =~ ^[0-9]+$ && -n "$LICENSE_ID" ]]
}

license_verify_sig() {
    local tmp rc
    command -v openssl >/dev/null 2>&1 || return 1
    tmp="$(mktemp -d /tmp/jnlic.XXXXXX)" || return 1
    printf '%s\n' "$LICENSE_PUB_PEM" > "$tmp/pub.pem"
    printf '%s' "$LICENSE_PAYLOAD" > "$tmp/pay"
    license_b64url_decode "$LICENSE_SIG_B64" > "$tmp/sig" || { rm -rf "$tmp"; return 1; }
    openssl pkeyutl -verify -pubin -inkey "$tmp/pub.pem" -rawin -in "$tmp/pay" -sigfile "$tmp/sig" >/dev/null 2>&1
    rc=$?
    rm -rf "$tmp"
    return "$rc"
}

license_load() {
    local key=""
    LICENSE_PAYLOAD=""; LICENSE_SIG_B64=""; LICENSE_ID=""; LICENSE_EMAIL=""; LICENSE_PLAN=""; LICENSE_EXP=""
    [[ -r "$LICENSE_FILE" ]] || return 1
    key="$(tr -d '\r\n' < "$LICENSE_FILE")"
    license_read_key "$key" && license_verify_sig
