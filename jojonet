        [[ "$role_conf" == "iran" ]] && hint "Run on Kharej: sudo jojonet --wstunnel $loc_ip"
        sleep 2
        set -e
        return 0
    fi
    sleep 3
    set -e
    return 1
}


# ==========================================
# v1.6.0 — Xray tunnels (dokodemo-door / reverse) and IPv6 tunnels (6to4 SIT, GRE6, IPIP6)
# ==========================================

jojonet_pkg_install() {
    if command -v apt-get >/dev/null 2>&1; then
        timeout 90 env DEBIAN_FRONTEND=noninteractive apt-get install -y "$@" >/dev/null 2>&1 || \
            { timeout 90 apt-get update >/dev/null 2>&1 && timeout 90 env DEBIAN_FRONTEND=noninteractive apt-get install -y "$@" >/dev/null 2>&1; }
    elif command -v dnf >/dev/null 2>&1; then
        dnf install -y "$@" >/dev/null 2>&1
    elif command -v yum >/dev/null 2>&1; then
        yum install -y "$@" >/dev/null 2>&1
    else
        return 1
    fi
}

gen_uuid() {
    local u=""
    [[ -r /proc/sys/kernel/random/uuid ]] && u=$(tr -d '\r\n' < /proc/sys/kernel/random/uuid)
    if ! [[ "$u" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]]; then
        u=$(openssl rand -hex 16 2>/dev/null) || return 1
        [[ "$u" =~ ^[0-9a-f]{32}$ ]] || return 1
        u="${u:0:8}-${u:8:4}-4${u:13:3}-a${u:17:3}-${u:20:12}"
    fi
    printf '%s\n' "$u"
}

str_sha256() {
    if command -v sha256sum >/dev/null 2>&1; then
        printf '%s' "$1" | sha256sum | awk '{print $1}'
    else
        printf '%s' "$1" | openssl dgst -sha256 | awk '{print $NF}'
    fi
}

tcp_port_listening() {
    command -v ss >/dev/null 2>&1 || return 1
    ss -tlnH 2>/dev/null | awk -v p=":$1" '$4 ~ p"$" { found=1 } END { exit !found }'
}

xray_mode() { [[ "${1:-}" == "dokodemo" || "${1:-}" == "xray_reverse" ]]; }
v6_mode() { [[ "${1:-}" == "sit" || "${1:-}" == "gre6" || "${1:-}" == "ipip6" ]]; }
valid_xray_net() { [[ "${1:-}" == "tcp" || "${1:-}" == "ws" || "${1:-}" == "grpc" ]]; }

xray_default_ctrl_port() {
    if [[ "${1:-}" == "xray_reverse" ]]; then
        echo "$DEFAULT_XRAY_REVERSE_CTRL_PORT"
    else
        echo "$DEFAULT_XRAY_DOKO_CTRL_PORT"
    fi
}

# The side that listens on the control port: Kharej for dokodemo, Iran (portal) for reverse.
xray_ctrl_listener() {
    [[ "$1" == "dokodemo" && "$2" == "kharej" ]] || [[ "$1" == "xray_reverse" && "$2" == "iran" ]]
}

# Ports: "T" or "L:T" (Iran listens on L, Kharej target 127.0.0.1:T); 1-16 entries.
xray_normalize_ports() {
    local raw="${1// /}" item l t out="" seen_l="" n=0
    local -a plist=()
    [[ -n "$raw" ]] || { log_error "No forward ports given"; return 1; }
    IFS=',' read -ra plist <<< "$raw"
    for item in "${plist[@]}"; do
        [[ -n "$item" ]] || continue
        if [[ "$item" =~ ^([0-9]{1,5}):([0-9]{1,5})$ ]]; then
            l="${BASH_REMATCH[1]}"
            t="${BASH_REMATCH[2]}"
        elif [[ "$item" =~ ^[0-9]{1,5}$ ]]; then
            l=""
            t="$item"
        else
            log_error "Invalid port entry: $item (use PORT or LISTEN:TARGET)"
            return 1
        fi
        validate_single_port "$t" || { log_error "Invalid port: $t"; return 1; }
        t=$((10#$t))
        if [[ -n "$l" ]]; then
            validate_single_port "$l" || { log_error "Invalid port: $l"; return 1; }
            l=$((10#$l))
            item="${l}:${t}"
        else
            item="$t"
        fi
        case ",$out," in *",$item,"*) continue ;; esac
        if [[ -n "$l" ]]; then
            case ",$seen_l," in *",$l,"*) log_error "Listen port $l used twice"; return 1 ;; esac
            seen_l="${seen_l:+$seen_l,}$l"
        fi
        out="${out:+$out,}$item"
        n=$((n + 1))
    done
    if (( n < 1 || n > 16 )); then
        log_error "Xray tunnels need 1-16 forward ports (got $n)"
        return 1
    fi
    echo "$out"
}

valid_port_csv() {
    local p n=0
    local -a plist=()
    IFS=',' read -ra plist <<< "${1:-}"
    for p in "${plist[@]}"; do
        validate_single_port "$p" || return 1
        n=$((n + 1))
    done
    (( n >= 1 && n <= 32 ))
}

xray_port_busy() {
    iran_dnat_port_in_use "$1" && return 0
    tcp_port_listening "$1"
}

# Iran: pick a free listen port for every plain target port (target kept as-is).
xray_plan_iran_ports() {
    local list="$1" ctrl="${2:-}" item l t c used="" out=""
    local -a plist=()
    IFS=',' read -ra plist <<< "$list"
    for item in "${plist[@]}"; do
        if [[ "$item" == *:* ]]; then
            l="${item%%:*}"
            t="${item##*:}"
            xray_port_busy "$l" && log_warn "Iran listen port $l looks busy — Xray may fail to bind it"
        else
            t="$item"
            l=""
            for c in "$t" 8443 2053 2083 2096 8080 8444 4433 2087 8880; do
                [[ "$c" == "$ctrl" ]] && continue
                case ",$used," in *",$c,"*) continue ;; esac
                xray_port_busy "$c" && continue
                l="$c"
                break
            done
            [[ -n "$l" ]] || { log_error "No free Iran listen port for target $t — pass LISTEN:TARGET"; return 1; }
            [[ "$l" != "$t" ]] && log_warn "Iran port $t is busy — listening on $l (→ Kharej $t)"
        fi
        [[ "$l" == "$ctrl" ]] && { log_error "Listen port $l clashes with the control port"; return 1; }
        case ",$used," in *",$l,"*) log_error "Listen port $l used twice"; return 1 ;; esac
        used="${used:+$used,}$l"
        if [[ "$l" == "$t" ]]; then
            out="${out:+$out,}$t"
        else
            out="${out:+$out,}${l}:${t}"
        fi
    done
    echo "$out"
}

detect_xray_asset() {
    case "$(uname -m)" in
        x86_64|amd64) echo "Xray-linux-64.zip" ;;
        aarch64|arm64) echo "Xray-linux-arm64-v8a.zip" ;;
        armv7l|armv7*) echo "Xray-linux-arm32-v7a.zip" ;;
        *) return 1 ;;
    esac
}

xray_fetch() {
    if command -v curl >/dev/null 2>&1; then
        curl -fsSL --connect-timeout 15 --max-time 300 "$1" -o "$2"
    elif command -v wget >/dev/null 2>&1; then
        wget -q --timeout=60 -O "$2" "$1"
    else
        log_error "curl or wget required."
        return 1
    fi
}

ensure_unzip() {
    command -v unzip >/dev/null 2>&1 && return 0
    log_note "Installing unzip..."
    if ! jojonet_pkg_install unzip; then
        log_warn "unzip package install failed; retrying after apt/dnf update..."
        if command -v apt-get >/dev/null 2>&1; then
            timeout 120 apt-get update >/dev/null 2>&1 || true
            timeout 120 env DEBIAN_FRONTEND=noninteractive apt-get install -y unzip >/dev/null 2>&1 || true
        elif command -v dnf >/dev/null 2>&1; then
            dnf makecache >/dev/null 2>&1 || true
            dnf install -y unzip >/dev/null 2>&1 || true
        elif command -v yum >/dev/null 2>&1; then
            yum makecache >/dev/null 2>&1 || true
            yum install -y unzip >/dev/null 2>&1 || true
        fi
    fi
    command -v unzip >/dev/null 2>&1 || { log_error "unzip is required"; return 1; }
}

install_xray_binary() {
    [[ -x "$XRAY_BIN" ]] && return 0
    local asset tmpdir base want got ok=0
    asset=$(detect_xray_asset) || { log_error "Unsupported CPU for Xray: $(uname -m)"; return 1; }
    ensure_unzip || return 1
    tmpdir=$(mktemp -d /tmp/jojonet-xray.XXXXXX) || return 1
    log_note "Downloading Xray ${XRAY_VERSION} ($asset)..."
    for base in \
        "https://github.com/XTLS/Xray-core/releases/download/${XRAY_VERSION}" \
        "https://ghproxy.net/https://github.com/XTLS/Xray-core/releases/download/${XRAY_VERSION}" \
        "https://mirror.ghproxy.com/https://github.com/XTLS/Xray-core/releases/download/${XRAY_VERSION}"
    do
        echo -e "  ${CYAN}try${NC} $base/$asset" >&2
        rm -f "$tmpdir/$asset" "$tmpdir/$asset.dgst"
        xray_fetch "$base/$asset" "$tmpdir/$asset" || continue
        xray_fetch "$base/$asset.dgst" "$tmpdir/$asset.dgst" || continue
        want=$(awk '/^SHA2-256=/ { print tolower($NF); exit }' "$tmpdir/$asset.dgst")
        got=$(sha256_of "$tmpdir/$asset")
        if [[ "$want" =~ ^[0-9a-f]{64}$ && "$want" == "$got" ]]; then
            ok=1
            break
        fi
        log_warn "Xray checksum mismatch from $base"
    done
    if (( ok != 1 )); then
        rm -rf "$tmpdir"
        log_error "Failed to download a verified Xray ${XRAY_VERSION}"
        return 1
    fi
    if ! unzip -o -q "$tmpdir/$asset" xray -d "$tmpdir" || [[ ! -f "$tmpdir/xray" ]]; then
        rm -rf "$tmpdir"
        log_error "xray binary missing in $asset"
        return 1
    fi
    install -m755 "$tmpdir/xray" "$XRAY_BIN"
    rm -rf "$tmpdir"
    log_info "xray installed: $XRAY_BIN ($("$XRAY_BIN" version 2>/dev/null | head -1 || echo "$XRAY_VERSION"))"
}

xray_stream_json() {
    local net="$1" uuid="$2" h
    h=$(str_sha256 "jojonet-xray-${uuid}")
    case "$net" in
        ws) printf '{"network":"ws","wsSettings":{"path":"/%s"}}' "${h:0:16}" ;;
        grpc) printf '{"network":"grpc","grpcSettings":{"serviceName":"%s"}}' "${h:16:12}" ;;
        *) printf '{"network":"tcp"}' ;;
    esac
}

build_xray_runtime_config() {
    local name="$1" role="$2" mode="$3" rem="$4" ctrl="$5" keydir="$6" ports="$7" net="${8:-tcp}"
    local uuid stream domain h json tmp cfg inb="" tags="" item l t vless_in vless_out local_out
    local -a plist=()
    install -d -m700 "$XRAY_CONFIG_DIR"
    [[ -s "$keydir/xray.uuid" ]] || { log_error "Xray UUID missing: $keydir/xray.uuid"; return 1; }
    uuid=$(tr -d '\r\n ' < "$keydir/xray.uuid")
    [[ "$uuid" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]] || {
        log_error "Invalid Xray UUID in $keydir/xray.uuid"
        return 1
    }
    validate_single_port "$ctrl" || { log_error "Invalid Xray control port: $ctrl"; return 1; }
    valid_xray_net "$net" || { log_error "Invalid Xray transport: $net"; return 1; }
    stream=$(xray_stream_json "$net" "$uuid")
    h=$(str_sha256 "jojonet-reverse-${uuid}")
    domain="r${h:0:12}.jojonet.internal"
    json="$XRAY_CONFIG_DIR/${name}.json"
    if [[ "$role" == "iran" ]]; then
        IFS=',' read -ra plist <<< "$ports"
        for item in "${plist[@]}"; do
            l="${item%%:*}"
            t="${item##*:}"
            validate_single_port "$l" && validate_single_port "$t" || { log_error "Invalid port entry: $item"; return 1; }
            inb="${inb:+$inb,}{\"tag\":\"in-${l}\",\"listen\":\"0.0.0.0\",\"port\":${l},\"protocol\":\"dokodemo-door\",\"settings\":{\"address\":\"127.0.0.1\",\"port\":${t},\"network\":\"tcp,udp\"}}"
            tags="${tags:+$tags,}\"in-${l}\""
        done
        [[ -n "$inb" ]] || { log_error "Xray needs at least one forward port"; return 1; }
    fi
    vless_in="{\"tag\":\"tunnel\",\"listen\":\"0.0.0.0\",\"port\":${ctrl},\"protocol\":\"vless\",\"settings\":{\"clients\":[{\"id\":\"${uuid}\"}],\"decryption\":\"none\"},\"streamSettings\":${stream}}"
    vless_out="{\"tag\":\"tunnel\",\"protocol\":\"vless\",\"settings\":{\"vnext\":[{\"address\":\"${rem}\",\"port\":${ctrl},\"users\":[{\"id\":\"${uuid}\",\"encryption\":\"none\"}]}]},\"streamSettings\":${stream}}"
    local_out="{\"tag\":\"local\",\"protocol\":\"freedom\",\"settings\":{\"redirect\":\"127.0.0.1:0\"}}"
    case "${mode}:${role}" in
        dokodemo:iran)
            cfg="{\"log\":{\"loglevel\":\"warning\"},\"inbounds\":[${inb}],\"outbounds\":[${vless_out}],\"routing\":{\"rules\":[{\"type\":\"field\",\"inboundTag\":[${tags}],\"outboundTag\":\"tunnel\"}]}}"
            ;;
        dokodemo:kharej)
            cfg="{\"log\":{\"loglevel\":\"warning\"},\"inbounds\":[${vless_in}],\"outbounds\":[${local_out}]}"
            ;;
        xray_reverse:iran)
            cfg="{\"log\":{\"loglevel\":\"warning\"},\"reverse\":{\"portals\":[{\"tag\":\"portal\",\"domain\":\"${domain}\"}]},\"inbounds\":[${inb},${vless_in}],\"outbounds\":[{\"tag\":\"block\",\"protocol\":\"blackhole\"}],\"routing\":{\"rules\":[{\"type\":\"field\",\"inboundTag\":[${tags}],\"outboundTag\":\"portal\"},{\"type\":\"field\",\"inboundTag\":[\"tunnel\"],\"domain\":[\"full:${domain}\"],\"outboundTag\":\"portal\"},{\"type\":\"field\",\"inboundTag\":[\"tunnel\"],\"outboundTag\":\"block\"}]}}"
            ;;
        xray_reverse:kharej)
            cfg="{\"log\":{\"loglevel\":\"warning\"},\"reverse\":{\"bridges\":[{\"tag\":\"bridge\",\"domain\":\"${domain}\"}]},\"outbounds\":[${vless_out},${local_out}],\"routing\":{\"rules\":[{\"type\":\"field\",\"inboundTag\":[\"bridge\"],\"domain\":[\"full:${domain}\"],\"outboundTag\":\"tunnel\"},{\"type\":\"field\",\"inboundTag\":[\"bridge\"],\"outboundTag\":\"local\"}]}}"
            ;;
        *)
            log_error "Unknown Xray mode/role: ${mode}/${role}"
            return 1
            ;;
    esac
    tmp=$(mktemp --suffix=.json "$XRAY_CONFIG_DIR/.${name}.XXXXXX") || return 1
    printf '%s\n' "$cfg" > "$tmp"
    chmod 600 "$tmp"
    if [[ -x "$XRAY_BIN" ]] && ! "$XRAY_BIN" run -test -c "$tmp" >/dev/null 2>&1; then
        log_error "Xray rejected the generated config:"
        "$XRAY_BIN" run -test -c "$tmp" 2>&1 | tail -n 5 >&2 || true
        rm -f "$tmp"
        return 1
    fi
    mv -f "$tmp" "$json" || { rm -f "$tmp"; return 1; }
    echo "$json"
}

ensure_xray_firewall() {
    local role="$1" mode="$2" ctrl="$3" ports="${4:-}" item p
    local -a open_tcp=() plist=()
    xray_ctrl_listener "$mode" "$role" && open_tcp+=("$ctrl")
    if [[ "$role" == "iran" ]]; then
        IFS=',' read -ra plist <<< "$ports"
        for item in "${plist[@]}"; do
            open_tcp+=("${item%%:*}")
        done
    fi
    (( ${#open_tcp[@]} > 0 )) || return 0
    if command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -qi 'Status: active'; then
        for p in "${open_tcp[@]}"; do
            ufw allow "${p}/tcp" comment "jojonet-xray-${p}" >/dev/null 2>&1 || true
            [[ "$p" == "$ctrl" ]] || ufw allow "${p}/udp" comment "jojonet-xray-${p}" >/dev/null 2>&1 || true
        done
    fi
    if command -v firewall-cmd >/dev/null 2>&1 && firewall-cmd --state 2>/dev/null | grep -qi running; then
        for p in "${open_tcp[@]}"; do
            firewall-cmd --permanent --add-port="${p}/tcp" >/dev/null 2>&1 || true
            [[ "$p" == "$ctrl" ]] || firewall-cmd --permanent --add-port="${p}/udp" >/dev/null 2>&1 || true
        done
        firewall-cmd --reload >/dev/null 2>&1 || true
    fi
    return 0
}

create_xray_runner_script() {
    if ! cat << 'EOF' > "$XRAY_RUNNER"
#!/usr/bin/env bash
set -Eeuo pipefail

_JOJONET_CONF_KEYS="Name TunnelMode Role Local_IP Remote_IP Subnet_Byte Tun_IP Tun_Remote_IP_Raw Tun_Server_IP Tun_Client_IP Suggested_MTU Ports TcpPort KeyDir GreKey PaqetYaml ForwardProto VxlanVni VxlanPort WgPrivateKey WgPublicKey WgPeerPublicKey HyYaml HyAuth HySni HyHopRange HyHopInterval HyTlsMode HyDomain HyAcmeEmail HyCertPath HyKeyPath RatholeToml WstunnelCmd WgObfs ObfsPort V6Iface V6Local V6Remote XrayJson XrayNet DnsDomain DnsResolver DnsMode"

load_safe_config() {
    local file="$1" line key val
    Name="" TunnelMode="gre" Role="" Local_IP="" Remote_IP="" Subnet_Byte=""
    Tun_IP="" Tun_Remote_IP_Raw="" Tun_Server_IP="" Tun_Client_IP=""
    Suggested_MTU="" Ports="" TcpPort="" KeyDir="" GreKey=""
    PaqetYaml="" ForwardProto="" VxlanVni="" VxlanPort=""
    WgPrivateKey="" WgPublicKey="" WgPeerPublicKey="" HyYaml="" HyAuth="" HySni="" HyHopRange="" HyHopInterval="" HyTlsMode="" HyDomain="" HyAcmeEmail="" HyCertPath="" HyKeyPath="" RatholeToml="" WstunnelCmd="" WgObfs="" ObfsPort="" V6Iface="" V6Local="" V6Remote="" XrayJson="" XrayNet="" DnsDomain="" DnsResolver="" DnsMode=""
    [[ -r "$file" ]] || return 1
    while IFS= read -r line || [[ -n "$line" ]]; do
        line="${line%%#*}"
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"
        [[ -z "$line" ]] && continue
        [[ "$line" =~ ^([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]] || return 1
        key="${BASH_REMATCH[1]}"
        val="${BASH_REMATCH[2]}"
        case " ${_JOJONET_CONF_KEYS} " in *" $key "*) ;; *) return 1 ;; esac
        if [[ "$val" =~ ^\"(.*)\"$ ]]; then val="${BASH_REMATCH[1]}"
        elif [[ "$val" =~ ^\'(.*)\'$ ]]; then val="${BASH_REMATCH[1]}"; fi
        case "$val" in *'$('*|*'`'*|*';'*|*'|'*|*'&'*|*$'\n'*|*$'\r'*) return 1 ;; esac
        printf -v "$key" '%s' "$val"
    done < "$file"
    [[ -n "${Name:-}" ]] || return 1
    return 0
}

ACTION="${1:-}"
CONFIG_FILE="${2:-}"
XRAY_BIN="/usr/local/bin/xray"

[[ -n "$CONFIG_FILE" && -f "$CONFIG_FILE" ]] || { echo "Config missing" >&2; exit 1; }
load_safe_config "$CONFIG_FILE" || { echo "Bad config" >&2; exit 1; }
json="${XrayJson:-}"

case "$ACTION" in
    start)
        [[ -x "$XRAY_BIN" ]] || { echo "xray binary missing" >&2; exit 1; }
        [[ -n "$json" && -f "$json" ]] || { echo "xray config missing: $json" >&2; exit 1; }
        echo "[jojonet-xray:${Name}] Starting ${TunnelMode} (${Role}, ${XrayNet:-tcp}) $json"
        exec "$XRAY_BIN" run -c "$json"
        ;;
    stop)
        if [[ -n "$json" ]]; then
            pkill -f "xray run -c ${json}\$" >/dev/null 2>&1 || true
        fi
        exit 0
        ;;
    *)
        echo "Invalid action" >&2
        exit 1
        ;;
esac
EOF
    then
        return 1
    fi
    chmod +x "$XRAY_RUNNER"
}

