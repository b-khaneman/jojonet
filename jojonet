            [[ -n "${Ports:-}" ]] && echo -e "  ${GREEN}Forward:${NC}      ${Ports}" || true
            [[ -n "${HyYaml:-}" ]] && echo -e "  ${GREEN}Config:${NC}       ${HyYaml}" || true
            ;;
        rathole)
            echo -e "  ${GREEN}Control:${NC}     TCP ${TcpPort:-?} (Kharej → Iran dial)"
            echo -e "  ${GREEN}Side:${NC}        $([[ "${Role:-}" == "iran" ]] && echo "SERVER (Iran)" || echo "CLIENT (Kharej)")"
            [[ -n "${Ports:-}" ]] && echo -e "  ${GREEN}Forward:${NC}     ${Ports}" || true
            [[ -n "${RatholeToml:-}" ]] && echo -e "  ${GREEN}Config:${NC}      ${RatholeToml}" || true
            ;;
    esac

    [[ -n "${Ports:-}" && "$mode" != "paqet" && "$mode" != "hysteria2" && "$mode" != "rathole" && "$mode" != "wstunnel" ]] && \
        echo -e "  ${GREEN}Port forward:${NC}   ${Ports} → Kharej tunnel IP" || true
    echo -e "  ${GREEN}MTU:${NC}          ${Suggested_MTU:-default}"
    echo -e "  ${GREEN}Subnet ID:${NC}    ${Subnet_Byte:-?}"
    echo -e "  ${GREEN}Service:${NC}      ${svc}"
    if tunnel_boot_enabled "$Name"; then
        echo -e "  ${GREEN}Boot:${NC}         enabled"
    else
        echo -e "  ${GREEN}Boot:${NC}         ${YELLOW}disabled${NC}"
    fi
    [[ -n "${KeyDir:-}" ]] && echo -e "  ${GREEN}Keys:${NC}         ${KeyDir}" || true
    local peer_ping="${Tun_Remote_IP_Raw:-}"
    [[ -z "$peer_ping" && "$Role" == "kharej" ]] && peer_ping="${Tun_Client_IP:-}"
    [[ -n "$peer_ping" ]] && echo -e "  ${GREEN}Ping test:${NC}     ping ${peer_ping}  (peer overlay on this link)" || true
}

