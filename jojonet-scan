async def cmd_sni(args: argparse.Namespace) -> int:
    vantage = detect_vantage()
    print(f"JojoSNI — اسکنر SNI مخصوص Reality | JojoNet-scan {VERSION}")
    print(f"  از شبکه: {vantage.get('isp')}  AS{vantage.get('asn') or '?'}  IP={vantage.get('public_ip') or '?'}")
    print(f"  نکته: {vantage.get('note')}")
    domains = list(DEFAULT_SNI_LIST)
    if args.file:
        extra = Path(args.file).read_text(encoding="utf-8").splitlines()
        for line in extra:
            line = line.strip()
            if line and not line.startswith("#"):
                domains.append(line)
    # unique preserve order
    seen: set[str] = set()
    uniq: list[str] = []
    for d in domains:
        d = d.strip().lower().rstrip(".")
        if d and d not in seen:
            seen.add(d)
            uniq.append(d)
    domains = uniq
    print(f"  دامنه‌ها: {len(domains)} | workers={args.workers} | timeout={args.timeout}s")

    async def handle(domain: str) -> ProbeResult:
        return await probe_sni_domain(domain, port=args.port, timeout=args.timeout)

    prog = Progress(len(domains))
    results: list[ProbeResult] = await run_pool(domains, args.workers, handle, prog)
    ok_rows = [r for r in results if r.ok]
    ok_rows.sort(key=lambda r: (r.extra.get("score", 0) * -1, r.tls_ms or 9e9))

    out_path = Path(args.out) if args.out else Path(f"/tmp/jojonet-sni-{int(time.time())}.json")
    payload = {
        "scanner": "JojoSNI",
        "version": VERSION,
        "vantage": vantage,
        "count": len(results),
        "ok": len(ok_rows),
        "results": [result_dict(r, vantage) for r in sorted(results, key=lambda x: -(x.extra.get("score") or 0))],
    }
    out_path.write_text(json.dumps(payload, ensure_ascii=False, indent=2), encoding="utf-8")

    print()
    print(f"  سالم: {len(ok_rows)}/{len(results)}")
    print(f"  خروجی: {out_path}")
    print()
    print(f"  {'SNI':<34} {'ms':>7} {'TLS':<8} {'ALPN':<8} {'امتیاز':>6}  وضعیت")
    print("  " + "-" * 78)
    for r in ok_rows[: args.top]:
        print(
            f"  {r.target:<34} {r.tls_ms or 0:7.1f} {'1.3' if r.tls13 else 'other':<8} "
            f"{(r.alpn or '-'):<8} {r.extra.get('score', 0):6d}  {r.extra.get('reality_hint', '')}"
        )
    if not ok_rows:
        print("  هیچ SNI سالمی پیدا نشد.")
        return 0

    if getattr(args, "iran_isp", False):
        isp_top = int(getattr(args, "isp_top", 5) or 5)
        targets = [r.target for r in ok_rows[:isp_top]]
        try:
            isp_rows = enrich_iran_isp(targets, port=args.port, top=isp_top)
            print_iran_isp_table(isp_rows)
            payload["iran_isp"] = isp_rows
            out_path.write_text(json.dumps(payload, ensure_ascii=False, indent=2), encoding="utf-8")
        except Exception as exc:  # noqa: BLE001
            print(f"  [!] سنجش اپراتور ایران ناموفق: {exc}", file=sys.stderr)
    return 0


async def cmd_cdn(args: argparse.Namespace, *, provider: str) -> int:
    title = "JojoCF" if provider == "cf" else "JojoFastly"
    vantage = detect_vantage()
    print(f"{title} — اسکنر IP تمیز {('Cloudflare' if provider == 'cf' else 'Fastly')} | JojoNet-scan {VERSION}")
    print(f"  از شبکه: {vantage.get('isp')}  AS{vantage.get('asn') or '?'}  IP={vantage.get('public_ip') or '?'}")
    print(f"  نکته: {vantage.get('note')}")

    print("  دریافت رنج رسمی…", flush=True)
    if provider == "cf":
        nets = fetch_cloudflare_cidrs(ipv6=args.ipv6)
        default_sni = args.sni or "www.cloudflare.com"
    else:
        nets = fetch_fastly_cidrs(ipv6=args.ipv6)
        default_sni = args.sni or "www.fastly.com"

    total_est = count_hosts(nets, limit=args.limit)
    print(f"  رنج‌ها: {len(nets)} | تخمین IP: {total_est:,} | SNI={default_sni} | workers={args.workers}")

    out_path = Path(args.out) if args.out else Path(f"/tmp/jojonet-{provider}-{int(time.time())}.jsonl")
    done = load_resume(out_path) if args.resume else set()
    if done:
        print(f"  ادامه از فایل قبلی: {len(done):,} مورد رد شد")

    # Stream hosts in chunks to avoid holding millions of strings at once
    chunk_size = max(args.workers * 4, 500)
    scanned = 0
    ok_n = 0
    best: list[dict[str, Any]] = []
    t0 = time.perf_counter()

    async def handle(ip: str) -> ProbeResult:
        r = await probe_tls(ip, port=args.port, sni=default_sni, timeout=args.timeout, verify=False)
        r.kind = provider
        r.target = ip
        r.ip = ip
        return r

    host_iter = iter_hosts(nets, limit=args.limit)
    prog_done = 0
    while True:
        chunk: list[str] = []
        while len(chunk) < chunk_size:
            try:
                ip = next(host_iter)
            except StopIteration:
                break
            if ip in done:
                continue
            chunk.append(ip)
        if not chunk:
            break

        results = await run_pool(chunk, args.workers, handle, progress=None)
        rows = []
        for r in results:
            prog_done += 1
            scanned += 1
            d = result_dict(r, vantage)
            rows.append(d)
            if r.ok:
                ok_n += 1
                best.append(d)
        append_jsonl(out_path, rows)

        # keep top by tls_ms
        best = [b for b in best if b.get("ok")]
        best.sort(key=lambda x: x.get("tls_ms") or 9e9)
        best = best[: max(args.top * 3, 50)]

        elapsed = max(time.perf_counter() - t0, 0.001)
        rate = scanned / elapsed
        eta = (total_est - scanned) / rate if rate > 0 and args.limit is None else 0
        # when limit set, total_est already capped
        remain = max(total_est - scanned, 0)
        eta = remain / rate if rate > 0 else 0
        print(
            f"\r  [{100.0 * scanned / max(total_est, 1):5.1f}%] scanned={scanned:,}/{total_est:,}  "
            f"ok={ok_n:,}  {rate:.0f}/s  ETA {eta/60:.1f}m  out={out_path.name}   ",
            end="",
            file=sys.stderr,
            flush=True,
        )

    print(file=sys.stderr)
    summary = {
        "scanner": title,
        "provider": provider,
        "version": VERSION,
        "vantage": vantage,
        "sni": default_sni,
        "port": args.port,
        "cidrs": [str(n) for n in nets],
        "scanned": scanned,
        "ok": ok_n,
        "jsonl": str(out_path),
        "finished_at": _utc(),
        "top": best[: args.top],
    }
    summary_path = out_path.with_suffix(".summary.json")
    summary_path.write_text(json.dumps(summary, ensure_ascii=False, indent=2), encoding="utf-8")

    print()
    print(f"  تمام شد. اسکن‌شده: {scanned:,} | سالم: {ok_n:,}")
    print(f"  جزئیات JSONL: {out_path}")
    print(f"  خلاصه: {summary_path}")
    print()
    print(f"  پینگ/تأخیر TLS از دیدگاه: {vantage.get('isp')} (AS{vantage.get('asn') or '?'})")
    print(f"  {'IP':<42} {'ms':>8}  TLS  ALPN")
    print("  " + "-" * 70)
    for b in best[: args.top]:
        print(
            f"  {b.get('ip',''):<42} {b.get('tls_ms') or 0:8.1f}  "
            f"{'1.3' if b.get('tls13') else '-':<4} {b.get('alpn') or '-'}"
        )
    if not best:
        print("  هیچ IP سالمی پیدا نشد (فایروال/مسیر یا SNI را چک کنید).")
        return 0

    if getattr(args, "iran_isp", False):
        isp_top = int(getattr(args, "isp_top", 5) or 5)
        targets = [str(b.get("ip") or b.get("target")) for b in best[:isp_top]]
        try:
            isp_rows = enrich_iran_isp(targets, port=args.port, top=isp_top)
            print_iran_isp_table(isp_rows)
            summary["iran_isp"] = isp_rows
            summary_path.write_text(json.dumps(summary, ensure_ascii=False, indent=2), encoding="utf-8")
        except Exception as exc:  # noqa: BLE001
            print(f"  [!] سنجش اپراتور ایران ناموفق: {exc}", file=sys.stderr)
    return 0


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog=TOOL,
        description="JojoNet Reality scanners: JojoSNI / JojoCF / JojoFastly",
    )
    p.add_argument("--version", action="version", version=f"{TOOL} {VERSION}")
    sub = p.add_subparsers(dest="cmd", required=True)

    def add_common(sp: argparse.ArgumentParser) -> None:
        sp.add_argument("--workers", type=int, default=200, help="concurrent probes (default 200)")
        sp.add_argument("--timeout", type=float, default=2.5, help="per-target seconds")
        sp.add_argument("--port", type=int, default=443)
        sp.add_argument("--top", type=int, default=20, help="print top N results")
        sp.add_argument("--out", type=str, default="", help="output path")
        sp.add_argument("--iran-isp", action="store_true", help="probe top results from Iran city nodes")
        sp.add_argument("--isp-top", type=int, default=5, help="how many top targets to probe from Iran")

    sni = sub.add_parser("sni", help="JojoSNI — اسکن دامنه/SNI مناسب Reality")
    add_common(sni)
    sni.add_argument("--file", type=str, default="", help="extra domains file (one per line)")
    sni.set_defaults(func=lambda a: asyncio.run(cmd_sni(a)))

    cf = sub.add_parser("cf", help="JojoCF — اسکن تمام رنج رسمی Cloudflare")
    add_common(cf)
    cf.add_argument("--sni", type=str, default="", help="SNI used against CF IPs")
    cf.add_argument("--limit", type=int, default=None, help="scan only first N IPs (test)")
    cf.add_argument("--resume", action="store_true", help="skip IPs already in --out jsonl")
    cf.add_argument("--ipv6", action="store_true", help="include IPv6 ranges")
    cf.set_defaults(func=lambda a: asyncio.run(cmd_cdn(a, provider="cf")))

    fy = sub.add_parser("fastly", help="JojoFastly — اسکن تمام رنج رسمی Fastly")
    add_common(fy)
    fy.add_argument("--sni", type=str, default="", help="SNI used against Fastly IPs")
    fy.add_argument("--limit", type=int, default=None, help="scan only first N IPs (test)")
    fy.add_argument("--resume", action="store_true")
    fy.add_argument("--ipv6", action="store_true")
    fy.set_defaults(func=lambda a: asyncio.run(cmd_cdn(a, provider="fastly")))

    isp = sub.add_parser("isp", help="تشخیص اپراتور همین سرور + نودهای ایران")
    isp.set_defaults(func=lambda a: asyncio.run(cmd_isp(a)))

    return p


def main(argv: list[str] | None = None) -> int:
    if sys.version_info < (3, 9):
        print("Python 3.9+ required", file=sys.stderr)
        return 2
    parser = build_parser()
    args = parser.parse_args(argv)
    workers = getattr(args, "workers", None)
    if workers is not None:
        if workers < 1:
            args.workers = 1
        if workers > 2000:
            args.workers = 2000
    try:
        return int(args.func(args) or 0)
    except KeyboardInterrupt:
        print("\nلغو شد.", file=sys.stderr)
        return 130
    except Exception as exc:  # noqa: BLE001
        print(f"خطا: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
