def _utc() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def _http_get(url: str, timeout: float = 30.0) -> str:
    req = urllib.request.Request(
        url,
        headers={"User-Agent": f"JojoNet-Scan/{VERSION}", "Accept": "application/json,text/plain,*/*"},
    )
    with urllib.request.urlopen(req, timeout=timeout) as resp:  # noqa: S310 — fixed CDN endpoints
        return resp.read().decode("utf-8", "replace")


def detect_vantage() -> dict[str, Any]:
    """Detect public IP / ASN of THIS host (the network we measure FROM)."""
    out: dict[str, Any] = {
        "public_ip": "",
        "asn": None,
        "isp": "نامشخص",
        "org": "",
        "country": "",
        "note": "پینگ/تأخیر از همین سرور اندازه‌گیری می‌شود؛ برای همراه‌اول/ایرانسل/... اسکنر را روی همان شبکه اجرا کنید.",
    }
    # Prefer ipapi.co then bgpview fallbacks
    for url in (
        "https://ipapi.co/json/",
        "https://ifconfig.co/json",
    ):
        try:
            data = json.loads(_http_get(url, timeout=12))
        except (urllib.error.URLError, TimeoutError, json.JSONDecodeError, OSError):
            continue
        ip = str(data.get("ip") or data.get("ip_addr") or "").strip()
        asn_raw = data.get("asn") or data.get("org") or ""
        org = str(data.get("org") or data.get("asn_org") or data.get("asn_name") or "")
        country = str(data.get("country") or data.get("country_code") or "")
        asn = None
        if isinstance(asn_raw, int):
            asn = asn_raw
        else:
            m = re.search(r"AS?(\d+)", str(asn_raw), re.I)
            if m:
                asn = int(m.group(1))
            else:
                m = re.search(r"AS?(\d+)", org, re.I)
                if m:
                    asn = int(m.group(1))
        if ip:
            out["public_ip"] = ip
        if asn:
            out["asn"] = asn
            out["isp"] = IRAN_ASN.get(asn, org or f"AS{asn}")
        elif org:
            out["isp"] = org
        out["org"] = org
        out["country"] = country
        if out["public_ip"]:
            break
    if out["public_ip"] and not out["asn"]:
        try:
            data = json.loads(_http_get(f"https://api.bgpview.io/ip/{out['public_ip']}", timeout=12))
            prefixes = (((data.get("data") or {}).get("prefixes")) or [])
            if prefixes:
                asn_meta = (prefixes[0].get("asn") or {})
                asn = asn_meta.get("asn")
                if asn is not None:
                    out["asn"] = int(asn)
                    out["org"] = str(asn_meta.get("name") or asn_meta.get("description") or out["org"])
        except (urllib.error.URLError, TimeoutError, json.JSONDecodeError, OSError, TypeError, ValueError):
            pass
    if out["asn"] and out["asn"] in IRAN_ASN:
        out["isp"] = IRAN_ASN[out["asn"]]
    elif out["asn"] and not out["isp"].startswith("AS") and out["isp"] == "نامشخص":
        out["isp"] = out["org"] or f"AS{out['asn']}"
    return out


def parse_cidrs(text: str) -> list[ipaddress._BaseNetwork]:
    nets: list[ipaddress._BaseNetwork] = []
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        # Fastly JSON uses addresses arrays
        if line.startswith("{") or line.startswith("["):
            continue
        try:
            nets.append(ipaddress.ip_network(line, strict=False))
        except ValueError:
            continue
    return nets


def fetch_cloudflare_cidrs(*, ipv6: bool = False) -> list[ipaddress._BaseNetwork]:
    text = _http_get(CF_IPV4_URL)
    nets = parse_cidrs(text)
    if ipv6:
        try:
            nets.extend(parse_cidrs(_http_get(CF_IPV6_URL)))
        except (urllib.error.URLError, TimeoutError, OSError):
            pass
    if not nets:
        raise RuntimeError("لیست رنج Cloudflare خالی بود")
    return nets


def fetch_fastly_cidrs(*, ipv6: bool = False) -> list[ipaddress._BaseNetwork]:
    nets: list[ipaddress._BaseNetwork] = []
    raw: dict[str, Any] | None = None
    last_err: Exception | None = None
    for attempt in range(3):
        try:
            raw = json.loads(_http_get(FASTLY_URL, timeout=45.0))
            break
        except (urllib.error.URLError, TimeoutError, OSError, json.JSONDecodeError) as exc:
            last_err = exc
            time.sleep(1.5 * (attempt + 1))
    if raw is None:
        print(f"  [!] Fastly API ناموفق ({last_err}) — استفاده از فهرست پشتیبان رسمی.", flush=True)
        for cidr in FASTLY_FALLBACK_V4:
            try:
                nets.append(ipaddress.ip_network(cidr, strict=False))
            except ValueError:
                continue
        if not nets:
            raise RuntimeError(f"لیست رنج Fastly خالی بود: {last_err}")
        return nets
    keys = ["addresses"]
    if ipv6:
        keys.append("ipv6_addresses")
    for key in keys:
        for item in raw.get(key) or []:
            try:
                nets.append(ipaddress.ip_network(str(item), strict=False))
            except ValueError:
                continue
    uniq: dict[str, ipaddress._BaseNetwork] = {str(n): n for n in nets}
    nets = list(uniq.values())
    if not nets:
        raise RuntimeError("لیست رنج Fastly خالی بود")
    return nets


def iter_hosts(nets: Iterable[ipaddress._BaseNetwork], *, limit: int | None) -> Iterable[str]:
    """Round-robin across CIDRs so --limit samples the whole space, not only the first prefix."""
    iterators: list[Any] = []
    for net in nets:
        try:
            iterators.append(iter(net.hosts()))
        except ValueError:
            iterators.append(iter([net.network_address]))
    n = 0
    while iterators:
        next_iters: list[Any] = []
        for it in iterators:
            try:
                yield str(next(it))
                n += 1
                next_iters.append(it)
                if limit is not None and n >= limit:
                    return
            except StopIteration:
                continue
        iterators = next_iters


def count_hosts(nets: list[ipaddress._BaseNetwork], *, limit: int | None) -> int:
    total = 0
    for net in nets:
        try:
            total += net.num_addresses
            # subtract network+broadcast for IPv4 > /31
            if net.version == 4 and net.prefixlen < 31:
                total -= 2
        except Exception:
            total += 1
    if limit is not None:
        return min(total, limit)
    return max(total, 0)


async def tcp_connect_rtt(host: str, port: int, timeout: float) -> tuple[float | None, Any]:
    loop = asyncio.get_running_loop()
    t0 = time.perf_counter()
    try:
        fut = asyncio.open_connection(host, port)
        reader, writer = await asyncio.wait_for(fut, timeout=timeout)
        rtt = (time.perf_counter() - t0) * 1000.0
        return rtt, (reader, writer)
    except Exception:
        return None, None


async def probe_tls(
    host: str,
    *,
    port: int,
    sni: str,
    timeout: float,
    verify: bool = False,
) -> ProbeResult:
    """TCP + TLS probe. host may be IP or hostname."""
    res = ProbeResult(target=host, kind="tls", ok=False, sni=sni, port=port, ip=host)
    t0 = time.perf_counter()
    writer = None
    try:
        # Resolve if hostname
        if not _is_ip(host):
            loop = asyncio.get_running_loop()
            # Prefer IPv4 — IPv6 on many Iran networks is broken / blackholed.
            infos = await loop.getaddrinfo(
                host, port, family=socket.AF_INET, type=socket.SOCK_STREAM, proto=socket.IPPROTO_TCP
            )
            if not infos:
                infos = await loop.getaddrinfo(
                    host, port, type=socket.SOCK_STREAM, proto=socket.IPPROTO_TCP
                )
            if not infos:
                res.error = "resolve-failed"
                return res
            res.ip = infos[0][4][0]

        ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT)
        ctx.minimum_version = ssl.TLSVersion.TLSv1_2
        ctx.set_alpn_protocols(["h2", "http/1.1"])
        if verify:
            ctx.check_hostname = True
            ctx.verify_mode = ssl.CERT_REQUIRED
            ctx.load_default_certs()
        else:
            ctx.check_hostname = False
            ctx.verify_mode = ssl.CERT_NONE

        server_hostname = sni or (None if _is_ip(host) else host)

        conn = asyncio.open_connection(res.ip or host, port, ssl=ctx, server_hostname=server_hostname)
        reader, writer = await asyncio.wait_for(conn, timeout=timeout)
        tls_ms = (time.perf_counter() - t0) * 1000.0
        res.tls_ms = round(tls_ms, 2)
        res.rtt_ms = res.tls_ms  # end-to-end until handshake done
        sslobj = writer.get_extra_info("ssl_object")
        if sslobj is not None:
            ver = sslobj.version() or ""
            res.tls13 = ver == "TLSv1.3"
            try:
                res.alpn = sslobj.selected_alpn_protocol() or ""
            except Exception:
                res.alpn = ""
            try:
                cert = sslobj.getpeercert()
                if cert:
                    res.cert_ok = True
                    sub = dict(x[0] for x in cert.get("subject", ()) if x)
                    res.cert_cn = sub.get("commonName", "")
            except Exception:
                # CERT_NONE often yields empty dict — still mark handshake OK
                res.cert_ok = True
        res.ok = True
        return res
    except asyncio.TimeoutError:
        res.error = "timeout"
        return res
    except ssl.SSLError as exc:
        res.error = f"tls:{exc}"
        return res
    except OSError as exc:
        res.error = f"net:{exc.errno or exc}"
        return res
    except Exception as exc:  # noqa: BLE001
        res.error = type(exc).__name__
        return res
    finally:
        if writer is not None:
            try:
                writer.close()
                await writer.wait_closed()
            except Exception:
                pass


def _is_ip(value: str) -> bool:
    try:
        ipaddress.ip_address(value)
        return True
    except ValueError:
        return False


async def probe_sni_domain(domain: str, *, port: int, timeout: float) -> ProbeResult:
    res = await probe_tls(domain, port=port, sni=domain, timeout=timeout, verify=False)
    res.kind = "sni"
    res.target = domain
    # Reality-friendly score hints
    score = 0
    if res.ok:
        score += 40
    if res.tls13:
        score += 25
    if res.alpn == "h2":
        score += 20
    if res.tls_ms is not None:
        if res.tls_ms < 80:
            score += 15
        elif res.tls_ms < 150:
            score += 10
        elif res.tls_ms < 250:
            score += 5
    res.extra["score"] = score
    res.extra["reality_hint"] = (
        "مناسب Reality" if score >= 70 else ("قابل‌قبول" if score >= 45 else "ضعیف")
    )
    return res


class Progress:
    def __init__(self, total: int):
        self.total = max(total, 1)
        self.done = 0
        self.ok = 0
        self.t0 = time.perf_counter()
        self._lock = asyncio.Lock()

    async def tick(self, success: bool) -> None:
        async with self._lock:
            self.done += 1
            if success:
                self.ok += 1
            if self.done == 1 or self.done == self.total or self.done % 50 == 0:
                self._print()

    def _print(self) -> None:
        elapsed = max(time.perf_counter() - self.t0, 0.001)
        rate = self.done / elapsed
        left = self.total - self.done
        eta = left / rate if rate > 0 else 0
        pct = 100.0 * self.done / self.total
        print(
            f"\r  [{pct:5.1f}%] {self.done}/{self.total}  ok={self.ok}  "
            f"{rate:.0f}/s  ETA {eta/60:.1f}m   ",
            end="",
            file=sys.stderr,
            flush=True,
        )


async def run_pool(
    items: list[Any],
    workers: int,
    handler,
    progress: Progress | None = None,
) -> list[Any]:
    q: asyncio.Queue = asyncio.Queue()
    for it in items:
        q.put_nowait(it)
    results: list[Any] = []
    lock = asyncio.Lock()

    async def worker() -> None:
        while True:
            try:
                item = q.get_nowait()
            except asyncio.QueueEmpty:
                return
            try:
                r = await handler(item)
                async with lock:
                    results.append(r)
                if progress is not None:
                    await progress.tick(bool(getattr(r, "ok", False)))
            finally:
                q.task_done()

    ws = [asyncio.create_task(worker()) for _ in range(max(1, workers))]
    await asyncio.gather(*ws)
    if progress is not None:
        print(file=sys.stderr)
    return results


def load_resume(path: Path) -> set[str]:
    done: set[str] = set()
    if not path.is_file():
        return done
    with path.open("r", encoding="utf-8") as fh:
        for line in fh:
            line = line.strip()
            if not line:
                continue
            try:
                row = json.loads(line)
            except json.JSONDecodeError:
                continue
            key = str(row.get("ip") or row.get("target") or "")
            if key:
                done.add(key)
    return done


def append_jsonl(path: Path, rows: Iterable[dict[str, Any]]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a", encoding="utf-8") as fh:
        for row in rows:
            fh.write(json.dumps(row, ensure_ascii=False) + "\n")


def result_dict(r: ProbeResult, vantage: dict[str, Any]) -> dict[str, Any]:
    d = asdict(r)
    d["isp_from"] = vantage.get("isp") or r.isp_from
    d["asn_from"] = vantage.get("asn")
    d["vantage_ip"] = vantage.get("public_ip")
    d["scanned_at"] = _utc()
    return d


def _http_get_json(url: str, timeout: float = 30.0) -> Any:
    req = urllib.request.Request(
        url,
        headers={
            "User-Agent": f"JojoNet-Scan/{VERSION}",
            "Accept": "application/json",
        },
    )
    with urllib.request.urlopen(req, timeout=timeout) as resp:  # noqa: S310
        return json.loads(resp.read().decode("utf-8", "replace"))


def fetch_iran_probe_nodes() -> list[dict[str, Any]]:
    """Iran check-host nodes with ASN → Persian ISP label when known."""
    data = _http_get_json(f"{CHECK_HOST}/nodes/hosts")
    nodes = data.get("nodes") or data
    out: list[dict[str, Any]] = []
    for name, meta in nodes.items():
        if not isinstance(meta, dict):
            continue
        loc = meta.get("location") or []
        if not loc or loc[0] != "ir":
            continue
        asn_raw = str(meta.get("asn") or "")
        m = re.search(r"(\d+)", asn_raw)
        asn = int(m.group(1)) if m else None
        city = loc[2] if len(loc) > 2 else (loc[1] if len(loc) > 1 else "Iran")
        label = IRAN_ASN.get(asn or -1) or f"ایران/{city}"
        out.append(
            {
                "node": name,
                "asn": asn,
                "ip": meta.get("ip") or "",
                "city": city,
                "label": label,
            }
        )
    out.sort(key=lambda x: x["node"])
    return out


def check_host_tcp(host: str, port: int, nodes: list[dict[str, Any]], *, wait_s: float = 45.0) -> dict[str, Any]:
    """TCP :port check from selected Iran nodes. Returns {label: ms|None, ...}."""
    if not nodes:
        return {}
    q = [f"host={host}:{port}"]
    for n in nodes:
        q.append(f"node={n['node']}")
    url = f"{CHECK_HOST}/check-tcp?" + "&".join(q)
    try:
        started = _http_get_json(url, timeout=25)
    except (urllib.error.URLError, TimeoutError, json.JSONDecodeError, OSError) as exc:
        return {"_error": str(exc)}
    if isinstance(started, dict) and started.get("error"):
        return {"_error": str(started.get("error")), "raw": started}
    req_id = started.get("request_id") if isinstance(started, dict) else None
    if not req_id:
        return {"_error": "no-request-id", "raw": started}
    deadline = time.time() + wait_s
    payload: dict[str, Any] = {}
    best_done = 0
    while time.time() < deadline:
        time.sleep(2.0)
        try:
            payload = _http_get_json(f"{CHECK_HOST}/check-result/{req_id}", timeout=25)
        except (urllib.error.URLError, TimeoutError, json.JSONDecodeError, OSError):
            continue
        if not isinstance(payload, dict) or not payload:
            continue
        done = sum(1 for v in payload.values() if v is not None)
        if done > best_done:
            best_done = done
        # Finish early when every node answered, or majority answered and stalled
        if done >= len(payload):
            break
        if done >= max(1, (len(payload) + 1) // 2) and time.time() + 8.0 >= deadline:
            break
    by_label: dict[str, Any] = {}
    node_map = {n["node"]: n for n in nodes}
    for node_name, rows in (payload or {}).items():
        meta = node_map.get(node_name) or {"label": node_name, "city": "?"}
        label = str(meta.get("label") or node_name)
        key = label
        if key in by_label:
            key = f"{label}/{meta.get('city')}"
        ms = None
        err = None
        if isinstance(rows, list) and rows:
            row0 = rows[0] or {}
            if isinstance(row0, dict):
                if "time" in row0:
                    try:
                        ms = round(float(row0["time"]) * 1000.0, 1)
                    except (TypeError, ValueError):
                        ms = None
                err = row0.get("error")
        elif rows is None:
            err = "timeout"
        by_label[key] = {"ms": ms, "error": err, "node": node_name, "city": meta.get("city"), "asn": meta.get("asn")}
    return by_label


def _pick_iran_nodes(nodes: list[dict[str, Any]], *, limit: int = 4) -> list[dict[str, Any]]:
    """Prefer diverse Iranian cities; keep list small to avoid check-host rate limits."""
    if len(nodes) <= limit:
        return nodes
    prefer_cities = ("Tehran", "Shiraz", "Isfahan", "Qom", "Tabriz", "Mashhad")
    picked: list[dict[str, Any]] = []
    seen_city: set[str] = set()
    for city in prefer_cities:
        for n in nodes:
            if n.get("city") == city and city not in seen_city:
                picked.append(n)
                seen_city.add(city)
                break
        if len(picked) >= limit:
            return picked[:limit]
    for n in nodes:
        if n in picked:
            continue
        picked.append(n)
        if len(picked) >= limit:
            break
    return picked[:limit]


def enrich_iran_isp(targets: list[str], *, port: int, top: int) -> list[dict[str, Any]]:
    """For each target, measure TCP latency from Iran probe nodes (multi-city)."""
    try:
        all_nodes = fetch_iran_probe_nodes()
    except Exception as exc:  # noqa: BLE001
        print(f"  [!] خواندن نودهای ایران ناموفق: {exc}", file=sys.stderr)
        return []
    nodes = _pick_iran_nodes(all_nodes, limit=4)
    if not nodes:
        print("  [!] نود ایران برای سنجش در دسترس نبود.", file=sys.stderr)
        return []
    n_targets = min(top, len(targets))
    print(f"  سنجش از داخل ایران روی {n_targets} هدف / {len(nodes)} نود شهری…", flush=True)
    for n in nodes:
        print(f"    · {n['label']} — {n['city']} (AS{n['asn'] or '?'}, {n['node']})")
    rows: list[dict[str, Any]] = []
    for i, target in enumerate(targets[:top], 1):
        print(f"  [{i}/{n_targets}] {target} …", flush=True)
        isp = check_host_tcp(target, port, nodes)
        if isp.get("_error"):
            err = str(isp.get("_error"))
            print(f"     [!] {err}")
            if "limit" in err.lower() or (isinstance(isp.get("raw"), dict) and isp["raw"].get("error") == "limit_exceeded"):
                print("     محدودیت rate check-host — ادامه با نتایج قبلی.")
                break
            # also detect limit in raw start response stored oddly
        if isinstance(isp, dict) and not any(not k.startswith("_") for k in isp):
            # empty / failed start
            raw = isp.get("raw") if isinstance(isp.get("raw"), dict) else {}
            if raw.get("error") == "limit_exceeded" or "limit" in str(isp.get("_error", "")).lower():
                print("     محدودیت rate check-host — ادامه با نتایج قبلی.")
                break
        rows.append({"target": target, "iran_isp": {k: v for k, v in isp.items() if not str(k).startswith("_")}})
        bits = []
        for lab, info in (rows[-1]["iran_isp"] or {}).items():
            if info.get("ms") is not None:
                bits.append(f"{lab}={info['ms']}ms")
            else:
                bits.append(f"{lab}=قطع")
        print("     " + (" | ".join(bits[:8]) if bits else "بدون پاسخ"))
        if i < n_targets:
            time.sleep(2.5)  # breathe for check-host free tier
    # If every cell is empty, check-host nodes likely stalled — keep JSON but warn clearly.
    any_ms = False
    for r in rows:
        for info in (r.get("iran_isp") or {}).values():
            if isinstance(info, dict) and info.get("ms") is not None:
                any_ms = True
                break
    if rows and not any_ms:
        print(
            "  [!] نودهای check-host الان نتیجه TCP برنگرداندند "
            "(سرویس/نود موقتاً از دسترس خارج است).",
            flush=True,
        )
        print(
            "  ✓ معیار اصلی همان تأخیر TLS از شبکهٔ فعلی سرور است "
            "(برای همراه‌اول/ایرانسل روی همان اینترنت اجرا کنید).",
            flush=True,
        )
    return rows


def print_iran_isp_table(rows: list[dict[str, Any]]) -> None:
    if not rows:
        return
    # collect columns
    labels: list[str] = []
    for r in rows:
        for lab in (r.get("iran_isp") or {}):
            if lab.startswith("_"):
                continue
            if lab not in labels:
                labels.append(lab)
    def sort_key(lab: str) -> tuple:
        for i, key in enumerate(_PRIORITY_ISP):
            if key in lab:
                return (i, lab)
        return (len(_PRIORITY_ISP), lab)

    labels.sort(key=sort_key)
    print()
    print("  تأخیر از نودهای داخل ایران (TCP:443) — شهرها/مسیرها:")
    print("  (برای پینگ دقیق همراه‌اول/ایرانسل، اسکن را روی همان اینترنت موبایل هم اجرا کنید)")
    hdr = f"  {'هدف':<28}" + "".join(f" {lab[:14]:>14}" for lab in labels[:8])
    print(hdr)
    print("  " + "-" * min(len(hdr), 120))
    for r in rows:
        isp = r.get("iran_isp") or {}
        line = f"  {str(r.get('target') or ''):<28}"
        for lab in labels[:8]:
            info = isp.get(lab) or {}
            ms = info.get("ms")
            cell = f"{ms:.0f}" if isinstance(ms, (int, float)) else "—"
            line += f" {cell:>14}"
        print(line)


